+	}
+	if session.Capabilities.Seekable {
+		t.Fatal("a progressive source must not claim encoded-stream seek support")
+	}
+	if session.Streams.Audio != "/api/v1/playback/"+session.ID+"/audio" {
+		t.Fatalf("audio route = %q", session.Streams.Audio)
+	}
+	serialized, _ := json.Marshal(session)
+	if bytes.Contains(serialized, []byte("asset-secret")) || bytes.Contains(serialized, []byte("blobstore.apple.com")) {
+		t.Fatal("session JSON leaked the signed asset URL")
+	}
+
+	var request map[string]any
+	if err := json.Unmarshal(fixture.playbackRequest, &request); err != nil {
+		t.Fatal(err)
+	}
+	if request["universalLibraryId"] != "i.test" || request["isLibrary"] != true || len(request) != 2 {
+		t.Fatalf("webPlayback request = %#v", request)
+	}
+	if got := fixture.playbackHeaders.Get("Authorization"); got != "Bearer developer-token" {
+		t.Fatalf("Authorization header = %q", got)
+	}
+	if got := fixture.playbackHeaders.Get("x-apple-music-user-token"); got != "music-token" {
+		t.Fatalf("user token header = %q", got)
+	}
+	for _, headers := range fixture.assetHeaders {
+		if headers.Get("Authorization") != "" || headers.Get("x-apple-music-user-token") != "" {
+			t.Fatal("Apple credentials leaked to the CDN request")
+		}
+	}
+
+	var out bytes.Buffer
+	if err := manager.Stream(context.Background(), session.ID, pipeline.KindAudio, &out); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(out.Bytes(), fixture.assetBody) {
+		t.Fatalf("streamed %d bytes, want %d", out.Len(), len(fixture.assetBody))
+	}
