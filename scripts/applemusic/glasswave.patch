+	provider := newUploadedTestProvider(f)
+	if _, err := provider.Open(context.Background(), media.OpenRequest{AssetID: "i.test", Token: "dev", MUT: "mut"}); err == nil || !strings.Contains(err.Error(), "duration") {
+		t.Fatal("Normalized three-second source bypassed the full-song duration guard")
