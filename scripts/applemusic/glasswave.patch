+	}
+
+	ordinary := httptest.NewRequest(http.MethodGet, "/audio", nil)
+	ordinary.SetPathValue("id", sess.ID)
+	ordinaryRec := httptest.NewRecorder()
+	s.handlePlaybackAudio(ordinaryRec, ordinary)
+	if ordinaryRec.Code != http.StatusOK {
+		t.Fatalf("ordinary status = %d: %s", ordinaryRec.Code, ordinaryRec.Body.String())
+	}
+	if !bytes.Equal(ordinaryRec.Body.Bytes(), fMP4) {
+		t.Fatalf("ordinary route changed the fMP4 stream")
