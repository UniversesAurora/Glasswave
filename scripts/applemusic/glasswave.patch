+package apple
+
+import (
+	"context"
+	"os"
+	"strings"
+	"testing"
+
+	"engine/utils/ampapi"
+)
+
+// TestUploadedWebPlaybackLiveProbe is an opt-in, read-only source probe for
+// iCloud library uploads. It logs only public format facts and never signed
+// asset URLs or credentials.
+func TestUploadedWebPlaybackLiveProbe(t *testing.T) {
+	if os.Getenv("ADAM_LIVE_UPLOAD_PROBE") != "1" {
+		t.Skip("set ADAM_LIVE_UPLOAD_PROBE=1, ADAM_LIVE_UPLOAD_IDS, and ADAM_LIVE_MUT to probe Apple")
+	}
+	mut := strings.TrimSpace(os.Getenv("ADAM_LIVE_MUT"))
+	if mut == "" {
+		t.Fatal("ADAM_LIVE_MUT is required")
+	}
+	ids := strings.FieldsFunc(os.Getenv("ADAM_LIVE_UPLOAD_IDS"), func(r rune) bool {
+		return r == ',' || r == ';' || r == ' ' || r == '\n' || r == '\t'
+	})
+	if len(ids) == 0 {
+		t.Fatal("ADAM_LIVE_UPLOAD_IDS is required")
+	}
+	devToken, err := ampapi.GetToken()
+	if err != nil {
+		t.Fatalf("get developer token: %v", err)
+	}
+	adapter := newUploadedAudioAdapter()
+	for _, id := range ids {
+		id = strings.TrimSpace(id)
+		if !strings.HasPrefix(id, "i.") {
+			t.Fatalf("probe id is not a library id: %q", id)
+		}
+		asset, err := adapter.fetchUploadedAsset(context.Background(), id, devToken, mut)
+		if err != nil {
+			t.Fatalf("%s: %v", id, err)
+		}
+		info, err := adapter.probeUploadedAudio(context.Background(), &asset)
+		if err != nil {
+			t.Fatalf("%s: %v", id, err)
+		}
+		t.Logf("%s: codec=%s container=%s ext=%s rate=%d depth=%d bitrate=%d channels=%d durationMs=%d",
+			id, info.Codec, info.Container, info.Extension, info.SampleRate,
+			info.BitDepth, info.BitRate, info.ChannelCount, info.DurationMs)
+	}
+}
diff --git a/engine/core/apple/uploaded_mp4.go b/engine/core/apple/uploaded_mp4.go
new file mode 100644
index 0000000..d9e47d0
--- /dev/null
+++ b/engine/core/apple/uploaded_mp4.go
@@ -0,0 +1,668 @@
+package apple
+
+// Uploaded MP4 normalization moves only the index. Compressed media is copied
+// directly from validated HTTP ranges; neither samples nor timestamps are decoded.
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/itouakirai/mp4ff/mp4"
+)
+
+const (
+	uploadedMP4HeadLimit  = 8 << 10
+	uploadedMP4IndexLimit = 8 << 20
+	uploadedMP4SizeLimit  = int64(8 << 30)
+	uploadedMP4BoxLimit   = 64
+	uploadedMP4Layout     = "uploaded-mp4-faststart-v1"
+)
+
+type uploadedMP4Box struct {
+	typ                  string
+	offset, size, header int64
+}
+
+type uploadedMP4HTTP struct {
+	client         *http.Client
+	url            string
+	total          int64
+	etag, modified string
+}
+
+type uploadedMP4Plan struct {
+	remote                         uploadedMP4HTTP
+	moov                           *mp4.MoovBox
+	prefix                         []byte
+	ftypSize, moovOffset, moovSize int64
+	outputLength                   int64
+	rewritten, sequentialIndex     bool
+}
+
+func uploadedMP4HTTPError(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return fmt.Errorf("uploaded MP4 transport failed")
+}
+
+func (s *uploadedMP4HTTP) request(ctx context.Context, start, end int64, ranged bool) (*http.Response, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, s.url, nil)
+	if err != nil {
+		return nil, fmt.Errorf("uploaded MP4 request is invalid")
+	}
+	req.Header.Set("Accept-Encoding", "identity")
+	if ranged {
+		req.Header.Set("Range", fmt.Sprintf("bytes=%d-%d", start, end))
+	}
+	if s.etag != "" && !strings.HasPrefix(s.etag, "W/") {
+		if ranged {
+			req.Header.Set("If-Range", s.etag)
+		} else {
+			req.Header.Set("If-Match", s.etag)
+		}
+	} else if s.modified != "" {
+		if ranged {
+			req.Header.Set("If-Range", s.modified)
+		} else {
+			req.Header.Set("If-Unmodified-Since", s.modified)
+		}
+	}
+	resp, err := s.client.Do(req)
+	if err != nil {
+		return nil, uploadedMP4HTTPError(ctx)
+	}
+	fail := func(message string) (*http.Response, error) {
+		resp.Body.Close()
+		return nil, fmt.Errorf("uploaded MP4 %s", message)
+	}
+	if v := resp.Header.Get("Content-Encoding"); v != "" && v != "identity" {
+		return fail("unexpected content encoding")
+	}
+	if s.etag != "" && resp.Header.Get("ETag") != s.etag {
+		return fail("resource validator changed")
+	}
+	if s.etag == "" && s.modified != "" && resp.Header.Get("Last-Modified") != s.modified {
+		return fail("resource validator changed")
+	}
+	if s.etag == "" && s.modified == "" {
+		s.etag = resp.Header.Get("ETag")
+		if v := resp.Header.Get("Last-Modified"); v != "" {
+			if _, err := http.ParseTime(v); err == nil {
+				s.modified = v
+			}
+		}
+	}
+	return resp, nil
+}
+
+// A 200 is not accepted as a successful range. It is handled separately only
+// for the initial request, when a genuinely sequential source can be identified.
+func (s *uploadedMP4HTTP) checkRange(resp *http.Response, start, end int64) (int64, error) {
+	if resp.StatusCode != http.StatusPartialContent {
+		return 0, fmt.Errorf("uploaded MP4 exact range requires HTTP 206")
+	}
+	v := strings.TrimPrefix(resp.Header.Get("Content-Range"), "bytes ")
+	if v == resp.Header.Get("Content-Range") {
+		return 0, fmt.Errorf("uploaded MP4 invalid Content-Range")
+	}
+	span, totalText, ok := strings.Cut(v, "/")
+	fromText, toText, ok2 := strings.Cut(span, "-")
+	from, e1 := strconv.ParseInt(fromText, 10, 64)
+	to, e2 := strconv.ParseInt(toText, 10, 64)
+	total, e3 := strconv.ParseInt(totalText, 10, 64)
+	if !ok || !ok2 || e1 != nil || e2 != nil || e3 != nil || total <= 0 || total > uploadedMP4SizeLimit ||
+		from != start || from < 0 || to < from || to >= total || to != min(end, total-1) || (s.total > 0 && total != s.total) {
+		return 0, fmt.Errorf("uploaded MP4 invalid Content-Range")
+	}
+	n := to - from + 1
+	if resp.ContentLength >= 0 && resp.ContentLength != n {
+		return 0, fmt.Errorf("uploaded MP4 range length disagrees with Content-Range")
+	}
+	s.total = total
+	return n, nil
+}
+
+func uploadedMP4ReadExact(r io.Reader, n int64) ([]byte, error) {
+	if n < 0 || n > uploadedMP4IndexLimit {
+		return nil, fmt.Errorf("uploaded MP4 metadata exceeds limit")
+	}
+	b := make([]byte, n)
+	if _, err := io.ReadFull(r, b); err != nil {
+		return nil, fmt.Errorf("uploaded MP4 response is truncated")
+	}
+	return b, nil
+}
+
+func uploadedMP4EOF(r io.Reader) error {
+	var extra [1]byte
+	n, err := r.Read(extra[:])
+	if n != 0 || err != io.EOF {
+		return fmt.Errorf("uploaded MP4 response length is not exact")
+	}
+	return nil
+}
+
+func (s *uploadedMP4HTTP) readRange(ctx context.Context, start, end int64) ([]byte, error) {
+	resp, err := s.request(ctx, start, end, true)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	n, err := s.checkRange(resp, start, end)
+	if err != nil {
+		return nil, err
+	}
+	b, err := uploadedMP4ReadExact(resp.Body, n)
+	if err == nil {
+		err = uploadedMP4EOF(resp.Body)
+	}
+	return b, err
+}
+
+func uploadedMP4Header(b []byte, offset, total int64) (uploadedMP4Box, error) {
+	if len(b) < 8 {
+		return uploadedMP4Box{}, fmt.Errorf("uploaded MP4 box header is truncated")
+	}
+	size := uint64(binary.BigEndian.Uint32(b[:4]))
+	header := int64(8)
+	if size == 1 {
+		if len(b) < 16 {
+			return uploadedMP4Box{}, fmt.Errorf("uploaded MP4 extended header is truncated")
+		}
+		size = binary.BigEndian.Uint64(b[8:16])
+		header = 16
+	} else if size == 0 {
+		size = uint64(total - offset)
+	}
+	if offset < 0 || offset > total || size < uint64(header) || size > uint64(total-offset) {
+		return uploadedMP4Box{}, fmt.Errorf("uploaded MP4 box size is invalid")
+	}
+	return uploadedMP4Box{string(b[4:8]), offset, int64(size), header}, nil
+}
+
+// The initial prefix is deliberately small: even a short real AAC fixture must
+// not have its entire mdat consumed just to discover the trailing moov.
+func planUploadedMP4(ctx context.Context, client *http.Client, url string) (*uploadedMP4Plan, error) {
+	return planUploadedMP4Clients(ctx, client, client, url)
+}
+
+func planUploadedMP4Clients(ctx context.Context, client, streamClient *http.Client, url string) (plan *uploadedMP4Plan, err error) {
+	defer func() {
+		if recover() != nil {
+			plan = nil
+			err = fmt.Errorf("uploaded MP4 index is malformed")
+		}
+	}()
+	p := &uploadedMP4Plan{remote: uploadedMP4HTTP{client: client, url: url}}
+	resp, err := p.remote.request(ctx, 0, uploadedMP4HeadLimit-1, true)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	var n int64
+	if resp.StatusCode == http.StatusPartialContent {
+		n, err = p.remote.checkRange(resp, 0, uploadedMP4HeadLimit-1)
+	} else if resp.StatusCode == http.StatusOK {
+		if resp.ContentLength <= 0 || resp.ContentLength > uploadedMP4SizeLimit {
+			return nil, fmt.Errorf("uploaded MP4 sequential source needs a bounded length")
+		}
+		p.remote.total = resp.ContentLength
+		n = min(resp.ContentLength, uploadedMP4HeadLimit)
+	} else {
+		return nil, fmt.Errorf("uploaded MP4 initial HTTP %d", resp.StatusCode)
+	}
+	if err != nil {
+		return nil, err
+	}
+	head, err := uploadedMP4ReadExact(resp.Body, n)
+	if err != nil {
+		return nil, err
+	}
+	if len(head) < 8 || string(head[4:8]) != "ftyp" {
+		return nil, fmt.Errorf("uploaded MP4 source has no leading ftyp")
+	}
+	if resp.StatusCode == http.StatusPartialContent {
+		if err := uploadedMP4EOF(resp.Body); err != nil {
+			return nil, err
+		}
+	}
+	p.outputLength = p.remote.total
+	if resp.StatusCode == http.StatusOK {
+		// Only a source that actually ignored Range takes this sequential path.
+		// It retains the original bytes and explicitly requires completed access.
+		if streamClient != client {
+			// The metadata client's total timeout must not cover an unavoidable
+			// full sequential scan. Close its prefix response before switching.
+			resp.Body.Close()
+			p.remote.client = streamClient
+			full, requestErr := p.remote.request(ctx, 0, 0, false)
+			if requestErr != nil {
+				return nil, requestErr
+			}
+			defer full.Body.Close()
+			if full.StatusCode != http.StatusOK || (full.ContentLength >= 0 && full.ContentLength != p.remote.total) {
+				return nil, fmt.Errorf("uploaded MP4 sequential source length or status changed")
+			}
+			err = p.inspectSequential(ctx, full.Body)
+		} else {
+			err = p.inspectSequential(ctx, io.MultiReader(bytes.NewReader(head), resp.Body))
+		}
+		return p, err
+	}
+	read := func(offset, size int64) ([]byte, error) {
+		if offset < 0 || size < 0 || size > p.remote.total-offset {
+			return nil, fmt.Errorf("uploaded MP4 metadata range is invalid")
+		}
+		if offset+size <= int64(len(head)) {
+			return head[offset : offset+size], nil
+		}
+		return p.remote.readRange(ctx, offset, offset+size-1)
+	}
+	var offset int64
+	var mdat *uploadedMP4Box
+	var ftyp, moovBytes []byte
+	for count := 0; count < uploadedMP4BoxLimit && offset < p.remote.total; count++ {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		h, err := read(offset, min(16, p.remote.total-offset))
+		if err != nil {
+			return nil, err
+		}
+		box, err := uploadedMP4Header(h, offset, p.remote.total)
+		if err != nil {
+			return nil, err
+		}
+		switch box.typ {
+		case "ftyp":
+			if offset != 0 || box.size > uploadedMP4HeadLimit {
+				return nil, fmt.Errorf("uploaded MP4 invalid ftyp")
+			}
+			ftyp, err = read(offset, box.size)
+			p.ftypSize = box.size
+		case "moov":
+			if p.moov != nil || box.size > uploadedMP4IndexLimit {
+				return nil, fmt.Errorf("uploaded MP4 duplicate or oversized index")
+			}
+			moovBytes, err = read(offset, box.size)
+			if err == nil {
+				p.moov, err = uploadedMP4DecodeMoov(moovBytes)
+			}
+			p.moovOffset, p.moovSize = offset, box.size
+			if err == nil && mdat == nil {
+				return p, nil
+			} // already front-moov / fMP4
+		case "mdat":
+			if mdat != nil {
+				return nil, fmt.Errorf("uploaded MP4 multiple media boxes are unsupported for relocation")
+			}
+			copy := box
+			mdat = &copy
+		case "free", "skip", "wide":
+		default:
+			return nil, fmt.Errorf("uploaded MP4 top-level %s cannot be safely relocated", box.typ)
+		}
+		if err != nil {
+			return nil, err
+		}
+		offset += box.size
+	}
+	if offset != p.remote.total || p.moov == nil || mdat == nil || len(ftyp) == 0 {
+		return nil, fmt.Errorf("uploaded MP4 index or box-count limit is invalid")
+	}
+	if err := p.relocate(ftyp, *mdat); err != nil {
+		return nil, err
+	}
+	return p, nil
+}
+
+func (p *uploadedMP4Plan) relocate(ftyp []byte, mdat uploadedMP4Box) error {
+	encoded, err := relocateUploadedMoov(p.moov, uint64(mdat.offset+mdat.header), uint64(mdat.offset+mdat.size))
+	if err != nil {
+		return err
+	}
+	p.prefix = append(append([]byte(nil), ftyp...), encoded...)
+	p.outputLength = p.remote.total - p.moovSize + int64(len(encoded))
+	if p.outputLength > uploadedMP4SizeLimit {
+		return fmt.Errorf("uploaded MP4 normalized output exceeds limit")
+	}
+	p.rewritten = true
+	return nil
+}
+
+func uploadedMP4DecodeMoov(data []byte) (*mp4.MoovBox, error) {
+	if err := validateUploadedMP4Index(data); err != nil {
+		return nil, err
+	}
+	b, err := mp4.DecodeBox(0, bytes.NewReader(data))
+	if err != nil {
+		return nil, fmt.Errorf("uploaded MP4 index is malformed")
+	}
+	moov, ok := b.(*mp4.MoovBox)
+	if !ok {
+		return nil, fmt.Errorf("uploaded MP4 index is not moov")
+	}
+	return moov, nil
+}
+
+// Bound nesting before entering the library's recursive decoder. Table sizes
+// remain checked by mp4ff; this walk only follows known container boundaries.
+func validateUploadedMP4Index(data []byte) error {
+	count := 0
+	var walk func([]byte, int) error
+	walk = func(data []byte, depth int) error {
+		if depth > 24 {
+			return fmt.Errorf("uploaded MP4 index nesting exceeds limit")
+		}
+		for offset := int64(0); offset < int64(len(data)); {
+			count++
+			if count > 4096 {
+				return fmt.Errorf("uploaded MP4 index box count exceeds limit")
+			}
+			box, err := uploadedMP4Header(data[offset:], offset, int64(len(data)))
+			if err != nil {
+				return err
+			}
+			body := data[offset+box.header : offset+box.size]
+			skip := -1
+			switch box.typ {
+			case "moov", "trak", "edts", "mdia", "minf", "stbl", "dinf", "udta", "ilst", "mvex", "sinf", "schi", "wave":
+				skip = 0
+			case "meta":
+				skip = 4
+			case "stsd", "dref":
+				skip = 8
+			case "mp4a", "alac", "enca":
+				skip = 28
+			}
+			if skip >= 0 {
+				if len(body) < skip {
+					return fmt.Errorf("uploaded MP4 index container is truncated")
+				}
+				if err := walk(body[skip:], depth+1); err != nil {
+					return err
+				}
+			}
+			offset += box.size
+		}
+		return nil
+	}
+	return walk(data, 0)
+}
+
+// Sequential discovery is used only after a real 200 proved Range unavailable.
+// Media is discarded with a bounded buffer, never retained or decoded. The
+// downstream descriptor exposes this unavoidable non-progressive startup mode.
+func (p *uploadedMP4Plan) inspectSequential(ctx context.Context, r io.Reader) error {
+	var offset int64
+	var mdat *uploadedMP4Box
+	var ftyp []byte
+	for count := 0; count < uploadedMP4BoxLimit && offset < p.remote.total; count++ {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		h, err := uploadedMP4ReadExact(r, 8)
+		if err != nil {
+			return err
+		}
+		if binary.BigEndian.Uint32(h[:4]) == 1 {
+			extra, err := uploadedMP4ReadExact(r, 8)
+			if err != nil {
+				return err
+			}
+			h = append(h, extra...)
+		}
+		box, err := uploadedMP4Header(h, offset, p.remote.total)
+		if err != nil {
+			return err
+		}
+		switch box.typ {
+		case "ftyp":
+			if offset != 0 || box.size > uploadedMP4HeadLimit {
+				return fmt.Errorf("uploaded MP4 invalid ftyp")
+			}
+			body, err := uploadedMP4ReadExact(r, box.size-box.header)
+			if err != nil {
+				return err
+			}
+			ftyp = append(h, body...)
+			p.ftypSize = box.size
+		case "moov":
+			if p.moov != nil {
+				return fmt.Errorf("uploaded MP4 duplicate index")
+			}
+			if box.size > uploadedMP4IndexLimit {
+				return fmt.Errorf("uploaded MP4 index exceeds limit")
+			}
+			body, err := uploadedMP4ReadExact(r, box.size-box.header)
+			if err != nil {
+				return err
+			}
+			p.moov, err = uploadedMP4DecodeMoov(append(h, body...))
+			if err != nil {
+				return err
+			}
+			p.moovOffset, p.moovSize = offset, box.size
+			if mdat == nil {
+				return nil
+			}
+		case "mdat", "free", "skip", "wide":
+			if box.typ == "mdat" {
+				if mdat != nil {
+					return fmt.Errorf("uploaded MP4 multiple media boxes are unsupported for relocation")
+				}
+				copy := box
+				mdat = &copy
+			}
+			if _, err := io.CopyN(io.Discard, r, box.size-box.header); err != nil {
+				return fmt.Errorf("uploaded MP4 sequential index scan is truncated")
+			}
+		default:
+			return fmt.Errorf("uploaded MP4 top-level %s cannot be safely relocated", box.typ)
+		}
+		offset += box.size
+	}
+	if offset != p.remote.total || p.moov == nil || mdat == nil {
+		return fmt.Errorf("uploaded MP4 index was not found within box limit")
+	}
+	if err := uploadedMP4EOF(r); err != nil {
+		return err
+	}
+	p.sequentialIndex = true
+	return p.relocate(ftyp, *mdat)
+}
+
+func relocateUploadedMoov(moov *mp4.MoovBox, payloadStart, payloadEnd uint64) ([]byte, error) {
+	if len(moov.Traks) != 1 || moov.Mvex != nil {
+		return nil, fmt.Errorf("uploaded MP4 relocation requires one non-fragmented audio track")
+	}
+	t := moov.Traks[0]
+	if t.Mdia == nil || t.Mdia.Hdlr == nil || t.Mdia.Hdlr.HandlerType != "soun" || t.Mdia.Minf == nil || t.Mdia.Minf.Stbl == nil {
+		return nil, fmt.Errorf("uploaded MP4 audio index is incomplete")
+	}
+	minf, stbl := t.Mdia.Minf, t.Mdia.Minf.Stbl
+	if minf.Dinf == nil || minf.Dinf.Dref == nil || len(minf.Dinf.Dref.Children) != 1 {
+		return nil, fmt.Errorf("uploaded MP4 data reference is unsupported")
+	}
+	u, ok := minf.Dinf.Dref.Children[0].(*mp4.URLBox)
+	if !ok || u.Flags&1 == 0 || stbl.Saio != nil || stbl.Saiz != nil {
+		return nil, fmt.Errorf("uploaded MP4 external or auxiliary data offsets are unsupported")
+	}
+	if (stbl.Stco == nil) == (stbl.Co64 == nil) {
+		return nil, fmt.Errorf("uploaded MP4 needs exactly one chunk-offset table")
+	}
+	var original []uint64
+	if stbl.Stco != nil {
+		for _, v := range stbl.Stco.ChunkOffset {
+			original = append(original, uint64(v))
+		}
+	} else {
+		original = append(original, stbl.Co64.ChunkOffset...)
+	}
+	if len(original) == 0 {
+		return nil, fmt.Errorf("uploaded MP4 chunk-offset table is empty")
+	}
+	for _, v := range original {
+		if v < payloadStart || v >= payloadEnd {
+			return nil, fmt.Errorf("uploaded MP4 chunk offset is outside media")
+		}
+	}
+	// Promotion changes moov size. Recompute from original offsets after it;
+	// never increment previously relocated offsets or truncate a 64-bit result.
+	delta := moov.Size()
+	if stbl.Stco != nil {
+		promote := false
+		for _, v := range original {
+			if v > math.MaxUint64-delta {
+				return nil, fmt.Errorf("uploaded MP4 offset overflow")
+			}
+			promote = promote || v+delta > math.MaxUint32
+		}
+		if promote {
+			old := stbl.Stco
+			large := &mp4.Co64Box{Version: old.Version, Flags: old.Flags, ChunkOffset: make([]uint64, len(original))}
+			for i, b := range stbl.Children {
+				if b == old {
+					stbl.Children[i] = large
+				}
+			}
+			stbl.Stco, stbl.Co64 = nil, large
+			delta = moov.Size()
+		}
+	}
+	for i, v := range original {
+		if v > math.MaxUint64-delta {
+			return nil, fmt.Errorf("uploaded MP4 offset overflow")
+		}
+		if stbl.Stco != nil {
+			stbl.Stco.ChunkOffset[i] = uint32(v + delta)
+		} else {
+			stbl.Co64.ChunkOffset[i] = v + delta
+		}
+	}
+	if moov.Size() > uploadedMP4IndexLimit {
+		return nil, fmt.Errorf("uploaded MP4 rewritten index exceeds limit")
+	}
+	var encoded bytes.Buffer
+	if err := moov.Encode(&encoded); err != nil {
+		return nil, fmt.Errorf("uploaded MP4 index encoding failed")
+	}
+	return encoded.Bytes(), nil
+}
+
+func (p *uploadedMP4Plan) sourceVersion() string {
+	if p.sequentialIndex {
+		return "uploaded-mp4-faststart-sequential-v1"
+	}
+	if p.rewritten {
+		return uploadedMP4Layout
+	}
+	return "uploaded-mp4-original-v1"
+}
+
+func (p *uploadedMP4Plan) Stream(ctx context.Context, w io.Writer) error {
+	// Copy the request state: concurrent session readers never mutate validators.
+	remote := p.remote
+	if p.sequentialIndex {
+		return p.streamSequential(ctx, w)
+	}
+	if !p.rewritten {
+		resp, err := remote.request(ctx, 0, 0, false)
+		if err != nil {
+			return err
+		}
+		defer resp.Body.Close()
+		if resp.StatusCode != http.StatusOK || (resp.ContentLength >= 0 && resp.ContentLength != remote.total) {
+			return fmt.Errorf("uploaded MP4 original length or status changed")
+		}
+		if hw, ok := w.(interface{ SetHeader(string, string) }); ok {
+			hw.SetHeader("Content-Length", strconv.FormatInt(remote.total, 10))
+		}
+		if _, err := io.CopyN(w, resp.Body, remote.total); err != nil {
+			return fmt.Errorf("uploaded MP4 original stream is truncated")
+		}
+		return uploadedMP4EOF(resp.Body)
+	}
+	spans := [][2]int64{{p.ftypSize, p.moovOffset - 1}, {p.moovOffset + p.moovSize, remote.total - 1}}
+	started := false
+	for _, span := range spans {
+		if span[0] > span[1] {
+			continue
+		}
+		resp, err := remote.request(ctx, span[0], span[1], true)
+		if err != nil {
+			return err
+		}
+		n, err := remote.checkRange(resp, span[0], span[1])
+		if err == nil && !started {
+			if hw, ok := w.(interface{ SetHeader(string, string) }); ok {
+				hw.SetHeader("Content-Length", strconv.FormatInt(p.outputLength, 10))
+			}
+			var written int
+			written, err = w.Write(p.prefix)
+			if err == nil && written != len(p.prefix) {
+				err = io.ErrShortWrite
+			}
+			started = true
+		}
+		if err == nil {
+			_, err = io.CopyN(w, resp.Body, n)
+		}
+		if err == nil {
+			err = uploadedMP4EOF(resp.Body)
+		}
+		resp.Body.Close()
+		if err != nil {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			return fmt.Errorf("uploaded MP4 media stream failed")
+		}
+	}
+	return nil
+}
+
+// No upstream Range means discovering a tail index necessarily reads the media
+// first. After that bounded-memory scan, still send a front-index stream rather
+// than relying on an invented seek capability or a decoder-error fallback.
+func (p *uploadedMP4Plan) streamSequential(ctx context.Context, w io.Writer) error {
+	remote := p.remote
+	resp, err := remote.request(ctx, 0, 0, false)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK || (resp.ContentLength >= 0 && resp.ContentLength != remote.total) {
+		return fmt.Errorf("uploaded MP4 sequential source length or status changed")
+	}
+	if _, err := io.CopyN(io.Discard, resp.Body, p.ftypSize); err != nil {
+		return fmt.Errorf("uploaded MP4 sequential source is truncated")
+	}
+	if hw, ok := w.(interface{ SetHeader(string, string) }); ok {
+		hw.SetHeader("Content-Length", strconv.FormatInt(p.outputLength, 10))
+	}
+	n, err := w.Write(p.prefix)
+	if err != nil {
+		return err
+	}
+	if n != len(p.prefix) {
+		return io.ErrShortWrite
+	}
+	if _, err := io.CopyN(w, resp.Body, p.moovOffset-p.ftypSize); err != nil {
+		return fmt.Errorf("uploaded MP4 sequential media is truncated")
+	}
+	if _, err := io.CopyN(io.Discard, resp.Body, p.moovSize); err != nil {
+		return fmt.Errorf("uploaded MP4 sequential index is truncated")
+	}
+	if _, err := io.CopyN(w, resp.Body, remote.total-p.moovOffset-p.moovSize); err != nil {
+		return fmt.Errorf("uploaded MP4 sequential trailer is truncated")
+	}
+	return uploadedMP4EOF(resp.Body)
+}
