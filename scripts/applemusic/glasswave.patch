diff --git a/engine/cmd/handlers_glasswave.go b/engine/cmd/handlers_glasswave.go
new file mode 100644
index 0000000..22e5e6a
--- /dev/null
+++ b/engine/cmd/handlers_glasswave.go
@@ -0,0 +1,546 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	pathpkg "path"
+	"strconv"
+	"strings"
+	"time"
+
+	"engine/core/drm"
+	"engine/utils/ampapi"
+)
+
+const (
+	defaultGlasswaveAppleAPIBase = "https://api.music.apple.com"
+	defaultGlasswaveAppleAMPBase = "https://amp-api.music.apple.com"
+
+	glasswaveAppleRequestLimit  = 512 << 10
+	glasswaveAppleResponseLimit = 8 << 20
+	glasswaveAppleUserAgent     = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
+)
+
+var glasswaveAppleHTTPClient = &http.Client{
+	Timeout: 30 * time.Second,
+	Transport: &http.Transport{
+		MaxIdleConns:        20,
+		MaxIdleConnsPerHost: 10,
+		IdleConnTimeout:     30 * time.Second,
+	},
+	// Apple API responses occasionally redirect. Returning the redirect to the
+	// caller preserves its status without letting an upstream response change
+	// the fixed host or carry auth headers to a new destination.
+	CheckRedirect: func(*http.Request, []*http.Request) error {
+		return http.ErrUseLastResponse
+	},
+}
+
+func glasswaveHeadlessEnabled() bool {
+	return strings.TrimSpace(os.Getenv("GLASSWAVE_HEADLESS")) == "1"
+}
+
+type glasswaveAppleRequest struct {
+	Method string          `json:"method"`
+	Path   string          `json:"path"`
+	Body   json.RawMessage `json:"body"`
+}
+
+type glasswaveAccountResponse struct {
+	SignedIn   bool   `json:"signedIn"`
+	Storefront string `json:"storefront"`
+	AccountID  string `json:"accountId"`
+	Name       string `json:"name,omitempty"`
+}
+
+type glasswaveStorefront struct {
+	ID   string
+	Name string
+}
+
+type glasswaveAppleStatusError struct {
+	StatusCode int
+}
+
+func (e *glasswaveAppleStatusError) Error() string {
+	return fmt.Sprintf("Apple Music API: HTTP %d", e.StatusCode)
+}
+
+func (s *APIServer) handleGlasswaveApple(w http.ResponseWriter, r *http.Request) {
+	r.Body = http.MaxBytesReader(w, r.Body, glasswaveAppleRequestLimit)
+	defer r.Body.Close()
+
+	var req glasswaveAppleRequest
+	dec := json.NewDecoder(r.Body)
+	if err := dec.Decode(&req); err != nil {
+		var maxErr *http.MaxBytesError
+		if errors.As(err, &maxErr) {
+			writeGlasswaveError(w, http.StatusRequestEntityTooLarge, "request body too large")
+		} else {
+			writeGlasswaveError(w, http.StatusBadRequest, "invalid request body")
+		}
+		return
+	}
+	var extra any
+	if err := dec.Decode(&extra); !errors.Is(err, io.EOF) {
+		writeGlasswaveError(w, http.StatusBadRequest, "invalid request body")
+		return
+	}
+
+	method := strings.ToUpper(strings.TrimSpace(req.Method))
+	if !glasswaveMethodAllowed(method) {
+		writeGlasswaveError(w, http.StatusBadRequest, "unsupported method")
+		return
+	}
+	target, err := s.validateGlasswaveApplePath(method, req.Path)
+	if err != nil {
+		writeGlasswaveError(w, http.StatusBadRequest, err.Error())
+		return
+	}
+	if len(req.Body) > glasswaveAppleRequestLimit {
+		writeGlasswaveError(w, http.StatusRequestEntityTooLarge, "request body too large")
+		return
+	}
+
+	account, _ := s.glasswaveNativeAccount(r.Context())
+	devToken := strings.TrimPrefix(strings.TrimSpace(account.DevToken), "Bearer ")
+	if devToken == "" {
+		devToken, err = s.glasswaveDeveloperToken()
+		if err != nil {
+			writeGlasswaveError(w, http.StatusBadGateway, "Apple developer token unavailable")
+			return
+		}
+	}
+	musicToken := strings.TrimSpace(account.MusicToken)
+	if musicToken == "" {
+		musicToken = strings.TrimSpace(s.musicUserToken())
+	}
+	if target.RequiresMusicToken && musicToken == "" {
+		writeGlasswaveError(w, http.StatusUnauthorized, "Apple Music account is not signed in")
+		return
+	}
+
+	var body io.Reader = http.NoBody
+	if len(req.Body) > 0 && !bytes.Equal(bytes.TrimSpace(req.Body), []byte("null")) {
+		body = bytes.NewReader(req.Body)
+	}
+	upstream, err := http.NewRequestWithContext(r.Context(), method, target.URL, body)
+	if err != nil {
+		writeGlasswaveError(w, http.StatusBadRequest, "invalid Apple API request")
+		return
+	}
+	upstream.Header.Set("Authorization", "Bearer "+devToken)
+	upstream.Header.Set("User-Agent", glasswaveAppleUserAgent)
+	upstream.Header.Set("Origin", "https://music.apple.com")
+	upstream.Header.Set("Accept", "application/json")
+	if len(req.Body) > 0 && body != http.NoBody {
+		upstream.Header.Set("Content-Type", "application/json")
+	}
+	if musicToken != "" {
+		// amp-api accepts the web header while api.music.apple.com documents
+		// Music-User-Token. Sending both names keeps the fixed upstream usable
+		// across both Apple API surfaces.
+		upstream.Header.Set("Music-User-Token", musicToken)
+		upstream.Header.Set("x-apple-music-user-token", musicToken)
+	}
+	s.copyGlasswaveAppleResponse(w, upstream, devToken, musicToken)
+}
+
+type validatedGlasswaveAppleTarget struct {
+	URL                string
+	RequiresMusicToken bool
+}
+
+func (s *APIServer) validateGlasswaveApplePath(method, raw string) (validatedGlasswaveAppleTarget, error) {
+	raw = strings.TrimSpace(raw)
+	if raw == "" || len(raw) > 8192 || strings.HasPrefix(raw, "//") || strings.Contains(raw, "#") {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("invalid Apple API path")
+	}
+	u, err := url.ParseRequestURI(raw)
+	if err != nil || u.IsAbs() || u.Scheme != "" || u.Host != "" || u.User != nil || u.Fragment != "" {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("invalid Apple API path")
+	}
+	if !strings.HasPrefix(u.Path, "/") || strings.ContainsAny(u.Path, "\\\x00") || pathpkg.Clean(u.Path) != u.Path {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("invalid Apple API path")
+	}
+	if !validGlasswavePathEncoding(u.EscapedPath()) {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("invalid Apple API path")
+	}
+	privateCatalogExtension := glasswaveCatalogRequiresWebAPI(u)
+	requiresMusicToken := strings.HasPrefix(u.Path, "/v1/me/") || privateCatalogExtension
+	if !requiresMusicToken && !strings.HasPrefix(u.Path, "/v1/catalog/") {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("Apple API path is not allowed")
+	}
+	if method != http.MethodGet && strings.HasPrefix(u.Path, "/v1/catalog/") {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("catalog API only supports reads")
+	}
+
+	base := s.glasswaveProxyBase()
+	if strings.HasPrefix(u.Path, "/v1/catalog/") && !privateCatalogExtension {
+		base = s.glasswaveOfficialBase()
+	}
+	b, err := url.Parse(base)
+	if err != nil || b.Host == "" || (b.Scheme != "https" && b.Scheme != "http") {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("Apple API endpoint is unavailable")
+	}
+	target := *b
+	target.Path = u.Path
+	target.RawPath = u.RawPath
+	target.RawQuery = u.RawQuery
+	target.Fragment = ""
+	return validatedGlasswaveAppleTarget{
+		URL:                target.String(),
+		RequiresMusicToken: requiresMusicToken,
+	}, nil
+}
+
+func glasswaveCatalogRequiresWebAPI(target *url.URL) bool {
+	for name, values := range target.Query() {
+		lowerName := strings.ToLower(name)
+		for _, value := range values {
+			lowerValue := strings.ToLower(value)
+			if strings.HasPrefix(lowerName, "extend") &&
+				(strings.Contains(lowerValue, "infavorites") || strings.Contains(lowerValue, "library-")) {
+				return true
+			}
+			if lowerName == "relate" &&
+				(strings.Contains(lowerValue, "library") || strings.Contains(lowerValue, "favorite")) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func validGlasswavePathEncoding(escapedPath string) bool {
+	candidate := escapedPath
+	for range 3 {
+		decoded, err := url.PathUnescape(candidate)
+		if err != nil || strings.ContainsAny(decoded, "\\\x00") || pathpkg.Clean(decoded) != decoded {
+			return false
+		}
+		if decoded == candidate {
+			return true
+		}
+		candidate = decoded
+	}
+	return false
+}
+
+func (s *APIServer) glasswaveProxyBase() string {
+	if s.glasswaveAMPBase != "" {
+		return s.glasswaveAMPBase
+	}
+	return defaultGlasswaveAppleAMPBase
+}
+
+func (s *APIServer) glasswaveOfficialBase() string {
+	if s.glasswaveAPIBase != "" {
+		return s.glasswaveAPIBase
+	}
+	return defaultGlasswaveAppleAPIBase
+}
+
+func (s *APIServer) glasswaveClient() *http.Client {
+	if s.glasswaveHTTPClient != nil {
+		return s.glasswaveHTTPClient
+	}
+	return glasswaveAppleHTTPClient
+}
+
+func (s *APIServer) copyGlasswaveAppleResponse(w http.ResponseWriter, req *http.Request, secrets ...string) {
+	resp, err := s.doGlasswaveAppleRequest(req)
+	if err != nil {
+		writeGlasswaveError(w, http.StatusBadGateway, "Apple Music API request failed")
+		return
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, glasswaveAppleResponseLimit+1))
+	if err != nil {
+		writeGlasswaveError(w, http.StatusBadGateway, "failed to read Apple Music API response")
+		return
+	}
+	if len(body) > glasswaveAppleResponseLimit {
+		writeGlasswaveError(w, http.StatusBadGateway, "Apple Music API response too large")
+		return
+	}
+	secrets = append(secrets, strings.TrimPrefix(req.Header.Get("Authorization"), "Bearer "))
+	for _, secret := range secrets {
+		if secret != "" {
+			body = bytes.ReplaceAll(body, []byte(secret), []byte("[redacted]"))
+		}
+	}
+	contentType := resp.Header.Get("Content-Type")
+	if contentType == "" {
+		contentType = "application/json"
+	}
+	w.Header().Set("Content-Type", contentType)
+	w.Header().Set("Cache-Control", "no-store")
+	w.WriteHeader(resp.StatusCode)
+	_, _ = w.Write(body)
+}
+
+func (s *APIServer) handleGlasswaveAccount(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Cache-Control", "no-store")
+	accountBefore, err := s.glasswaveNativeAccount(r.Context())
+	if err != nil {
+		if s.session == nil || !s.session.HasSession() {
+			writeGlasswaveAccount(w, http.StatusOK, glasswaveAccountResponse{SignedIn: false})
+		} else {
+			writeGlasswaveError(w, http.StatusServiceUnavailable, "Apple account is temporarily unavailable")
+		}
+		return
+	}
+	musicToken := strings.TrimSpace(accountBefore.MusicToken)
+	if musicToken == "" {
+		musicToken = strings.TrimSpace(s.musicUserToken())
+	}
+	if musicToken == "" {
+		writeGlasswaveAccount(w, http.StatusOK, glasswaveAccountResponse{SignedIn: false})
+		return
+	}
+	if accountBefore.DSID <= 0 {
+		writeGlasswaveError(w, http.StatusServiceUnavailable, "Apple account identity is temporarily unavailable")
+		return
+	}
+	devToken := strings.TrimPrefix(strings.TrimSpace(accountBefore.DevToken), "Bearer ")
+	if devToken == "" {
+		devToken, err = s.glasswaveDeveloperToken()
+		if err != nil {
+			writeGlasswaveError(w, http.StatusBadGateway, "Apple developer token unavailable")
+			return
+		}
+	}
+
+	storefront, err := s.fetchGlasswaveStorefront(r.Context(), devToken, musicToken, accountBefore.StorefrontID)
+	if err != nil {
+		var statusErr *glasswaveAppleStatusError
+		if errors.As(err, &statusErr) && (statusErr.StatusCode == http.StatusUnauthorized || statusErr.StatusCode == http.StatusForbidden) {
+			writeGlasswaveAccount(w, http.StatusOK, glasswaveAccountResponse{SignedIn: false})
+			return
+		}
+		writeGlasswaveError(w, http.StatusBadGateway, "Apple account validation failed")
+		return
+	}
+	accountAfter, err := s.glasswaveNativeAccount(r.Context())
+	if err != nil || accountAfter.DSID <= 0 {
+		writeGlasswaveError(w, http.StatusServiceUnavailable, "Apple account identity is temporarily unavailable")
+		return
+	}
+	if accountBefore.DSID != accountAfter.DSID {
+		writeGlasswaveError(w, http.StatusServiceUnavailable, "Apple account changed while it was being validated")
+		return
+	}
+	writeGlasswaveAccount(w, http.StatusOK, glasswaveAccountResponse{
+		SignedIn:   true,
+		Storefront: storefront.ID,
+		AccountID:  strconv.FormatInt(accountAfter.DSID, 10),
+		Name:       storefront.Name,
+	})
+}
+
+func writeGlasswaveAccount(w http.ResponseWriter, status int, response glasswaveAccountResponse) {
+	w.Header().Set("Cache-Control", "no-store")
+	writeJSON(w, status, response)
+}
+
+func (s *APIServer) glasswaveNativeAccount(ctx context.Context) (drm.AccountInfo, error) {
+	if s.glasswaveGetAccount != nil {
+		return s.glasswaveGetAccount(ctx)
+	}
+	if s.dm == nil {
+		return drm.AccountInfo{}, drm.ErrNotAuthenticated
+	}
+	return s.dm.GetAccount(ctx)
+}
+
+func (s *APIServer) glasswaveDeveloperToken() (string, error) {
+	if s.glasswaveGetToken != nil {
+		return s.glasswaveGetToken()
+	}
+	return glasswaveApplicationToken.get(time.Now(), ampapi.GetToken)
+}
+
+func (s *APIServer) doGlasswaveAppleRequest(req *http.Request) (*http.Response, error) {
+	response, err := s.glasswaveClient().Do(req)
+	if err != nil || response.StatusCode != http.StatusUnauthorized {
+		return response, err
+	}
+	used := strings.TrimPrefix(req.Header.Get("Authorization"), "Bearer ")
+	glasswaveApplicationToken.invalidate(used)
+	if req.Method != http.MethodGet {
+		return response, nil
+	}
+	fresh, refreshErr := s.glasswaveDeveloperToken()
+	if refreshErr != nil || fresh == used || (req.Body != nil && req.Body != http.NoBody && req.GetBody == nil) {
+		return response, nil
+	}
+	retry := req.Clone(req.Context())
+	if req.GetBody != nil {
+		retry.Body, refreshErr = req.GetBody()
+		if refreshErr != nil {
+			return response, nil
+		}
+	}
+	response.Body.Close()
+	retry.Header.Set("Authorization", "Bearer "+fresh)
+	// Also retain the current value for response redaction; it is never logged.
+	req.Header.Set("Authorization", "Bearer "+fresh)
+	return s.glasswaveClient().Do(retry)
+}
+
+func (s *APIServer) fetchGlasswaveStorefront(ctx context.Context, devToken, musicToken, nativeStorefront string) (glasswaveStorefront, error) {
+	base, err := url.Parse(s.glasswaveOfficialBase())
+	if err != nil || base.Host == "" {
+		return glasswaveStorefront{}, fmt.Errorf("Apple API endpoint is unavailable")
+	}
+	target := *base
+	target.Path = "/v1/me/storefront"
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, target.String(), nil)
+	if err != nil {
+		return glasswaveStorefront{}, err
+	}
+	req.Header.Set("Authorization", "Bearer "+devToken)
+	req.Header.Set("Music-User-Token", musicToken)
+	req.Header.Set("x-apple-music-user-token", musicToken)
+	req.Header.Set("User-Agent", glasswaveAppleUserAgent)
+	req.Header.Set("Origin", "https://music.apple.com")
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := s.doGlasswaveAppleRequest(req)
+	if err != nil {
+		return glasswaveStorefront{}, err
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20+1))
+	if err != nil {
+		return glasswaveStorefront{}, err
+	}
+	if len(body) > 1<<20 {
+		return glasswaveStorefront{}, fmt.Errorf("storefront response too large")
+	}
+	if resp.StatusCode != http.StatusOK {
+		return glasswaveStorefront{}, &glasswaveAppleStatusError{StatusCode: resp.StatusCode}
+	}
+
+	var decoded struct {
+		Data []struct {
+			ID         string `json:"id"`
+			Attributes struct {
+				Name string `json:"name"`
+			} `json:"attributes"`
+		} `json:"data"`
+	}
+	if err := json.Unmarshal(body, &decoded); err != nil || len(decoded.Data) == 0 {
+		return glasswaveStorefront{}, fmt.Errorf("invalid storefront response")
+	}
+	id := strings.ToLower(strings.TrimSpace(decoded.Data[0].ID))
+	if !isTwoLetterStorefront(id) {
+		id = strings.ToLower(strings.TrimSpace(nativeStorefront))
+	}
+	if !isTwoLetterStorefront(id) {
+		return glasswaveStorefront{}, fmt.Errorf("Apple returned an invalid storefront")
+	}
+	return glasswaveStorefront{
+		ID:   id,
+		Name: strings.TrimSpace(decoded.Data[0].Attributes.Name),
+	}, nil
+}
+
+func isTwoLetterStorefront(s string) bool {
+	if len(s) != 2 {
+		return false
+	}
+	for _, r := range s {
+		if (r < 'a' || r > 'z') && (r < 'A' || r > 'Z') {
+			return false
+		}
+	}
+	return true
+}
+
+type glasswavePlaybackCredentials struct {
+	Token      string
+	MusicToken string
+	Storefront string
+}
+
+// resolveGlasswavePlaybackCredentials fills omitted playback credentials from
+// the native account first. The caller's explicit values remain authoritative.
+// A storefront is never defaulted to "us": it is taken from a validated
+// /v1/me/storefront response when neither the request nor cached session has a
+// usable two-letter code.
+func (s *APIServer) resolveGlasswavePlaybackCredentials(ctx context.Context, token, musicToken, storefront string) (glasswavePlaybackCredentials, error) {
+	out := glasswavePlaybackCredentials{
+		Token:      strings.TrimPrefix(strings.TrimSpace(token), "Bearer "),
+		MusicToken: strings.TrimSpace(musicToken),
+		Storefront: strings.ToLower(strings.TrimSpace(storefront)),
+	}
+
+	var account drm.AccountInfo
+	if out.Token == "" || out.MusicToken == "" || !isTwoLetterStorefront(out.Storefront) {
+		account, _ = s.glasswaveNativeAccount(ctx)
+		if out.Token == "" {
+			out.Token = strings.TrimPrefix(strings.TrimSpace(account.DevToken), "Bearer ")
+		}
+		if out.MusicToken == "" {
+			out.MusicToken = strings.TrimSpace(account.MusicToken)
+		}
+		if !isTwoLetterStorefront(out.Storefront) {
+			nativeSF := strings.ToLower(strings.TrimSpace(drm.NormalizeStorefrontID(account.StorefrontID)))
+			if isTwoLetterStorefront(nativeSF) {
+				out.Storefront = nativeSF
+			}
+		}
+	}
+	if out.Token == "" {
+		var err error
+		out.Token, err = s.glasswaveDeveloperToken()
+		if err != nil {
+			return glasswavePlaybackCredentials{}, fmt.Errorf("Apple developer token unavailable")
+		}
+	}
+	if out.MusicToken == "" {
+		out.MusicToken = strings.TrimSpace(s.musicUserToken())
+	}
+	if out.Token == "" {
+		return glasswavePlaybackCredentials{}, fmt.Errorf("Apple developer token unavailable")
+	}
+	if out.MusicToken == "" {
+		return glasswavePlaybackCredentials{}, fmt.Errorf("Apple Music account is not signed in")
+	}
+	if !isTwoLetterStorefront(out.Storefront) {
+		cached := strings.ToLower(strings.TrimSpace(s.storefront()))
+		if isTwoLetterStorefront(cached) {
+			out.Storefront = cached
+		}
+	}
+	if !isTwoLetterStorefront(out.Storefront) {
+		resolved, err := s.fetchGlasswaveStorefront(ctx, out.Token, out.MusicToken, account.StorefrontID)
+		if err != nil {
+			return glasswavePlaybackCredentials{}, fmt.Errorf("Apple Music storefront validation failed")
+		}
+		out.Storefront = resolved.ID
+	}
+	return out, nil
+}
+
+func glasswaveMethodAllowed(method string) bool {
+	switch method {
+	case http.MethodGet, http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete:
+		return true
+	default:
+		return false
+	}
+}
+
+func writeGlasswaveError(w http.ResponseWriter, status int, message string) {
+	writeJSON(w, status, map[string]string{"error": message})
+}
diff --git a/engine/cmd/handlers_glasswave_lyrics.go b/engine/cmd/handlers_glasswave_lyrics.go
new file mode 100644
index 0000000..b127171
--- /dev/null
+++ b/engine/cmd/handlers_glasswave_lyrics.go
@@ -0,0 +1,614 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"regexp"
+	"sort"
+	"strings"
+	"unicode"
+
+	"engine/core/drm"
+	"engine/utils/lyrics"
+)
+
+const (
+	glasswaveLyricsRequestLimit = 64 << 10
+	glasswaveLyricsSearchLimit  = 5
+	glasswaveLyricsFetchLimit   = 3
+	glasswaveLyricsBodyLimit    = 4 << 20
+)
+
+var glasswaveLyricsLocaleRe = regexp.MustCompile(`^[A-Za-z0-9-]{2,32}$`)
+var errGlasswaveLyricsUnauthorized = errors.New("Apple Music account is not signed in")
+
+type glasswaveLyricsRequest struct {
+	Mode       string `json:"mode"`
+	TrackID    string `json:"trackId"`
+	TrackType  string `json:"trackType"`
+	Title      string `json:"title"`
+	Artist     string `json:"artist"`
+	Album      string `json:"album"`
+	Locale     string `json:"locale"`
+	DurationMs int    `json:"durationMs"`
+}
+
+type glasswaveLyricsResult struct {
+	Title      string `json:"title"`
+	Artist     string `json:"artist"`
+	Album      string `json:"album"`
+	LRC        string `json:"lrc"`
+	Confidence int    `json:"confidence"`
+}
+
+type glasswaveLyricsResponse struct {
+	Results []glasswaveLyricsResult `json:"results"`
+}
+
+type glasswaveLyricsSong struct {
+	ID         string `json:"id"`
+	Type       string `json:"type"`
+	Attributes struct {
+		Name             string `json:"name"`
+		ArtistName       string `json:"artistName"`
+		AlbumName        string `json:"albumName"`
+		DurationInMillis int    `json:"durationInMillis"`
+	} `json:"attributes"`
+}
+
+type glasswaveLyricsSearchResponse struct {
+	TopResults *struct {
+		Data []glasswaveLyricsSong `json:"data"`
+	} `json:"topResults"`
+	Results struct {
+		TopResults *struct {
+			Data []glasswaveLyricsSong `json:"data"`
+		} `json:"topResults"`
+		Songs *struct {
+			Data []glasswaveLyricsSong `json:"data"`
+		} `json:"songs"`
+	} `json:"results"`
+}
+
+type rankedGlasswaveLyricsSong struct {
+	song       glasswaveLyricsSong
+	confidence int
+}
+
+func (s *APIServer) handleGlasswaveLyrics(w http.ResponseWriter, r *http.Request) {
+	r.Body = http.MaxBytesReader(w, r.Body, glasswaveLyricsRequestLimit)
+	defer r.Body.Close()
+
+	var request glasswaveLyricsRequest
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&request); err != nil {
+		var maxErr *http.MaxBytesError
+		if errors.As(err, &maxErr) {
+			writeGlasswaveError(w, http.StatusRequestEntityTooLarge, "request body too large")
+		} else {
+			writeGlasswaveError(w, http.StatusBadRequest, "invalid lyrics request")
+		}
+		return
+	}
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		writeGlasswaveError(w, http.StatusBadRequest, "invalid lyrics request")
+		return
+	}
+	if err := validateGlasswaveLyricsRequest(&request, r); err != nil {
+		writeGlasswaveError(w, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	devToken, musicToken, err := s.glasswaveLyricsCredentials(r.Context())
+	if err != nil {
+		if errors.Is(err, errGlasswaveLyricsUnauthorized) {
+			writeGlasswaveError(w, http.StatusUnauthorized, "Apple Music account is not signed in")
+		} else {
+			writeGlasswaveError(w, http.StatusBadGateway, "Apple developer token unavailable")
+		}
+		return
+	}
+	storefront, err := s.glasswaveLyricsStorefront(r.Context(), devToken, musicToken)
+	if err != nil {
+		writeGlasswaveLyricsFailure(w, err)
+		return
+	}
+
+	var tracks []rankedGlasswaveLyricsSong
+	switch request.Mode {
+	case "direct":
+		trackID := request.TrackID
+		if request.TrackType == "library-songs" {
+			trackID, err = s.resolveGlasswaveLibraryLyricsID(
+				r.Context(), request.TrackID, request.Locale, devToken, musicToken)
+			if errors.Is(err, lyrics.ErrNotFound) {
+				writeJSON(w, http.StatusOK, glasswaveLyricsResponse{Results: []glasswaveLyricsResult{}})
+				return
+			}
+			if err != nil {
+				writeGlasswaveLyricsFailure(w, err)
+				return
+			}
+		}
+		tracks = []rankedGlasswaveLyricsSong{{
+			song: glasswaveLyricsSong{
+				ID:   trackID,
+				Type: "songs",
+			},
+			confidence: 100,
+		}}
+	case "search":
+		tracks, err = s.searchGlasswaveLyricsTracks(r.Context(), storefront, &request, devToken)
+		if err != nil {
+			writeGlasswaveLyricsFailure(w, err)
+			return
+		}
+	}
+
+	results := make([]glasswaveLyricsResult, 0, min(len(tracks), glasswaveLyricsFetchLimit))
+	for _, track := range tracks {
+		if len(results) == glasswaveLyricsFetchLimit {
+			break
+		}
+		lrc, err := s.getGlasswaveLyrics(
+			r.Context(), storefront, track.song.ID, request.Locale, devToken, musicToken)
+		if errors.Is(err, lyrics.ErrNotFound) {
+			continue
+		}
+		if err != nil {
+			writeGlasswaveLyricsFailure(w, err)
+			return
+		}
+		if lrc == "" || len(lrc) > glasswaveLyricsBodyLimit {
+			continue
+		}
+		results = append(results, glasswaveLyricsResult{
+			Title:      track.song.Attributes.Name,
+			Artist:     track.song.Attributes.ArtistName,
+			Album:      track.song.Attributes.AlbumName,
+			LRC:        lrc,
+			Confidence: track.confidence,
+		})
+	}
+	writeJSON(w, http.StatusOK, glasswaveLyricsResponse{Results: results})
+}
+
+func validateGlasswaveLyricsRequest(request *glasswaveLyricsRequest, r *http.Request) error {
+	request.Mode = strings.ToLower(strings.TrimSpace(request.Mode))
+	request.TrackID = strings.TrimSpace(request.TrackID)
+	request.TrackType = strings.ToLower(strings.TrimSpace(request.TrackType))
+	request.Title = strings.TrimSpace(request.Title)
+	request.Artist = strings.TrimSpace(request.Artist)
+	request.Album = strings.TrimSpace(request.Album)
+	request.Locale = strings.TrimSpace(request.Locale)
+	if request.Locale == "" {
+		request.Locale = sLang(r)
+	}
+	if !glasswaveLyricsLocaleRe.MatchString(request.Locale) {
+		return fmt.Errorf("invalid lyrics locale")
+	}
+	for _, value := range []string{request.Title, request.Artist, request.Album} {
+		if len(value) > 512 || strings.IndexFunc(value, unicode.IsControl) >= 0 {
+			return fmt.Errorf("invalid lyrics metadata")
+		}
+	}
+	if request.DurationMs < 0 || request.DurationMs > 24*60*60*1000 {
+		return fmt.Errorf("invalid track duration")
+	}
+	switch request.Mode {
+	case "direct":
+		if request.TrackType != "songs" && request.TrackType != "library-songs" {
+			return fmt.Errorf("invalid track type")
+		}
+		if !catalogIDRe.MatchString(request.TrackID) || request.TrackID == "." || request.TrackID == ".." {
+			return fmt.Errorf("invalid track id")
+		}
+	case "search":
+		if request.Title == "" {
+			return fmt.Errorf("lyrics search requires a title")
+		}
+		request.TrackType = "songs"
+	default:
+		return fmt.Errorf("invalid lyrics mode")
+	}
+	return nil
+}
+
+func sLang(r *http.Request) string {
+	value := strings.TrimSpace(r.URL.Query().Get("l"))
+	if value == "" {
+		value = "en-US"
+	}
+	return value
+}
+
+func (s *APIServer) glasswaveLyricsCredentials(ctx context.Context) (string, string, error) {
+	account, _ := s.glasswaveNativeAccount(ctx)
+	devToken := strings.TrimPrefix(strings.TrimSpace(account.DevToken), "Bearer ")
+	if devToken == "" {
+		var err error
+		devToken, err = s.glasswaveDeveloperToken()
+		if err != nil {
+			return "", "", err
+		}
+	}
+	musicToken := strings.TrimSpace(account.MusicToken)
+	if musicToken == "" {
+		musicToken = strings.TrimSpace(s.musicUserToken())
+	}
+	if devToken == "" {
+		return "", "", fmt.Errorf("Apple developer token unavailable")
+	}
+	if musicToken == "" {
+		return "", "", errGlasswaveLyricsUnauthorized
+	}
+	return devToken, musicToken, nil
+}
+
+func (s *APIServer) glasswaveLyricsStorefront(ctx context.Context, devToken, musicToken string) (string, error) {
+	storefront := strings.ToLower(strings.TrimSpace(drm.NormalizeStorefrontID(s.storefront())))
+	if isTwoLetterStorefront(storefront) {
+		return storefront, nil
+	}
+	resolved, err := s.fetchGlasswaveStorefront(ctx, devToken, musicToken, s.storefront())
+	if err != nil {
+		return "", err
+	}
+	return resolved.ID, nil
+}
+
+func (s *APIServer) resolveGlasswaveLibraryLyricsID(
+	ctx context.Context,
+	libraryID, locale, devToken, musicToken string,
+) (string, error) {
+	base, err := url.Parse(s.glasswaveProxyBase())
+	if err != nil || base.Host == "" {
+		return "", fmt.Errorf("Apple Music API endpoint is unavailable")
+	}
+	target := *base
+	target.Path = "/v1/me/library/songs/" + url.PathEscape(libraryID)
+	query := target.Query()
+	query.Set("include", "catalog")
+	query.Set("l", locale)
+	target.RawQuery = query.Encode()
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, target.String(), nil)
+	if err != nil {
+		return "", err
+	}
+	setGlasswaveLyricsHeaders(request, devToken, musicToken)
+	response, err := s.doGlasswaveAppleRequest(request)
+	if err != nil {
+		return "", fmt.Errorf("library lyrics mapping failed")
+	}
+	defer response.Body.Close()
+	if response.StatusCode == http.StatusNotFound {
+		return "", lyrics.ErrNotFound
+	}
+	if response.StatusCode != http.StatusOK {
+		return "", &glasswaveAppleStatusError{StatusCode: response.StatusCode}
+	}
+	body, err := io.ReadAll(io.LimitReader(response.Body, 1<<20+1))
+	if err != nil || len(body) > 1<<20 {
+		return "", fmt.Errorf("invalid library lyrics mapping")
+	}
+	var decoded struct {
+		Data []struct {
+			ID         string `json:"id"`
+			Type       string `json:"type"`
+			Attributes struct {
+				PlayParams struct {
+					ID          string `json:"id"`
+					Kind        string `json:"kind"`
+					IsLibrary   bool   `json:"isLibrary"`
+					CatalogID   string `json:"catalogId"`
+					Reporting   bool   `json:"reporting"`
+					ReportingID string `json:"reportingId"`
+				} `json:"playParams"`
+			} `json:"attributes"`
+		} `json:"data"`
+	}
+	if err := json.Unmarshal(body, &decoded); err != nil || len(decoded.Data) != 1 {
+		return "", fmt.Errorf("invalid library lyrics mapping")
+	}
+	item := decoded.Data[0]
+	params := item.Attributes.PlayParams
+	if item.ID != libraryID || item.Type != "library-songs" || !params.IsLibrary ||
+		params.ID != libraryID || params.Kind != "song" {
+		return "", lyrics.ErrNotFound
+	}
+	if validCatalogResourceID(params.ReportingID) && params.ReportingID != params.CatalogID {
+		if params.Reporting || params.CatalogID != "" {
+			return params.ReportingID, nil
+		}
+	}
+	if validCatalogResourceID(params.CatalogID) {
+		return params.CatalogID, nil
+	}
+	return "", lyrics.ErrNotFound
+}
+
+func validCatalogResourceID(id string) bool {
+	id = strings.TrimSpace(id)
+	return catalogIDRe.MatchString(id) && id != "." && id != ".." &&
+		(len(id) < 2 || id[1] != '.')
+}
+
+func (s *APIServer) searchGlasswaveLyricsTracks(
+	ctx context.Context,
+	storefront string,
+	request *glasswaveLyricsRequest,
+	devToken string,
+) ([]rankedGlasswaveLyricsSong, error) {
+	base, err := url.Parse(s.glasswaveOfficialBase())
+	if err != nil || base.Host == "" {
+		return nil, fmt.Errorf("Apple Music API endpoint is unavailable")
+	}
+	target := *base
+	target.Path = "/v1/catalog/" + url.PathEscape(storefront) + "/search"
+	query := target.Query()
+	query.Set("term", strings.TrimSpace(request.Title+" "+request.Artist))
+	query.Set("types", "songs")
+	query.Set("limit", "5")
+	query.Set("l", request.Locale)
+	query.Set("with", "topResults")
+	target.RawQuery = query.Encode()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, target.String(), nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Authorization", "Bearer "+devToken)
+	req.Header.Set("User-Agent", glasswaveAppleUserAgent)
+	req.Header.Set("Origin", "https://music.apple.com")
+	req.Header.Set("Accept", "application/json")
+	response, err := s.doGlasswaveAppleRequest(req)
+	if err != nil {
+		return nil, fmt.Errorf("lyrics metadata search failed")
+	}
+	defer response.Body.Close()
+	if response.StatusCode == http.StatusNotFound {
+		return nil, nil
+	}
+	if response.StatusCode != http.StatusOK {
+		return nil, &glasswaveAppleStatusError{StatusCode: response.StatusCode}
+	}
+	body, err := io.ReadAll(io.LimitReader(response.Body, 2<<20+1))
+	if err != nil || len(body) > 2<<20 {
+		return nil, fmt.Errorf("invalid lyrics metadata search")
+	}
+	var decoded glasswaveLyricsSearchResponse
+	if err := json.Unmarshal(body, &decoded); err != nil {
+		return nil, fmt.Errorf("invalid lyrics metadata search")
+	}
+	var songs []glasswaveLyricsSong
+	if decoded.TopResults != nil {
+		songs = append(songs, decoded.TopResults.Data...)
+	}
+	if decoded.Results.TopResults != nil {
+		songs = append(songs, decoded.Results.TopResults.Data...)
+	}
+	if decoded.Results.Songs != nil {
+		songs = append(songs, decoded.Results.Songs.Data...)
+	}
+
+	seen := make(map[string]struct{})
+	ranked := make([]rankedGlasswaveLyricsSong, 0, glasswaveLyricsSearchLimit)
+	for _, song := range songs {
+		if len(ranked) == glasswaveLyricsSearchLimit {
+			break
+		}
+		if song.Type != "songs" || !validCatalogResourceID(song.ID) {
+			continue
+		}
+		if _, exists := seen[song.ID]; exists {
+			continue
+		}
+		seen[song.ID] = struct{}{}
+		confidence := glasswaveLyricsMatchConfidence(request, song)
+		if confidence < 50 {
+			continue
+		}
+		ranked = append(ranked, rankedGlasswaveLyricsSong{song: song, confidence: confidence})
+	}
+	sort.SliceStable(ranked, func(i, j int) bool { return ranked[i].confidence > ranked[j].confidence })
+	return ranked, nil
+}
+
+func (s *APIServer) getGlasswaveLyrics(
+	ctx context.Context,
+	storefront, trackID, locale, devToken, musicToken string,
+) (string, error) {
+	fetch := s.glasswaveGetLyrics
+	if fetch == nil {
+		fetch = lyrics.GetContext
+	}
+	var notFound error
+	for _, lyricType := range []string{"syllable-lyrics", "lyrics"} {
+		value, err := fetch(ctx, storefront, trackID, lyricType, locale, "lrc", devToken, musicToken)
+		if err == nil && strings.TrimSpace(value) != "" {
+			return value, nil
+		}
+		if err == nil || errors.Is(err, lyrics.ErrNotFound) {
+			notFound = lyrics.ErrNotFound
+			continue
+		}
+		return "", err
+	}
+	return "", notFound
+}
+
+func setGlasswaveLyricsHeaders(request *http.Request, devToken, musicToken string) {
+	request.Header.Set("Authorization", "Bearer "+devToken)
+	request.Header.Set("Music-User-Token", musicToken)
+	request.Header.Set("x-apple-music-user-token", musicToken)
+	request.Header.Set("User-Agent", glasswaveAppleUserAgent)
+	request.Header.Set("Origin", "https://music.apple.com")
+	request.Header.Set("Accept", "application/json")
+}
+
+func writeGlasswaveLyricsFailure(w http.ResponseWriter, err error) {
+	if errors.Is(err, lyrics.ErrNotFound) {
+		writeJSON(w, http.StatusOK, glasswaveLyricsResponse{Results: []glasswaveLyricsResult{}})
+		return
+	}
+	var lyricsStatus *lyrics.HTTPError
+	if errors.As(err, &lyricsStatus) {
+		switch lyricsStatus.StatusCode {
+		case http.StatusUnauthorized, http.StatusForbidden:
+			writeGlasswaveError(w, lyricsStatus.StatusCode, "Apple Music lyrics authorization failed")
+		default:
+			writeGlasswaveError(w, http.StatusBadGateway, "Apple Music lyrics request failed")
+		}
+		return
+	}
+	var appleStatus *glasswaveAppleStatusError
+	if errors.As(err, &appleStatus) {
+		switch appleStatus.StatusCode {
+		case http.StatusUnauthorized, http.StatusForbidden:
+			writeGlasswaveError(w, appleStatus.StatusCode, "Apple Music authorization failed")
+		default:
+			writeGlasswaveError(w, http.StatusBadGateway, "Apple Music lyrics metadata request failed")
+		}
+		return
+	}
+	writeGlasswaveError(w, http.StatusBadGateway, "Apple Music lyrics request failed")
+}
+
+func glasswaveLyricsMatchConfidence(query *glasswaveLyricsRequest, candidate glasswaveLyricsSong) int {
+	title := glasswaveNormalizeLyricsText(query.Title)
+	foundTitle := glasswaveNormalizeLyricsText(candidate.Attributes.Name)
+	titleScore := glasswaveTextSimilarity(title, foundTitle)
+	if titleScore < 0.5 {
+		return 0
+	}
+	artistScore := glasswaveArtistSimilarity(query.Artist, candidate.Attributes.ArtistName)
+	if query.Artist != "" && candidate.Attributes.ArtistName != "" && artistScore < 0.4 {
+		return 0
+	}
+	albumScore := 0.5
+	if query.Album != "" && candidate.Attributes.AlbumName != "" {
+		albumScore = glasswaveTextSimilarity(
+			glasswaveNormalizeLyricsText(query.Album),
+			glasswaveNormalizeLyricsText(candidate.Attributes.AlbumName))
+	}
+	durationScore := 0.5
+	if query.DurationMs > 0 && candidate.Attributes.DurationInMillis > 0 {
+		difference := max(query.DurationMs, candidate.Attributes.DurationInMillis) -
+			min(query.DurationMs, candidate.Attributes.DurationInMillis)
+		durationScore = max(0.0, 1.0-float64(difference)/20000.0)
+	}
+	score := titleScore*65 + artistScore*25 + albumScore*5 + durationScore*5
+	return max(0, min(100, int(score+0.5)))
+}
+
+func glasswaveNormalizeLyricsText(text string) string {
+	return glasswaveNormalizeLyricsTextMode(text, true)
+}
+
+func glasswaveNormalizeLyricsTextMode(text string, stripBrackets bool) string {
+	var output []rune
+	depth := 0
+	for _, r := range text {
+		if stripBrackets {
+			switch r {
+			case '(', '[', '（', '【', '{':
+				depth++
+				continue
+			case ')', ']', '）', '】', '}':
+				if depth > 0 {
+					depth--
+				}
+				continue
+			}
+			if depth > 0 {
+				continue
+			}
+		}
+		if unicode.IsSpace(r) || unicode.IsPunct(r) {
+			continue
+		}
+		output = append(output, unicode.ToLower(r))
+	}
+	if len(output) == 0 && stripBrackets {
+		return glasswaveNormalizeLyricsTextMode(text, false)
+	}
+	return string(output)
+}
+
+func glasswaveTextSimilarity(a, b string) float64 {
+	if a == "" || b == "" {
+		return 0
+	}
+	if a == b {
+		return 1
+	}
+	if strings.Contains(a, b) || strings.Contains(b, a) {
+		shorter := min(len([]rune(a)), len([]rune(b)))
+		longer := max(len([]rune(a)), len([]rune(b)))
+		return 0.75 + 0.25*float64(shorter)/float64(longer)
+	}
+	ar := []rune(a)
+	br := []rune(b)
+	previous := make([]int, len(br)+1)
+	current := make([]int, len(br)+1)
+	for index := range previous {
+		previous[index] = index
+	}
+	for i := 1; i <= len(ar); i++ {
+		current[0] = i
+		for j := 1; j <= len(br); j++ {
+			cost := 0
+			if ar[i-1] != br[j-1] {
+				cost = 1
+			}
+			current[j] = min(previous[j]+1, current[j-1]+1, previous[j-1]+cost)
+		}
+		previous, current = current, previous
+	}
+	return 1 - float64(previous[len(br)])/float64(max(len(ar), len(br)))
+}
+
+func glasswaveArtistSimilarity(query, found string) float64 {
+	left := glasswaveSplitLyricsArtists(query)
+	right := glasswaveSplitLyricsArtists(found)
+	if len(left) == 0 || len(right) == 0 {
+		return 0.5
+	}
+	best := 0.0
+	for _, a := range left {
+		for _, b := range right {
+			best = max(best, glasswaveTextSimilarity(a, b))
+		}
+	}
+	return best
+}
+
+func glasswaveSplitLyricsArtists(value string) []string {
+	fields := strings.FieldsFunc(value, func(r rune) bool {
+		switch r {
+		case '/', ',', '&', '、', ';', '，', '×':
+			return true
+		default:
+			return false
+		}
+	})
+	output := make([]string, 0, len(fields))
+	for _, field := range fields {
+		lower := strings.ToLower(strings.TrimSpace(field))
+		if strings.HasPrefix(lower, "feat.") || strings.HasPrefix(lower, "ft.") ||
+			strings.HasPrefix(lower, "feat ") {
+			continue
+		}
+		if normalized := glasswaveNormalizeLyricsText(field); normalized != "" {
+			output = append(output, normalized)
+		}
+	}
+	return output
+}
