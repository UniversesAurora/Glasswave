@@ -0,0 +1,58 @@
+package main
+
+import (
+	"encoding/base64"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestGlasswaveTokenCacheCoalescesConcurrentCalls(t *testing.T) {
+	var cache glasswaveTokenCache
+	var calls atomic.Int32
+	now := time.Now()
+	fetch := func() (string, error) { calls.Add(1); return "fixture", nil }
+	var workers sync.WaitGroup
+	for range 20 {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			if _, err := cache.get(now, fetch); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	workers.Wait()
+	if calls.Load() != 1 {
+		t.Fatalf("fetch count = %d, want 1", calls.Load())
+	}
+	cache.invalidate("old-unrelated-token")
+	_, _ = cache.get(now, fetch)
+	if calls.Load() != 1 {
+		t.Fatal("an unrelated failure invalidated the current token")
+	}
+	cache.invalidate("fixture")
+	_, _ = cache.get(now, fetch)
+	if calls.Load() != 2 {
+		t.Fatal("invalidation did not refresh the token")
+	}
+}
+
+func TestGlasswaveTokenCacheHonorsJWTExpiry(t *testing.T) {
+	var cache glasswaveTokenCache
+	now := time.Unix(1_800_000_000, 0)
+	payload := base64.RawURLEncoding.EncodeToString([]byte(fmt.Sprintf(`{"exp":%d}`, now.Add(3*time.Minute).Unix())))
+	calls := 0
+	fetch := func() (string, error) { calls++; return "eyJ." + payload + ".fixture", nil }
+	_, _ = cache.get(now, fetch)
+	_, _ = cache.get(now.Add(time.Minute), fetch)
+	if calls != 1 {
+		t.Fatal("valid token was fetched again")
+	}
+	_, _ = cache.get(now.Add(2*time.Minute), fetch)
+	if calls != 2 {
+		t.Fatal("token was cached past its safe JWT expiry")
+	}
+}
