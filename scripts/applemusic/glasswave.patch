diff --git a/engine/core/apple/uploaded_mp4_native_test.go b/engine/core/apple/uploaded_mp4_native_test.go
new file mode 100644
index 0000000..cff3368
--- /dev/null
+++ b/engine/core/apple/uploaded_mp4_native_test.go
@@ -0,0 +1,260 @@
+package apple
+
+// This opt-in test exposes the actual normalizer, never an Apple/account API.
+// The native probe can consume its output while the original mdat's last byte
+// remains held upstream. It is skipped by every ordinary test invocation.
+import (
+	"context"
+	"crypto/rand"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/itouakirai/mp4ff/mp4"
+)
+
+func TestUploadedMP4NativeFixture(t *testing.T) {
+	statePath := os.Getenv("GLASSWAVE_UPLOAD_MP4_FIXTURE_STATE")
+	if statePath == "" {
+		t.Skip("The native fixture is explicitly opt-in")
+	}
+	fixtureName := strings.TrimSpace(os.Getenv("GLASSWAVE_UPLOAD_MP4_FIXTURE_FILE"))
+	if fixtureName == "" {
+		fixtureName = "aac-48.m4a"
+	}
+	if fixtureName != filepath.Base(fixtureName) {
+		t.Fatal("Native fixture must be a filename under the repository .local/tests directory")
+	}
+	input := uploadedLocalAAC(t, fixtureName)
+	mdat := uploadedTestBox(t, input, "mdat")
+	gateAt := mdat.offset + mdat.header + (mdat.size-mdat.header)/2
+	if gateAt <= mdat.offset+uploadedMP4HeadLimit || gateAt >= mdat.offset+mdat.size {
+		t.Fatal("Native fixture cannot select a safe mid-mdat gate")
+	}
+	heldRemainingBytes := int64(len(input)) - gateAt
+	f := &uploadedMP4Fixture{data: input, gateAt: gateAt, release: make(chan struct{}), cancelled: make(chan struct{}, 1)}
+	upstream := httptest.NewServer(http.HandlerFunc(f.handler))
+	defer upstream.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Minute)
+	defer cancel()
+	p, err := planUploadedMP4(ctx, upstream.Client(), upstream.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !p.rewritten || p.sequentialIndex {
+		t.Fatal("Native fixture did not use progressive tail-index normalization")
+	}
+	_, fixtureDurationMs, err := audioInfoFromMoov(p.moov)
+	if err != nil || fixtureDurationMs <= 0 {
+		t.Fatal("Native fixture could not determine its media duration")
+	}
+	token := rand.Text()
+	var release, stop sync.Once
+	done := make(chan struct{})
+	var mu sync.Mutex
+	requests, completed, failures := 0, 0, 0
+	released := false
+	var releaseUnixMs int64
+	openGate := func() {
+		release.Do(func() {
+			mu.Lock()
+			released = true
+			releaseUnixMs = time.Now().UnixMilli()
+			mu.Unlock()
+			close(f.release)
+		})
+	}
+	defer openGate()
+	mux := http.NewServeMux()
+	mux.HandleFunc("/stream", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet || r.Header.Get("Range") != "" {
+			w.WriteHeader(416)
+			return
+		}
+		mu.Lock()
+		requests++
+		mu.Unlock()
+		w.Header().Set("Content-Type", "audio/mp4")
+		w.Header().Set("Accept-Ranges", "none")
+		w.Header().Set("Content-Length", strconv.FormatInt(p.outputLength, 10))
+		if err := p.Stream(r.Context(), w); err != nil {
+			mu.Lock()
+			failures++
+			mu.Unlock()
+			return
+		}
+		mu.Lock()
+		completed++
+		mu.Unlock()
+	})
+	mux.HandleFunc("/release", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			w.WriteHeader(405)
+			return
+		}
+		openGate()
+		w.WriteHeader(204)
+	})
+	mux.HandleFunc("/state", func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		defer mu.Unlock()
+		f.mu.Lock()
+		served := f.served
+		gateReachedUnixMs := f.gateReachedUnixMs
+		lastByteWrittenUnixMs := f.lastByteWrittenUnixMs
+		f.mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]any{"requests": requests, "completed": completed, "failures": failures, "released": released, "releaseUnixMs": releaseUnixMs, "gateReachedUnixMs": gateReachedUnixMs, "lastByteWrittenUnixMs": lastByteWrittenUnixMs, "ready": true, "upstreamBytesServed": served, "originalBytes": len(input), "originalMdatBytes": mdat.size - mdat.header, "gateAt": gateAt, "heldRemainingBytes": heldRemainingBytes})
+	})
+	mux.HandleFunc("/stop", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			w.WriteHeader(405)
+			return
+		}
+		openGate()
+		stop.Do(func() { close(done) })
+		w.WriteHeader(204)
+	})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-Glasswave-Fixture") != token {
+			w.WriteHeader(403)
+			return
+		}
+		mux.ServeHTTP(w, r)
+	}))
+	defer func() { openGate(); cancel(); server.Close() }()
+	state := map[string]any{
+		"schema": 1, "ready": true, "readyUnixMs": time.Now().UnixMilli(),
+		"url": server.URL, "token": token, "codec": "aac", "sampleRate": 48000,
+		"channels": 2, "durationMs": fixtureDurationMs, "sourceVersion": p.sourceVersion(),
+		"outputBytes": p.outputLength, "originalBytes": len(input),
+		"originalMdatBytes": mdat.size - mdat.header, "gateAt": gateAt,
+		"heldRemainingBytes": heldRemainingBytes, "releaseUnixMs": int64(0),
+		"gateReachedUnixMs": int64(0), "lastByteWrittenUnixMs": int64(0),
+	}
+	data, err := json.Marshal(state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(statePath, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(statePath)
+	select {
+	case <-done:
+	case <-ctx.Done():
+		t.Fatal("Native fixture lifetime expired")
+	}
+}
+
+// TestNormalizeUploadedMP4AACFixture prepares a deterministic container-only
+// long fixture for the opt-in native runner. It rewrites timing metadata while
+// leaving the compressed mdat payload untouched.
+func TestNormalizeUploadedMP4AACFixture(t *testing.T) {
+	inputPath := strings.TrimSpace(os.Getenv("GLASSWAVE_UPLOAD_MP4_NORMALIZE_INPUT"))
+	outputPath := strings.TrimSpace(os.Getenv("GLASSWAVE_UPLOAD_MP4_NORMALIZE_OUTPUT"))
+	if inputPath == "" && outputPath == "" {
+		t.Skip("The AAC fixture normalizer is explicitly opt-in")
+	}
+	if inputPath == "" || outputPath == "" {
+		t.Fatal("Both AAC fixture normalization paths are required")
+	}
+	if err := normalizeUploadedMP4AACFixture(inputPath, outputPath); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func normalizeUploadedMP4AACFixture(inputPath, outputPath string) error {
+	const aacSamplesPerPacket = uint64(1024)
+
+	file, err := mp4.ReadMP4File(inputPath)
+	if err != nil {
+		return err
+	}
+	if file.Moov == nil || file.Moov.Mvhd == nil || len(file.Moov.Traks) != 1 {
+		return fmt.Errorf("AAC fixture must contain one movie track")
+	}
+	trak := file.Moov.Traks[0]
+	if trak.Mdia == nil || trak.Mdia.Hdlr == nil || trak.Mdia.Hdlr.HandlerType != "soun" ||
+		trak.Mdia.Mdhd == nil || trak.Mdia.Minf == nil || trak.Mdia.Minf.Stbl == nil ||
+		trak.Mdia.Minf.Stbl.Stts == nil {
+		return fmt.Errorf("AAC fixture track is incomplete")
+	}
+
+	stts := trak.Mdia.Minf.Stbl.Stts
+	var samples uint64
+	for index, count := range stts.SampleCount {
+		samples += uint64(count)
+		stts.SampleTimeDelta[index] = uint32(aacSamplesPerPacket)
+	}
+	if samples == 0 {
+		return fmt.Errorf("AAC fixture has no samples")
+	}
+	mediaDuration := samples * aacSamplesPerPacket
+	presentationDuration := mediaDuration
+	if trak.Edts != nil {
+		entries := 0
+		for _, box := range trak.Edts.Elst {
+			for index := range box.Entries {
+				entry := &box.Entries[index]
+				if entry.MediaTime > 0 {
+					skipped := uint64(entry.MediaTime)
+					if skipped > mediaDuration {
+						return fmt.Errorf("AAC fixture edit list exceeds media duration")
+					}
+					presentationDuration = mediaDuration - skipped
+				}
+				entry.SegmentDuration = rescaleDuration(
+					presentationDuration, trak.Mdia.Mdhd.Timescale, file.Moov.Mvhd.Timescale)
+				entries++
+			}
+		}
+		if entries != 1 {
+			return fmt.Errorf("AAC fixture must have one edit-list entry, found %d", entries)
+		}
+	}
+
+	trak.Mdia.Mdhd.Duration = mediaDuration
+	trak.Tkhd.Duration = rescaleDuration(
+		presentationDuration, trak.Mdia.Mdhd.Timescale, file.Moov.Mvhd.Timescale)
+	file.Moov.Mvhd.Duration = rescaleDuration(
+		presentationDuration, trak.Mdia.Mdhd.Timescale, file.Moov.Mvhd.Timescale)
+	if err := mp4.WriteToFile(file, outputPath); err != nil {
+		return err
+	}
+
+	normalized, err := mp4.ReadMP4File(outputPath)
+	if err != nil {
+		return err
+	}
+	if normalized.Moov == nil || normalized.Moov.Mvhd == nil || len(normalized.Moov.Traks) != 1 {
+		return fmt.Errorf("normalized AAC fixture lost its movie track")
+	}
+	normalizedTrack := normalized.Moov.Traks[0]
+	if normalized.Moov.Mvhd.Duration != trak.Tkhd.Duration ||
+		normalizedTrack.Tkhd.Duration != trak.Tkhd.Duration ||
+		normalizedTrack.Mdia.Mdhd.Duration != mediaDuration {
+		return fmt.Errorf("normalized AAC fixture has inconsistent duration metadata")
+	}
+	if normalizedTrack.Edts == nil || len(normalizedTrack.Edts.Elst) != 1 ||
+		len(normalizedTrack.Edts.Elst[0].Entries) != 1 ||
+		normalizedTrack.Edts.Elst[0].Entries[0].SegmentDuration != trak.Tkhd.Duration {
+		return fmt.Errorf("normalized AAC fixture has an inconsistent edit list")
+	}
+	return nil
+}
+
+func rescaleDuration(value uint64, from, to uint32) uint64 {
+	if from == 0 || to == 0 {
+		return 0
+	}
+	return value * uint64(to) / uint64(from)
+}
diff --git a/engine/core/apple/uploaded_mp4_test.go b/engine/core/apple/uploaded_mp4_test.go
new file mode 100644
index 0000000..fb246ef
--- /dev/null
+++ b/engine/core/apple/uploaded_mp4_test.go
@@ -0,0 +1,537 @@
+package apple
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/itouakirai/mp4ff/mp4"
+)
+
+func uploadedLocalAAC(t *testing.T, name string) []byte {
+	t.Helper()
+	dir, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for {
+		path := filepath.Join(dir, ".local", "tests", name)
+		if data, err := os.ReadFile(path); err == nil {
+			return data
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			t.Fatalf("Required local AAC fixture is missing: %s", name)
+		}
+		dir = parent
+	}
+}
+
+func uploadedTestBoxes(t *testing.T, data []byte) []uploadedMP4Box {
+	t.Helper()
+	var boxes []uploadedMP4Box
+	for pos := int64(0); pos < int64(len(data)); {
+		box, err := uploadedMP4Header(data[pos:], pos, int64(len(data)))
+		if err != nil {
+			t.Fatal(err)
+		}
+		boxes = append(boxes, box)
+		pos += box.size
+	}
+	return boxes
+}
+
+func uploadedTestBox(t *testing.T, data []byte, typ string) uploadedMP4Box {
+	t.Helper()
+	for _, box := range uploadedTestBoxes(t, data) {
+		if box.typ == typ {
+			return box
+		}
+	}
+	t.Fatalf("Missing %s in fixture", typ)
+	return uploadedMP4Box{}
+}
+
+type uploadedMP4Fixture struct {
+	mu                    sync.Mutex
+	data                  []byte
+	requests              []string
+	ifRanges              []string
+	served                int64
+	ignoreRange           bool
+	truncateMedia         bool
+	mutate                func(*http.Request, *http.Response)
+	gateAt                int64
+	release               chan struct{}
+	cancelled             chan struct{}
+	gateReachedUnixMs     int64
+	lastByteWrittenUnixMs int64
+}
+
+func (f *uploadedMP4Fixture) handler(w http.ResponseWriter, r *http.Request) {
+	f.mu.Lock()
+	f.requests = append(f.requests, r.Header.Get("Range"))
+	f.ifRanges = append(f.ifRanges, r.Header.Get("If-Range"))
+	f.mu.Unlock()
+	start, end, status := int64(0), int64(len(f.data)-1), http.StatusOK
+	if value := r.Header.Get("Range"); value != "" && !f.ignoreRange {
+		if _, err := fmt.Sscanf(value, "bytes=%d-%d", &start, &end); err != nil || start < 0 || start >= int64(len(f.data)) || end < start {
+			w.WriteHeader(416)
+			return
+		}
+		end = min(end, int64(len(f.data)-1))
+		status = http.StatusPartialContent
+	}
+	resp := &http.Response{StatusCode: status, Header: make(http.Header), ContentLength: end - start + 1}
+	resp.Header.Set("ETag", `"uploaded-fixture-v1"`)
+	if status == http.StatusPartialContent {
+		resp.Header.Set("Content-Range", fmt.Sprintf("bytes %d-%d/%d", start, end, len(f.data)))
+	}
+	if f.mutate != nil {
+		f.mutate(r, resp)
+	}
+	for k, values := range resp.Header {
+		for _, value := range values {
+			w.Header().Add(k, value)
+		}
+	}
+	w.Header().Set("Content-Length", fmt.Sprint(resp.ContentLength))
+	w.WriteHeader(resp.StatusCode)
+	if f.truncateMedia && start == 28 && status == http.StatusPartialContent {
+		end--
+	}
+	write := func(b []byte) { n, _ := w.Write(b); f.mu.Lock(); f.served += int64(n); f.mu.Unlock() }
+	if f.release != nil && start <= f.gateAt && end >= f.gateAt && end-start+1 > uploadedMP4HeadLimit {
+		write(f.data[start:f.gateAt])
+		f.mu.Lock()
+		if f.gateReachedUnixMs == 0 {
+			f.gateReachedUnixMs = time.Now().UnixMilli()
+		}
+		f.mu.Unlock()
+		if flusher, ok := w.(http.Flusher); ok {
+			flusher.Flush()
+		}
+		select {
+		case <-f.release:
+		case <-r.Context().Done():
+			if f.cancelled != nil {
+				select {
+				case f.cancelled <- struct{}{}:
+				default:
+				}
+			}
+			return
+		}
+		write(f.data[f.gateAt : end+1])
+		f.mu.Lock()
+		f.lastByteWrittenUnixMs = time.Now().UnixMilli()
+		f.mu.Unlock()
+		return
+	}
+	write(f.data[start : end+1])
+}
+
+type uploadedPrefixWriter struct {
+	bytes.Buffer
+	first    chan []byte
+	gotFirst bool
+}
+
+func (w *uploadedPrefixWriter) Write(b []byte) (int, error) {
+	if !w.gotFirst {
+		w.gotFirst = true
+		w.first <- append([]byte(nil), b...)
+	}
+	return w.Buffer.Write(b)
+}
+
+func TestUploadedMP4TailAACRangeStartsBeforeMediaEOF(t *testing.T) {
+	input := uploadedLocalAAC(t, "aac-48.m4a")
+	mdat := uploadedTestBox(t, input, "mdat")
+	f := &uploadedMP4Fixture{data: input, gateAt: mdat.offset + mdat.size - 1, release: make(chan struct{})}
+	server := httptest.NewServer(http.HandlerFunc(f.handler))
+	defer server.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	p, err := planUploadedMP4(ctx, server.Client(), server.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !p.rewritten || p.sequentialIndex || p.sourceVersion() != uploadedMP4Layout {
+		t.Fatalf("Wrong optimized-source capability")
+	}
+	f.mu.Lock()
+	before := f.served
+	f.mu.Unlock()
+	if before >= int64(len(input)) {
+		t.Fatalf("Index discovery consumed the entire source: %d", before)
+	}
+	w := &uploadedPrefixWriter{first: make(chan []byte, 1)}
+	done := make(chan error, 1)
+	go func() { done <- p.Stream(ctx, w) }()
+	select {
+	case prefix := <-w.first:
+		boxes := uploadedTestBoxes(t, prefix)
+		if len(boxes) != 2 || boxes[0].typ != "ftyp" || boxes[1].typ != "moov" {
+			t.Fatal("No front index before media completion")
+		}
+	case err := <-done:
+		t.Fatalf("Completed before final-byte release: %v", err)
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	select {
+	case err := <-done:
+		t.Fatalf("Ignored the final-byte gate: %v", err)
+	default:
+	}
+	close(f.release)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	output := w.Bytes()
+	outMdat := uploadedTestBox(t, output, "mdat")
+	if !bytes.Equal(input[mdat.offset+mdat.header:mdat.offset+mdat.size], output[outMdat.offset+outMdat.header:outMdat.offset+outMdat.size]) {
+		t.Fatal("Encoded AAC media bytes changed")
+	}
+	if int64(len(output)) != p.outputLength {
+		t.Fatal("Transformed Content-Length is wrong")
+	}
+	oldMoov := uploadedTestBox(t, input, "moov")
+	outMoov := uploadedTestBox(t, output, "moov")
