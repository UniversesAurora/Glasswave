+func TestUploadedLibraryMP3EndToEndContract(t *testing.T) {
+	seconds := 3000
+	fixture := &uploadedHTTPFixture{
+		playbackBody: uploadedPlaybackJSON("i.test", seconds, 44100, 192, "mp3"),
+		assetBody:    mp3Fixture(seconds, 192_000, 44100),
