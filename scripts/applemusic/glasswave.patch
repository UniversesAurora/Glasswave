+	if strings.Contains(w.Body.String(), "1073741824") || strings.Contains(w.Body.String(), "1 GiB") {
+		t.Fatalf("response invented a file length: %q", w.Body.String())
+	}
+	select {
+	case <-started:
+	case <-time.After(2 * time.Second):
+		t.Fatal("cache warm did not start")
