+	}))
+	defer publicServer.Close()
+	privateServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		privateRequests.Add(1)
+		w.WriteHeader(http.StatusBadGateway)
+	}))
