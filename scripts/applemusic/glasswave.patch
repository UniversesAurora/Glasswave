@@ -0,0 +1,192 @@
+package fairplay
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+
+	"github.com/itouakirai/mp4ff/mp4"
+
+	"engine/utils/alacstream"
+)
+
+const (
+	ec3InitLimit     = int64(16 << 20)
+	ec3FragmentLimit = int64(128 << 20)
+	ec3StreamLimit   = int64(8 << 30)
+)
+
+// EC3StreamFunc writes decrypted fragmented MP4 into the supplied destination.
+// The playback manager supplies a function that runs the existing media pipeline.
+type EC3StreamFunc func(context.Context, io.Writer) error
+
+// RemuxEC3 extracts the encoded EC-3 access units from a decrypted, single-track
+// fragmented MP4 stream and writes the original sample bytes without parsing or
+// re-encoding the Dolby bitstream. EC-3 JOC metadata and OAMD bytes therefore
+// remain byte-for-byte intact for the downstream renderer.
+func RemuxEC3(ctx context.Context, dst io.Writer, stream EC3StreamFunc) error {
+	if stream == nil {
+		return fmt.Errorf("ec3 remux: source stream is nil")
+	}
+	pr, pw := io.Pipe()
+	streamCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	sourceDone := make(chan error, 1)
+	go func() {
+		err := stream(streamCtx, pw)
+		_ = pw.CloseWithError(err)
+		sourceDone <- err
+	}()
+
+	remuxErr := remuxEC3(ctx, pr, dst)
+	if remuxErr != nil {
+		cancel()
+		_ = pr.CloseWithError(remuxErr)
+	}
+	sourceErr := <-sourceDone
+	if remuxErr != nil {
+		return remuxErr
+	}
+	return sourceErr
+}
+
+func remuxEC3(ctx context.Context, r io.Reader, w io.Writer) error {
+	bounded := &ec3BoundedReader{r: r, totalRemaining: ec3StreamLimit}
+
+	bounded.beginPhase(ec3InitLimit)
+	init, offset, err := alacstream.ReadInitSegment(bounded)
+	if err != nil {
+		return fmt.Errorf("ec3 remux: read init segment: %w", err)
+	}
+	trex, err := validateEC3Init(init)
+	if err != nil {
+		return err
+	}
+
+	for fragmentIndex := 0; ; fragmentIndex++ {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		bounded.beginPhase(ec3FragmentLimit)
+		frag, nextOffset, err := alacstream.ReadNextFragment(bounded, offset)
+		if err != nil {
+			return fmt.Errorf("ec3 remux: read fragment %d: %w", fragmentIndex, err)
+		}
+		if frag == nil {
+			return nil
+		}
+		offset = nextOffset
+		samples, err := frag.GetFullSamples(trex)
+		if err != nil {
+			return fmt.Errorf("ec3 remux: fragment %d samples: %w", fragmentIndex, err)
+		}
+		if len(samples) == 0 {
+			return fmt.Errorf("ec3 remux: fragment %d contains no EC-3 samples", fragmentIndex)
+		}
+		for sampleIndex := range samples {
+			if err := writeFull(w, samples[sampleIndex].Data); err != nil {
+				return fmt.Errorf("ec3 remux: write fragment %d sample %d: %w", fragmentIndex, sampleIndex, err)
+			}
+		}
+	}
+}
+
+func validateEC3Init(init *mp4.InitSegment) (*mp4.TrexBox, error) {
+	if init == nil || init.Moov == nil {
+		return nil, fmt.Errorf("ec3 remux: init segment has no moov box")
+	}
+	for _, trak := range init.Moov.Traks {
+		if trak.Mdia == nil || trak.Mdia.Hdlr == nil || trak.Mdia.Hdlr.HandlerType != "soun" ||
+			trak.Mdia.Minf == nil || trak.Mdia.Minf.Stbl == nil || trak.Mdia.Minf.Stbl.Stsd == nil {
+			continue
+		}
+		hasEC3 := false
+		for _, entry := range trak.Mdia.Minf.Stbl.Stsd.Children {
+			if entry.Type() == "ec-3" {
+				hasEC3 = true
+				break
+			}
+		}
+		if !hasEC3 {
+			return nil, fmt.Errorf("ec3 remux: selected audio track is %q, want EC-3", firstSampleEntryType(trak))
+		}
+		if trak.Tkhd == nil {
+			return nil, fmt.Errorf("ec3 remux: EC-3 track has no track header")
+		}
+		if init.Moov.Mvex == nil || len(init.Moov.Mvex.Trexs) == 0 {
+			// A single-track fragment defaults to its only traf, so a missing
+			// trex is still decodable when the fragment supplies all values.
+			return nil, nil
+		}
+		for _, trex := range init.Moov.Mvex.Trexs {
+			if trex.TrackID == trak.Tkhd.TrackID {
+				return trex, nil
+			}
+		}
+		return nil, fmt.Errorf("ec3 remux: EC-3 track %d has no trex defaults", trak.Tkhd.TrackID)
+	}
+	return nil, fmt.Errorf("ec3 remux: init segment has no audio track")
+}
+
+func firstSampleEntryType(trak *mp4.TrakBox) string {
+	if trak == nil || trak.Mdia == nil || trak.Mdia.Minf == nil ||
+		trak.Mdia.Minf.Stbl == nil || trak.Mdia.Minf.Stbl.Stsd == nil ||
+		len(trak.Mdia.Minf.Stbl.Stsd.Children) == 0 {
+		return "unknown"
+	}
+	return trak.Mdia.Minf.Stbl.Stsd.Children[0].Type()
+}
+
+func writeFull(w io.Writer, data []byte) error {
+	for len(data) > 0 {
+		n, err := w.Write(data)
+		if n > 0 {
+			data = data[n:]
+		}
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+	}
+	return nil
+}
+
+type ec3BoundedReader struct {
+	r              io.Reader
+	phaseRemaining int64
+	totalRemaining int64
+}
+
+func (r *ec3BoundedReader) beginPhase(limit int64) {
+	r.phaseRemaining = limit
+}
+
+func (r *ec3BoundedReader) Read(p []byte) (int, error) {
+	if r.totalRemaining <= 0 {
+		return 0, fmt.Errorf("ec3 remux: stream exceeds %d bytes", ec3StreamLimit)
+	}
+	if r.phaseRemaining <= 0 {
+		var probe [1]byte
+		n, err := r.r.Read(probe[:])
+		if n > 0 {
+			return 0, fmt.Errorf("ec3 remux: fragment exceeds %d bytes", ec3FragmentLimit)
+		}
+		return 0, err
+	}
+	if int64(len(p)) > r.phaseRemaining {
+		p = p[:r.phaseRemaining]
+	}
+	if int64(len(p)) > r.totalRemaining {
+		p = p[:r.totalRemaining]
+	}
+	n, err := r.r.Read(p)
+	r.phaseRemaining -= int64(n)
+	r.totalRemaining -= int64(n)
+	if errors.Is(err, io.EOF) {
+		return n, io.EOF
+	}
+	return n, err
+}
diff --git a/engine/core/fairplay/ec3_remux_test.go b/engine/core/fairplay/ec3_remux_test.go
new file mode 100644
index 0000000..5ee2534
--- /dev/null
+++ b/engine/core/fairplay/ec3_remux_test.go
@@ -0,0 +1,153 @@
+package fairplay
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"testing"
+	"time"
+
+	"github.com/itouakirai/mp4ff/mp4"
+)
+
+func TestRemuxEC3PreservesSamplesAcrossFragments(t *testing.T) {
+	stream, samples := buildEC3TestFMP4(t, "ec-3")
+	var out bytes.Buffer
+	err := RemuxEC3(context.Background(), &out, bytesEC3Stream(stream))
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := joinSamples(samples)
+	if !bytes.Equal(out.Bytes(), want) {
+		t.Fatalf("remuxed %d bytes, want %d; samples were not preserved", out.Len(), len(want))
+	}
+}
+
+func TestRemuxEC3RejectsInvalidCodec(t *testing.T) {
+	stream, _ := buildEC3TestFMP4(t, "mp4a")
+	err := RemuxEC3(context.Background(), io.Discard, bytesEC3Stream(stream))
+	if err == nil || !bytes.Contains([]byte(err.Error()), []byte("want EC-3")) {
+		t.Fatalf("error = %v, want invalid-codec rejection", err)
+	}
+}
+
+func TestRemuxEC3RejectsTruncatedFragment(t *testing.T) {
+	stream, _ := buildEC3TestFMP4(t, "ec-3")
+	stream = stream[:len(stream)-5]
+	var out bytes.Buffer
+	err := RemuxEC3(context.Background(), &out, bytesEC3Stream(stream))
+	if err == nil {
+		t.Fatal("expected a truncated fragment error")
+	}
+}
+
+func TestRemuxEC3HonorsContextAfterPartialStream(t *testing.T) {
+	stream, _ := buildEC3TestFMP4(t, "ec-3")
+	firstMoofType := bytes.Index(stream, []byte("moof"))
+	if firstMoofType < 4 {
+		t.Fatal("test fixture has no moof")
+	}
+	nextMoofType := bytes.Index(stream[firstMoofType+4:], []byte("moof"))
+	firstFragmentEnd := len(stream)
+	if nextMoofType >= 0 {
+		firstFragmentEnd = firstMoofType + 4 + nextMoofType - 4
+	}
+	if firstFragmentEnd <= firstMoofType {
+		firstFragmentEnd = len(stream)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	err := RemuxEC3(ctx, io.Discard, func(ctx context.Context, w io.Writer) error {
+		if _, err := w.Write(stream[:firstFragmentEnd]); err != nil {
+			return err
+		}
+		<-ctx.Done()
+		return ctx.Err()
+	})
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("error = %v, want context deadline", err)
+	}
+}
+
+func buildEC3TestFMP4(t *testing.T, codec string) ([]byte, [][][]byte) {
+	t.Helper()
+	init := mp4.CreateEmptyInit()
+	init.AddEmptyTrack(48000, "audio", "und")
+	trak := init.Moov.Traks[0]
+	if codec == "ec-3" {
+		dec3 := &mp4.Dec3Box{
+			DataRate: 768,
+			EC3Subs: []mp4.EC3Sub{{
+				FSCod: 0, BSID: 16, ACMod: 7, LFEOn: 1,
+			}},
+		}
+		if err := trak.SetEC3Descriptor(dec3); err != nil {
+			t.Fatal(err)
+		}
+	} else {
+		trak.Mdia.Minf.Stbl.Stsd.AddChild(
+			mp4.CreateAudioSampleEntryBox(codec, 8, 16, 48000, nil),
+		)
+	}
+
+	samples := [][][]byte{
+		{
+			append([]byte{0x0b, 0x77, 0x01, 0xff}, bytes.Repeat([]byte{0x11}, 48)...),
+			append([]byte{0x0b, 0x77, 0x02, 0xee}, bytes.Repeat([]byte{0x22}, 53)...),
+		},
+		{
+			append([]byte{0x0b, 0x77, 0x03, 0xdd}, bytes.Repeat([]byte{0x33}, 61)...),
+		},
+		{
+			append([]byte{0x0b, 0x77, 0x04, 0xcc}, bytes.Repeat([]byte{0x44}, 37)...),
+			append([]byte{0x0b, 0x77, 0x05, 0xbb}, bytes.Repeat([]byte{0x55}, 42)...),
+			append([]byte{0x0b, 0x77, 0x06, 0xaa}, bytes.Repeat([]byte{0x66}, 29)...),
+		},
+	}
+
+	var out bytes.Buffer
+	if err := init.Encode(&out); err != nil {
+		t.Fatal(err)
+	}
+	var decodeTime uint64
+	for i, fragmentSamples := range samples {
+		frag, err := mp4.CreateFragment(uint32(i+1), 1)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, data := range fragmentSamples {
+			frag.AddFullSample(mp4.FullSample{
+				Sample: mp4.Sample{
+					Flags: mp4.SyncSampleFlags,
+					Dur:   1536,
+					Size:  uint32(len(data)),
+				},
+				DecodeTime: decodeTime,
+				Data:       data,
+			})
+			decodeTime += 1536
+		}
+		if err := frag.Encode(&out); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return out.Bytes(), samples
+}
+
+func bytesEC3Stream(data []byte) EC3StreamFunc {
+	return func(_ context.Context, w io.Writer) error {
+		_, err := w.Write(data)
+		return err
+	}
+}
+
+func joinSamples(fragments [][][]byte) []byte {
+	var out []byte
+	for _, fragment := range fragments {
+		for _, sample := range fragment {
+			out = append(out, sample...)
+		}
+	}
+	return out
+}
