+// knownALACQualityFromTraits extracts only explicit, supported numeric
+// evidence. Apple's ordinary "lossless" and "hi-res-lossless" traits prove the
+// format exists, not which sample rate or bit depth a track uses.
+func knownALACQualityFromTraits(traits []string) (sampleRate, bitDepth int) {
+	for _, trait := range traits {
+		lower := strings.ToLower(trait)
+		if !strings.Contains(lower, "lossless") && !strings.Contains(lower, "alac") {
+			continue
+		}
+		parts := strings.FieldsFunc(trait, func(r rune) bool { return r == '-' || r == '_' })
+		for i := 0; i+1 < len(parts); i++ {
+			rate, rateErr := strconv.Atoi(parts[i])
+			depth, depthErr := strconv.Atoi(parts[i+1])
+			if rateErr != nil || depthErr != nil {
+				continue
+			}
+			if rate == 44 || rate == 48 || rate == 88 || rate == 96 || rate == 176 || rate == 192 {
+				rate *= 1000
+			}
+			switch rate {
+			case 44100, 48000, 88200, 96000, 176400, 192000:
+			default:
+				continue
+			}
+			if depth == 16 || depth == 24 {
+				return rate, depth
+			}
+		}
+	}
+	return 0, 0
+}
