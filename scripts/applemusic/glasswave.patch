+// The application token is shared by all catalog calls, not tied to an account.
+// Keep this adapter cache separate from upstream ampapi to simplify upstream sync.
+type glasswaveTokenCache struct {
+	mu      sync.Mutex
+	token   string
+	expires time.Time
+}
+
+var glasswaveApplicationToken glasswaveTokenCache
+
+func (c *glasswaveTokenCache) get(now time.Time, fetch func() (string, error)) (string, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.token != "" && now.Before(c.expires) {
+		return c.token, nil
+	}
+	token, err := fetch()
+	if err != nil {
+		return "", err
+	}
+	// Unknown JWT lifetime gets a short cache; known expiry is never extended.
+	expires := now.Add(15 * time.Minute)
+	parts := strings.Split(token, ".")
+	if len(parts) == 3 {
+		payload, decodeErr := base64.RawURLEncoding.DecodeString(strings.TrimRight(parts[1], "="))
+		var claims struct {
+			Exp int64 `json:"exp"`
+		}
+		if decodeErr == nil && json.Unmarshal(payload, &claims) == nil && claims.Exp > 0 {
+			jwtExpiry := time.Unix(claims.Exp, 0).Add(-time.Minute)
+			if jwtExpiry.Before(expires) {
+				expires = jwtExpiry
+			}
+		}
+	}
+	c.token, c.expires = token, expires
+	return token, nil
+}
+
+func (c *glasswaveTokenCache) invalidate(token string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if token == c.token {
+		c.token, c.expires = "", time.Time{}
+	}
+}
