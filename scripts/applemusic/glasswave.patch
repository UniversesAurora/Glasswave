+		shutdownCtx: context.Background(),
+		pm: playback.NewWithProviderWithoutReaper(alacTestProvider{stream: func(w io.Writer) error {
+			close(started)
+			<-release
+			defer close(finished)
+			_, err := io.WriteString(w, "encoded-alac")
+			return err
+		}}),
+	}
+	sess, err := s.pm.Open(context.Background(), playback.OpenRequest{AssetID: "pending-alac", Storefront: "us"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		releaseOnce.Do(func() { close(release) })
+		select {
+		case <-finished:
+		case <-time.After(2 * time.Second):
+		}
+		s.pm.Release(sess.ID)
+	})
+
+	r := httptest.NewRequest(http.MethodGet, "/audio", nil)
+	r.SetPathValue("id", sess.ID)
+	r.Header.Set("Range", "bytes=0-3")
+	w := httptest.NewRecorder()
+	s.handlePlaybackAudio(w, r)
+
+	if w.Code != http.StatusServiceUnavailable {
+		t.Fatalf("status = %d, want 503 while the first cache is incomplete", w.Code)
+	}
+	if got := w.Header().Get("Retry-After"); got != "1" {
+		t.Fatalf("Retry-After = %q, want 1", got)
+	}
+	for _, key := range []string{"Content-Range", "Accept-Ranges"} {
+		if got := w.Header().Get(key); got != "" {
+			t.Fatalf("%s = %q, must stay unknown before commit", key, got)
