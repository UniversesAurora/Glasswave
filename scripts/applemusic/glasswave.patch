+	session, err := manager.Open(context.Background(), playback.OpenRequest{
+		AssetID:         "i.test",
+		Storefront:      "us",
+		Token:           "developer-token",
+		MUT:             "music-token",
+		PreferAtmos:     true,
+		RequireFullSong: true,
+		Private:         true,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if session.Codec != "mp3" || session.SampleRate != 44100 || session.BitDepth != 0 ||
+		session.BitRate != 192_000 || session.ChannelCount != 2 ||
+		session.Container != "mp3" || session.Extension != "mp3" ||
+		session.CodecMIMEType != "audio/mpeg" || session.DurationMs != seconds {
