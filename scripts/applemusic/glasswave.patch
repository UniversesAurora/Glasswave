+		glasswaveAMPBase:    privateServer.URL,
+		glasswaveHTTPClient: glasswaveAppleHTTPClient,
+		glasswaveGetAccount: func(context.Context) (drm.AccountInfo, error) {
+			return drm.AccountInfo{DevToken: "dev-test"}, nil
+		},
+	}
+	paths := []string{
+		"/v1/catalog/us/search?term=glasswave&types=songs,artists,albums,playlists&limit=5",
+		"/v1/catalog/us/search/suggestions?kinds=terms,topResults",
+		"/v1/catalog/us/artists/159260351/top-songs?l=zh-Hans-CN",
+	}
