+func isNegativeOne(v any) bool {
+	switch value := v.(type) {
+	case float64:
+		return value == -1
+	case json.Number:
+		return value.String() == "-1"
+	case string:
+		return strings.TrimSpace(value) == "-1"
+	case int:
+		return value == -1
+	case int64:
+		return value == -1
+	default:
+		return false
+	}
+}
+
+func validateUploadedAssetURL(raw string) error {
+	u, err := url.Parse(strings.TrimSpace(raw))
+	if err != nil || u.Scheme != "https" || u.Host == "" || u.User != nil ||
+		u.Opaque != "" || u.Fragment != "" {
+		return fmt.Errorf("library asset URL is invalid")
+	}
+	host := strings.ToLower(strings.TrimSuffix(u.Hostname(), "."))
+	if !strings.HasSuffix(host, ".blobstore.apple.com") {
+		return fmt.Errorf("library asset host is not an Apple blobstore")
+	}
+	return nil
+}
+
+func readBounded(r io.Reader, limit int64) ([]byte, error) {
+	body, err := io.ReadAll(io.LimitReader(r, limit+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(body)) > limit {
+		return nil, fmt.Errorf("response body exceeded %d bytes", limit)
+	}
+	return body, nil
+}
+
+type uploadedRangeResponse struct {
+	body  []byte
+	total int64
+}
+
+func (a *uploadedAudioAdapter) fetchUploadedRange(
+	ctx context.Context,
+	rawURL string,
+	start, end int64,
+) (uploadedRangeResponse, error) {
+	if start < 0 || end < start {
+		return uploadedRangeResponse{}, fmt.Errorf("invalid byte range")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, rawURL, nil)
+	if err != nil {
+		return uploadedRangeResponse{}, err
+	}
+	req.Header.Set("Range", fmt.Sprintf("bytes=%d-%d", start, end))
+	resp, err := a.apiClient.Do(req)
+	if err != nil {
+		return uploadedRangeResponse{}, fmt.Errorf("library asset probe failed: %w", sanitizedTransportError(err))
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusPartialContent && resp.StatusCode != http.StatusOK {
+		return uploadedRangeResponse{}, fmt.Errorf("library asset probe HTTP %d", resp.StatusCode)
+	}
+	body, err := readBounded(resp.Body, end-start+1)
+	if err != nil {
+		return uploadedRangeResponse{}, err
+	}
+	total, err := contentRangeTotal(resp.Header.Get("Content-Range"), resp.StatusCode, start, int64(len(body)))
+	if err != nil {
+		if resp.StatusCode == http.StatusPartialContent {
+			return uploadedRangeResponse{}, err
+		}
+		if resp.ContentLength >= 0 {
+			total = resp.ContentLength
+		}
+	}
+	return uploadedRangeResponse{
+		body:  body,
+		total: total,
+	}, nil
+}
+
+func contentRangeTotal(value string, status int, start, got int64) (int64, error) {
+	if status == http.StatusOK {
+		return 0, nil
+	}
+	if !strings.HasPrefix(value, "bytes ") {
+		return 0, fmt.Errorf("library asset response has no Content-Range total")
+	}
+	rangePart, totalPart, ok := strings.Cut(strings.TrimPrefix(value, "bytes "), "/")
+	if !ok || totalPart == "*" {
+		return 0, fmt.Errorf("library asset response has unknown Content-Range total")
+	}
+	fromPart, toPart, ok := strings.Cut(rangePart, "-")
+	if !ok {
+		return 0, fmt.Errorf("library asset response has invalid Content-Range")
+	}
+	from, err1 := strconv.ParseInt(fromPart, 10, 64)
+	to, err2 := strconv.ParseInt(toPart, 10, 64)
+	total, err3 := strconv.ParseInt(totalPart, 10, 64)
+	if err1 != nil || err2 != nil || err3 != nil || from != start || to-from+1 != got ||
+		total <= 0 || total > uploadedAssetSizeLimit {
+		return 0, fmt.Errorf("library asset response has invalid Content-Range")
+	}
+	return total, nil
+}
