+/* ── Android log (liblog.so) — sysv_abi; always emit ERROR/FATAL (prio >= 6) */
+static void _alog_emit(int prio,const char *tag,const char *msg){
+    if(prio < 6 && !_dbg()) return;
+    char b[1024];
+    const char *lvl = prio >= 7 ? "/F" : (prio == 6 ? "/E" : "");
+    int n=snprintf(b,sizeof b,"[alog%s] %s: %s\n", lvl, tag?tag:"", msg?msg:"");
+    if(n>0){ if(n>(int)sizeof b)n=(int)sizeof b; DWORD wr; WriteFile(GetStdHandle(STD_ERROR_HANDLE),b,(DWORD)n,&wr,NULL); }
