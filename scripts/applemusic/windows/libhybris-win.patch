diff --git a/hybris/common/hooks_win32.c b/hybris/common/hooks_win32.c
index 9d993c8..b9cf51b 100644
--- a/hybris/common/hooks_win32.c
+++ b/hybris/common/hooks_win32.c
@@ -56,6 +56,10 @@ static __attribute__((sysv_abi)) int _hybris_win32_pthread_once(pthread_once_t *
 }
 
 /* ── pthread key ─────────────────────────────────────────────────────────────*/
+/* Bionic never issues pthread_key_t == 0 and guest code (including Bionic's
+ * own startup and libc++) may pass an uninitialized 0 key before creation.
+ * Offset guest keys by +1 so 0 is always invalid, preventing collisions with
+ * winpthreads key 0 (which would otherwise corrupt __cxa_get_globals). */
 static __attribute__((sysv_abi)) int _hybris_win32_pthread_key_create(pthread_key_t *key,
                                               void (*destructor)(void *))
 {
@@ -65,18 +69,23 @@ static __attribute__((sysv_abi)) int _hybris_win32_pthread_key_create(pthread_ke
      * argument.  Keep the key usable but do not register an ABI-incompatible
      * host callback; cleanup is deferred until a callback bridge is available. */
     (void)destructor;
-    return pthread_key_create(key, NULL);
+    pthread_key_t host_key = 0;
+    int rc = pthread_key_create(&host_key, NULL);
+    if (rc == 0 && key) *key = host_key + 1;
+    return rc;
 }
 
 static __attribute__((sysv_abi)) int _hybris_win32_pthread_key_delete(pthread_key_t key)
 {
-    return pthread_key_delete(key);
+    if (key == 0) return EINVAL;
+    return pthread_key_delete(key - 1);
 }
 
 static __attribute__((sysv_abi)) int _hybris_win32_pthread_setspecific(pthread_key_t key,
                                               const void *value)
 {
-    return pthread_setspecific(key, value);
+    if (key == 0) return EINVAL;
+    return pthread_setspecific(key - 1, value);
 }
 
 /* ── pthread sched ───────────────────────────────────────────────────────────*/
