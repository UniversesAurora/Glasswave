+func TestGlasswaveAccountUsesNativeTokensAndMapsStorefront(t *testing.T) {
+	var sawDev, sawMusic bool
+	var sawPath bool
+	var mu sync.Mutex
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		sawPath = r.URL.Path == "/v1/me/storefront"
+		sawDev = r.Header.Get("Authorization") == "Bearer dev-test"
+		sawMusic = r.Header.Get("Music-User-Token") == "native-music-token"
+		mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"data":[{"id":"us","type":"storefronts","attributes":{"name":"United States"}}]}`)
+	}))
+	defer srv.Close()
+
+	s := &APIServer{
+		headless:            true,
+		glasswaveAPIBase:    srv.URL,
+		glasswaveHTTPClient: glasswaveAppleHTTPClient,
+		glasswaveGetAccount: func(context.Context) (drm.AccountInfo, error) {
+			return drm.AccountInfo{
+				StorefrontID: "143441",
+				MusicToken:   "native-music-token",
+				DSID:         9000000002,
+			}, nil
+		},
+		glasswaveGetToken: func() (string, error) { return "dev-test", nil },
+		mkMusicToken:      "web-session-token-must-not-win",
+	}
+	r := httptest.NewRequest(http.MethodGet, "/api/v1/glasswave/account", nil)
+	w := httptest.NewRecorder()
+	s.handleGlasswaveAccount(w, r)
+
+	if w.Code != http.StatusOK {
+		t.Fatalf("status = %d; body=%q", w.Code, w.Body.String())
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if !sawPath || !sawDev || !sawMusic {
+		t.Fatalf("request validation failed: path=%v dev=%v music=%v", sawPath, sawDev, sawMusic)
+	}
+	var got glasswaveAccountResponse
+	if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	if !got.SignedIn || got.Storefront != "us" || got.AccountID != "9000000002" ||
+		got.Name != "United States" {
+		t.Fatalf("account response = %+v", got)
+	}
+	var wire map[string]any
+	if err := json.Unmarshal(w.Body.Bytes(), &wire); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := wire["accountId"]; !ok {
+		t.Fatal("account response did not use the accountId JSON contract")
+	}
+	for _, secret := range []string{"native-music-token", "web-session-token-must-not-win", "dev-test"} {
+		if strings.Contains(w.Body.String(), secret) {
+			t.Fatalf("account response exposed credential %q", secret)
+		}
+	}
+}
