+		{
+			{0x0b, 0x77, 0x10, 0x01, 0xaa, 0xbb},
+			{0x0b, 0x77, 0x10, 0x02, 0xcc, 0xdd},
+		},
+		{
+			{0x0b, 0x77, 0x10, 0x03, 0xee, 0xff},
+		},
+	}
+	var fMP4 bytes.Buffer
+	if err := init.Encode(&fMP4); err != nil {
+		t.Fatal(err)
+	}
+	var decodeTime uint64
+	for i, fragmentSamples := range samples {
+		frag, err := mp4.CreateFragment(uint32(i+1), 1)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, data := range fragmentSamples {
+			frag.AddFullSample(mp4.FullSample{
+				Sample: mp4.Sample{
+					Flags: mp4.SyncSampleFlags,
+					Dur:   1536,
+					Size:  uint32(len(data)),
+				},
+				DecodeTime: decodeTime,
+				Data:       data,
+			})
+			decodeTime += 1536
+		}
+		if err := frag.Encode(&fMP4); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var raw bytes.Buffer
+	for _, fragmentSamples := range samples {
+		for _, sample := range fragmentSamples {
+			raw.Write(sample)
+		}
+	}
+	return fMP4.Bytes(), raw.Bytes()
+}
+
+func TestServeStreamingReaderPropagatesErrors(t *testing.T) {
+	t.Run("zero-byte failure returns 502", func(t *testing.T) {
+		cache, err := diskcache.New(t.TempDir())
+		if err != nil {
+			t.Fatal(err)
+		}
+		spw, err := cache.BeginStreamingPut("fail-zero", "alac")
+		if err != nil {
+			t.Fatal(err)
+		}
+		reader := spw.NewReader()
+		defer reader.Close()
+		spw.Discard()
+
+		r := httptest.NewRequest(http.MethodGet, "/audio", nil)
+		w := httptest.NewRecorder()
+		serveStreamingReader(w, r, reader, "audio/mp4", "sess-1", "ALAC")
+		if w.Code != http.StatusBadGateway {
+			t.Fatalf("status = %d, want 502 on pre-first-byte failure", w.Code)
+		}
+	})
+
+	t.Run("partial failure aborts HTTP response instead of clean EOF", func(t *testing.T) {
+		cache, err := diskcache.New(t.TempDir())
+		if err != nil {
+			t.Fatal(err)
+		}
+		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			spw, err := cache.BeginStreamingPut("fail-partial", "alac")
+			if err != nil {
+				http.Error(w, err.Error(), http.StatusInternalServerError)
+				return
+			}
+			reader := spw.NewReader()
+			defer reader.Close()
+			go func() {
+				_, _ = spw.Write([]byte("partial-init-bytes"))
+				time.Sleep(20 * time.Millisecond)
+				spw.Discard()
+			}()
+			serveStreamingReader(w, r, reader, "audio/mp4", "sess-2", "ALAC")
+		}))
+		defer srv.Close()
+
+		resp, err := srv.Client().Get(srv.URL)
+		if err != nil {
+			t.Fatalf("GET: %v", err)
+		}
+		defer resp.Body.Close()
+		if resp.StatusCode != http.StatusOK {
+			t.Fatalf("status = %d, want 200 after first bytes committed", resp.StatusCode)
+		}
+		body, readErr := io.ReadAll(resp.Body)
+		if readErr == nil {
+			t.Fatalf("expected truncated chunked stream error after Discard, got clean EOF with body=%q", string(body))
+		}
+		if string(body) != "partial-init-bytes" {
+			t.Fatalf("partial body = %q, want %q", string(body), "partial-init-bytes")
+		}
+	})
+}
