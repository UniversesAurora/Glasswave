+func TestGlasswaveLyricsDirectUsesExplicitSongID(t *testing.T) {
+	storefront := newLyricsStorefrontServer(t)
+	defer storefront.Close()
+	var calls atomic.Int32
+	s := &APIServer{
+		glasswaveAPIBase:    storefront.URL,
+		glasswaveHTTPClient: glasswaveAppleHTTPClient,
+		glasswaveGetAccount: func(context.Context) (drm.AccountInfo, error) {
+			return drm.AccountInfo{DevToken: "dev-test", MusicToken: "music-test"}, nil
+		},
+		glasswaveGetLyrics: func(_ context.Context, sf, trackID, lyricType, locale, format,
+			devToken, musicToken string) (string, error) {
+			calls.Add(1)
+			if sf != "us" || trackID != "12345" || lyricType != "syllable-lyrics" ||
+				locale != "zh-Hans-CN" || format != "lrc" ||
+				devToken != "dev-test" || musicToken != "music-test" {
+				t.Fatal("direct lyrics arguments were not preserved")
+			}
+			return "[00:01.00]<00:01.00>Hello", nil
+		},
+	}
+	body := `{"mode":"direct","trackId":"12345","trackType":"songs","locale":"zh-Hans-CN"}`
+	w := httptest.NewRecorder()
+	s.handleGlasswaveLyrics(w, httptest.NewRequest(http.MethodPost, "/api/v1/glasswave/lyrics", strings.NewReader(body)))
+	if w.Code != http.StatusOK || calls.Load() != 1 {
+		t.Fatalf("status=%d calls=%d body=%q", w.Code, calls.Load(), w.Body.String())
+	}
+	var response glasswaveLyricsResponse
+	if err := json.Unmarshal(w.Body.Bytes(), &response); err != nil {
+		t.Fatal(err)
+	}
+	if len(response.Results) != 1 || response.Results[0].Confidence != 100 ||
+		response.Results[0].LRC == "" {
+		t.Fatalf("unexpected direct lyrics response: %+v", response)
+	}
+	for _, secret := range []string{"dev-test", "music-test"} {
+		if strings.Contains(w.Body.String(), secret) {
+			t.Fatal("lyrics response exposed credentials")
+		}
+	}
+}
