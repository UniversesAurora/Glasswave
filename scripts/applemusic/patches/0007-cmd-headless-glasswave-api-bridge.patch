+func TestGlasswaveAppleProxyDoesNotFollowRedirects(t *testing.T) {
+	var redirectedRequests atomic.Int32
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		redirectedRequests.Add(1)
+		_, _ = io.WriteString(w, `{"redirected":true}`)
+	}))
+	defer target.Close()
+	origin := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Redirect(w, r, target.URL+"/v1/me/storefront", http.StatusTemporaryRedirect)
+	}))
+	defer origin.Close()
+
+	s := &APIServer{
+		glasswaveAMPBase:    origin.URL,
+		glasswaveHTTPClient: glasswaveAppleHTTPClient,
+		glasswaveGetAccount: func(context.Context) (drm.AccountInfo, error) {
+			return drm.AccountInfo{DevToken: "dev", MusicToken: "music"}, nil
+		},
+	}
+	body := `{"method":"GET","path":"/v1/me/storefront"}`
+	w := httptest.NewRecorder()
+	s.handleGlasswaveApple(w, httptest.NewRequest(http.MethodPost, "/api/v1/glasswave/apple", strings.NewReader(body)))
+	if w.Code != http.StatusTemporaryRedirect {
+		t.Fatalf("status = %d, want upstream 307", w.Code)
+	}
+	if got := redirectedRequests.Load(); got != 0 {
+		t.Fatalf("client followed redirect %d time(s)", got)
+	}
+	if loc := w.Header().Get("Location"); loc != "" {
+		t.Fatalf("proxy forwarded redirect target %q", loc)
+	}
+}
