+package main
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"engine/core/diskcache"
+	"engine/core/media"
+	"engine/core/pipeline"
+	"engine/core/playback"
+)
+
+type uploadedLayoutProvider struct{ calls *int }
+
+func (p uploadedLayoutProvider) Open(context.Context, media.OpenRequest) (*media.Session, error) {
+	return &media.Session{Kind: "song", Tracks: []media.Track{{Kind: pipeline.KindAudio, Codec: pipeline.CodecAAC, SourceVersion: "uploaded-mp4-faststart-v1", Open: func(context.Context) (*pipeline.Stream, error) {
+		return &pipeline.Stream{Kind: pipeline.KindAudio, Codec: pipeline.CodecAAC, Source: mvAudioTestSource(func(w io.Writer) error { *p.calls++; _, err := io.WriteString(w, "normalized-front-index"); return err })}, nil
+	}}}}, nil
+}
+
+func TestUploadedLayoutMissesOldTailCacheWithoutClearingOtherAudio(t *testing.T) {
+	cache, err := diskcache.New(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	put := func(id, quality, body string) {
+		w, err := cache.BeginPut(id, quality)
+		if err != nil || w == nil {
+			t.Fatal("Cache fixture failed")
+		}
+		if _, err := io.WriteString(w, body); err != nil {
+			t.Fatal(err)
+		}
+		if err := w.Commit(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	put("i.uploaded-layout", "aac", "old-tail-index")
+	put("unrelated-alac", "alac", "untouched-lossless")
+	calls := 0
+	s := &APIServer{headless: true, diskCache: cache, alac: newALACGate(), shutdownCtx: context.Background(), pm: playback.NewWithProviderWithoutReaper(uploadedLayoutProvider{&calls})}
+	session, err := s.pm.Open(context.Background(), playback.OpenRequest{AssetID: "i.uploaded-layout", Storefront: "us"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.pm.Release(session.ID)
+	for i := 0; i < 2; i++ {
+		r := httptest.NewRequest(http.MethodGet, "/audio", nil)
+		r.SetPathValue("id", session.ID)
+		w := httptest.NewRecorder()
+		s.handlePlaybackAudio(w, r)
+		if w.Code != 200 || w.Body.String() != "normalized-front-index" {
+			t.Fatalf("Read old tail-index bytes after layout generation changed: %q", w.Body.String())
+		}
+	}
+	if calls != 1 {
+		t.Fatalf("Normalized generation did not reuse its completed cache: streams=%d", calls)
+	}
+	for _, entry := range [][3]string{{"i.uploaded-layout", "aac", "old-tail-index"}, {"unrelated-alac", "alac", "untouched-lossless"}} {
+		f, ok := cache.Get(entry[0], entry[1])
+		if !ok {
+			t.Fatal("An unaffected cache entry was cleared")
+		}
+		body, err := io.ReadAll(f)
+		f.Close()
+		if err != nil || string(body) != entry[2] {
+			t.Fatal("An unaffected cache entry changed")
+		}
+	}
+}
