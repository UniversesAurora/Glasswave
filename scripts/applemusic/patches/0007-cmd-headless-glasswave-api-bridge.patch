@@ -0,0 +1,56 @@
+package main
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"strings"
+	"sync"
+	"time"
+)
+
+// The application token is shared by all catalog calls, not tied to an account.
+// Keep this adapter cache separate from upstream ampapi to simplify upstream sync.
+type glasswaveTokenCache struct {
+	mu      sync.Mutex
+	token   string
+	expires time.Time
+}
+
+var glasswaveApplicationToken glasswaveTokenCache
+
+func (c *glasswaveTokenCache) get(now time.Time, fetch func() (string, error)) (string, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.token != "" && now.Before(c.expires) {
+		return c.token, nil
+	}
+	token, err := fetch()
+	if err != nil {
+		return "", err
+	}
+	// Unknown JWT lifetime gets a short cache; known expiry is never extended.
+	expires := now.Add(15 * time.Minute)
+	parts := strings.Split(token, ".")
+	if len(parts) == 3 {
+		payload, decodeErr := base64.RawURLEncoding.DecodeString(strings.TrimRight(parts[1], "="))
+		var claims struct {
+			Exp int64 `json:"exp"`
+		}
+		if decodeErr == nil && json.Unmarshal(payload, &claims) == nil && claims.Exp > 0 {
+			jwtExpiry := time.Unix(claims.Exp, 0).Add(-time.Minute)
+			if jwtExpiry.Before(expires) {
+				expires = jwtExpiry
+			}
+		}
+	}
+	c.token, c.expires = token, expires
+	return token, nil
+}
+
+func (c *glasswaveTokenCache) invalidate(token string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if token == c.token {
+		c.token, c.expires = "", time.Time{}
+	}
+}
diff --git a/engine/cmd/glasswave_token_cache_test.go b/engine/cmd/glasswave_token_cache_test.go
new file mode 100644
index 0000000..88d03ba
--- /dev/null
+++ b/engine/cmd/glasswave_token_cache_test.go
@@ -0,0 +1,58 @@
+package main
+
+import (
+	"encoding/base64"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestGlasswaveTokenCacheCoalescesConcurrentCalls(t *testing.T) {
+	var cache glasswaveTokenCache
+	var calls atomic.Int32
+	now := time.Now()
+	fetch := func() (string, error) { calls.Add(1); return "fixture", nil }
+	var workers sync.WaitGroup
+	for range 20 {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			if _, err := cache.get(now, fetch); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	workers.Wait()
+	if calls.Load() != 1 {
+		t.Fatalf("fetch count = %d, want 1", calls.Load())
+	}
+	cache.invalidate("old-unrelated-token")
+	_, _ = cache.get(now, fetch)
+	if calls.Load() != 1 {
+		t.Fatal("an unrelated failure invalidated the current token")
+	}
+	cache.invalidate("fixture")
+	_, _ = cache.get(now, fetch)
+	if calls.Load() != 2 {
+		t.Fatal("invalidation did not refresh the token")
+	}
+}
+
+func TestGlasswaveTokenCacheHonorsJWTExpiry(t *testing.T) {
+	var cache glasswaveTokenCache
+	now := time.Unix(1_800_000_000, 0)
+	payload := base64.RawURLEncoding.EncodeToString([]byte(fmt.Sprintf(`{"exp":%d}`, now.Add(3*time.Minute).Unix())))
+	calls := 0
+	fetch := func() (string, error) { calls++; return "eyJ." + payload + ".fixture", nil }
+	_, _ = cache.get(now, fetch)
+	_, _ = cache.get(now.Add(time.Minute), fetch)
+	if calls != 1 {
+		t.Fatal("valid token was fetched again")
+	}
+	_, _ = cache.get(now.Add(2*time.Minute), fetch)
+	if calls != 2 {
+		t.Fatal("token was cached past its safe JWT expiry")
+	}
+}
