+func (s *APIServer) handleGlasswaveApple(w http.ResponseWriter, r *http.Request) {
+	r.Body = http.MaxBytesReader(w, r.Body, glasswaveAppleRequestLimit)
+	defer r.Body.Close()
+
+	var req glasswaveAppleRequest
+	dec := json.NewDecoder(r.Body)
+	if err := dec.Decode(&req); err != nil {
+		var maxErr *http.MaxBytesError
+		if errors.As(err, &maxErr) {
+			writeGlasswaveError(w, http.StatusRequestEntityTooLarge, "request body too large")
+		} else {
+			writeGlasswaveError(w, http.StatusBadRequest, "invalid request body")
+		}
+		return
+	}
+	var extra any
+	if err := dec.Decode(&extra); !errors.Is(err, io.EOF) {
+		writeGlasswaveError(w, http.StatusBadRequest, "invalid request body")
+		return
+	}
+
+	method := strings.ToUpper(strings.TrimSpace(req.Method))
+	if !glasswaveMethodAllowed(method) {
+		writeGlasswaveError(w, http.StatusBadRequest, "unsupported method")
+		return
+	}
+	target, err := s.validateGlasswaveApplePath(method, req.Path)
+	if err != nil {
+		writeGlasswaveError(w, http.StatusBadRequest, err.Error())
+		return
+	}
+	if len(req.Body) > glasswaveAppleRequestLimit {
+		writeGlasswaveError(w, http.StatusRequestEntityTooLarge, "request body too large")
+		return
+	}
+
+	account, _ := s.glasswaveNativeAccount(r.Context())
+	devToken := strings.TrimPrefix(strings.TrimSpace(account.DevToken), "Bearer ")
+	if devToken == "" {
+		devToken, err = s.glasswaveDeveloperToken()
+		if err != nil {
+			writeGlasswaveError(w, http.StatusBadGateway, "Apple developer token unavailable")
+			return
+		}
+	}
+	musicToken := strings.TrimSpace(account.MusicToken)
+	if musicToken == "" {
+		musicToken = strings.TrimSpace(s.musicUserToken())
+	}
+	if target.RequiresMusicToken && musicToken == "" {
+		writeGlasswaveError(w, http.StatusUnauthorized, "Apple Music account is not signed in")
+		return
+	}
+
+	var body io.Reader = http.NoBody
+	if len(req.Body) > 0 && !bytes.Equal(bytes.TrimSpace(req.Body), []byte("null")) {
+		body = bytes.NewReader(req.Body)
+	}
+	upstream, err := http.NewRequestWithContext(r.Context(), method, target.URL, body)
+	if err != nil {
+		writeGlasswaveError(w, http.StatusBadRequest, "invalid Apple API request")
+		return
+	}
+	upstream.Header.Set("Authorization", "Bearer "+devToken)
+	upstream.Header.Set("User-Agent", glasswaveAppleUserAgent)
+	upstream.Header.Set("Origin", "https://music.apple.com")
+	upstream.Header.Set("Accept", "application/json")
+	if len(req.Body) > 0 && body != http.NoBody {
+		upstream.Header.Set("Content-Type", "application/json")
+	}
+	if musicToken != "" {
+		// amp-api accepts the web header while api.music.apple.com documents
+		// Music-User-Token. Sending both names keeps the fixed upstream usable
+		// across both Apple API surfaces.
+		upstream.Header.Set("Music-User-Token", musicToken)
+		upstream.Header.Set("x-apple-music-user-token", musicToken)
+	}
+	s.copyGlasswaveAppleResponse(w, upstream, devToken, musicToken)
+}
+
+type validatedGlasswaveAppleTarget struct {
+	URL                string
+	RequiresMusicToken bool
+}
+
+func (s *APIServer) validateGlasswaveApplePath(method, raw string) (validatedGlasswaveAppleTarget, error) {
+	raw = strings.TrimSpace(raw)
+	if raw == "" || len(raw) > 8192 || strings.HasPrefix(raw, "//") || strings.Contains(raw, "#") {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("invalid Apple API path")
+	}
+	u, err := url.ParseRequestURI(raw)
+	if err != nil || u.IsAbs() || u.Scheme != "" || u.Host != "" || u.User != nil || u.Fragment != "" {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("invalid Apple API path")
+	}
+	if !strings.HasPrefix(u.Path, "/") || strings.ContainsAny(u.Path, "\\\x00") || pathpkg.Clean(u.Path) != u.Path {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("invalid Apple API path")
+	}
+	if !validGlasswavePathEncoding(u.EscapedPath()) {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("invalid Apple API path")
+	}
+	privateCatalogExtension := glasswaveCatalogRequiresWebAPI(u)
+	requiresMusicToken := strings.HasPrefix(u.Path, "/v1/me/") || privateCatalogExtension
+	if !requiresMusicToken && !strings.HasPrefix(u.Path, "/v1/catalog/") {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("Apple API path is not allowed")
+	}
+	if method != http.MethodGet && strings.HasPrefix(u.Path, "/v1/catalog/") {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("catalog API only supports reads")
+	}
+
+	base := s.glasswaveProxyBase()
+	if strings.HasPrefix(u.Path, "/v1/catalog/") && !privateCatalogExtension {
+		base = s.glasswaveOfficialBase()
+	}
+	b, err := url.Parse(base)
+	if err != nil || b.Host == "" || (b.Scheme != "https" && b.Scheme != "http") {
+		return validatedGlasswaveAppleTarget{}, fmt.Errorf("Apple API endpoint is unavailable")
+	}
+	target := *b
+	target.Path = u.Path
+	target.RawPath = u.RawPath
+	target.RawQuery = u.RawQuery
+	target.Fragment = ""
+	return validatedGlasswaveAppleTarget{
+		URL:                target.String(),
+		RequiresMusicToken: requiresMusicToken,
+	}, nil
+}
+
+func glasswaveCatalogRequiresWebAPI(target *url.URL) bool {
+	for name, values := range target.Query() {
+		lowerName := strings.ToLower(name)
+		for _, value := range values {
+			lowerValue := strings.ToLower(value)
+			if strings.HasPrefix(lowerName, "extend") &&
+				(strings.Contains(lowerValue, "infavorites") || strings.Contains(lowerValue, "library-")) {
+				return true
+			}
+			if lowerName == "relate" &&
+				(strings.Contains(lowerValue, "library") || strings.Contains(lowerValue, "favorite")) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func validGlasswavePathEncoding(escapedPath string) bool {
+	candidate := escapedPath
+	for range 3 {
+		decoded, err := url.PathUnescape(candidate)
+		if err != nil || strings.ContainsAny(decoded, "\\\x00") || pathpkg.Clean(decoded) != decoded {
+			return false
+		}
+		if decoded == candidate {
+			return true
+		}
+		candidate = decoded
+	}
+	return false
+}
