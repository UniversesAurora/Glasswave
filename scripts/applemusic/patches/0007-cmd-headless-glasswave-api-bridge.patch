+		MaxIdleConnsPerHost: 10,
+		IdleConnTimeout:     30 * time.Second,
+	},
+	// Apple API responses occasionally redirect. Returning the redirect to the
+	// caller preserves its status without letting an upstream response change
+	// the fixed host or carry auth headers to a new destination.
+	CheckRedirect: func(*http.Request, []*http.Request) error {
+		return http.ErrUseLastResponse
+	},
+}
