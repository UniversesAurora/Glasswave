+
+func (s *APIServer) copyGlasswaveAppleResponse(w http.ResponseWriter, req *http.Request, secrets ...string) {
+	resp, err := s.doGlasswaveAppleRequest(req)
+	if err != nil {
+		writeGlasswaveError(w, http.StatusBadGateway, "Apple Music API request failed")
+		return
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, glasswaveAppleResponseLimit+1))
+	if err != nil {
+		writeGlasswaveError(w, http.StatusBadGateway, "failed to read Apple Music API response")
+		return
+	}
+	if len(body) > glasswaveAppleResponseLimit {
+		writeGlasswaveError(w, http.StatusBadGateway, "Apple Music API response too large")
+		return
+	}
+	secrets = append(secrets, strings.TrimPrefix(req.Header.Get("Authorization"), "Bearer "))
+	for _, secret := range secrets {
+		if secret != "" {
+			body = bytes.ReplaceAll(body, []byte(secret), []byte("[redacted]"))
+		}
+	}
+	contentType := resp.Header.Get("Content-Type")
+	if contentType == "" {
+		contentType = "application/json"
+	}
+	w.Header().Set("Content-Type", contentType)
+	w.Header().Set("Cache-Control", "no-store")
+	w.WriteHeader(resp.StatusCode)
+	_, _ = w.Write(body)
+}
+
+func (s *APIServer) handleGlasswaveAccount(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Cache-Control", "no-store")
+	accountBefore, err := s.glasswaveNativeAccount(r.Context())
+	if err != nil {
+		if s.session == nil || !s.session.HasSession() {
+			writeGlasswaveAccount(w, http.StatusOK, glasswaveAccountResponse{SignedIn: false})
+		} else {
+			writeGlasswaveError(w, http.StatusServiceUnavailable, "Apple account is temporarily unavailable")
+		}
+		return
+	}
+	musicToken := strings.TrimSpace(accountBefore.MusicToken)
+	if musicToken == "" {
+		musicToken = strings.TrimSpace(s.musicUserToken())
+	}
+	if musicToken == "" {
+		writeGlasswaveAccount(w, http.StatusOK, glasswaveAccountResponse{SignedIn: false})
+		return
+	}
+	if accountBefore.DSID <= 0 {
+		writeGlasswaveError(w, http.StatusServiceUnavailable, "Apple account identity is temporarily unavailable")
+		return
+	}
+	devToken := strings.TrimPrefix(strings.TrimSpace(accountBefore.DevToken), "Bearer ")
+	if devToken == "" {
+		devToken, err = s.glasswaveDeveloperToken()
+		if err != nil {
+			writeGlasswaveError(w, http.StatusBadGateway, "Apple developer token unavailable")
+			return
+		}
+	}
+
+	storefront, err := s.fetchGlasswaveStorefront(r.Context(), devToken, musicToken, accountBefore.StorefrontID)
+	if err != nil {
+		var statusErr *glasswaveAppleStatusError
+		if errors.As(err, &statusErr) && (statusErr.StatusCode == http.StatusUnauthorized || statusErr.StatusCode == http.StatusForbidden) {
+			writeGlasswaveAccount(w, http.StatusOK, glasswaveAccountResponse{SignedIn: false})
+			return
+		}
+		writeGlasswaveError(w, http.StatusBadGateway, "Apple account validation failed")
+		return
+	}
+	accountAfter, err := s.glasswaveNativeAccount(r.Context())
+	if err != nil || accountAfter.DSID <= 0 {
+		writeGlasswaveError(w, http.StatusServiceUnavailable, "Apple account identity is temporarily unavailable")
+		return
+	}
+	if accountBefore.DSID != accountAfter.DSID {
+		writeGlasswaveError(w, http.StatusServiceUnavailable, "Apple account changed while it was being validated")
+		return
+	}
+	writeGlasswaveAccount(w, http.StatusOK, glasswaveAccountResponse{
+		SignedIn:   true,
+		Storefront: storefront.ID,
+		AccountID:  strconv.FormatInt(accountAfter.DSID, 10),
+		Name:       storefront.Name,
+	})
+}
+
+func writeGlasswaveAccount(w http.ResponseWriter, status int, response glasswaveAccountResponse) {
+	w.Header().Set("Cache-Control", "no-store")
+	writeJSON(w, status, response)
+}
+
+func (s *APIServer) glasswaveNativeAccount(ctx context.Context) (drm.AccountInfo, error) {
+	if s.glasswaveGetAccount != nil {
+		return s.glasswaveGetAccount(ctx)
+	}
+	if s.dm == nil {
+		return drm.AccountInfo{}, drm.ErrNotAuthenticated
+	}
+	return s.dm.GetAccount(ctx)
+}
+
+func (s *APIServer) glasswaveDeveloperToken() (string, error) {
+	if s.glasswaveGetToken != nil {
+		return s.glasswaveGetToken()
+	}
+	return glasswaveApplicationToken.get(time.Now(), ampapi.GetToken)
+}
+
+func (s *APIServer) doGlasswaveAppleRequest(req *http.Request) (*http.Response, error) {
+	response, err := s.glasswaveClient().Do(req)
+	if err != nil || response.StatusCode != http.StatusUnauthorized {
+		return response, err
+	}
+	used := strings.TrimPrefix(req.Header.Get("Authorization"), "Bearer ")
+	glasswaveApplicationToken.invalidate(used)
+	if req.Method != http.MethodGet {
+		return response, nil
+	}
+	fresh, refreshErr := s.glasswaveDeveloperToken()
+	if refreshErr != nil || fresh == used || (req.Body != nil && req.Body != http.NoBody && req.GetBody == nil) {
+		return response, nil
+	}
+	retry := req.Clone(req.Context())
+	if req.GetBody != nil {
+		retry.Body, refreshErr = req.GetBody()
+		if refreshErr != nil {
+			return response, nil
+		}
+	}
+	response.Body.Close()
+	retry.Header.Set("Authorization", "Bearer "+fresh)
+	// Also retain the current value for response redaction; it is never logged.
+	req.Header.Set("Authorization", "Bearer "+fresh)
+	return s.glasswaveClient().Do(retry)
+}
+
+func (s *APIServer) fetchGlasswaveStorefront(ctx context.Context, devToken, musicToken, nativeStorefront string) (glasswaveStorefront, error) {
+	base, err := url.Parse(s.glasswaveOfficialBase())
+	if err != nil || base.Host == "" {
+		return glasswaveStorefront{}, fmt.Errorf("Apple API endpoint is unavailable")
+	}
+	target := *base
+	target.Path = "/v1/me/storefront"
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, target.String(), nil)
+	if err != nil {
+		return glasswaveStorefront{}, err
+	}
+	req.Header.Set("Authorization", "Bearer "+devToken)
+	req.Header.Set("Music-User-Token", musicToken)
+	req.Header.Set("x-apple-music-user-token", musicToken)
+	req.Header.Set("User-Agent", glasswaveAppleUserAgent)
+	req.Header.Set("Origin", "https://music.apple.com")
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := s.doGlasswaveAppleRequest(req)
+	if err != nil {
+		return glasswaveStorefront{}, err
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20+1))
+	if err != nil {
+		return glasswaveStorefront{}, err
+	}
+	if len(body) > 1<<20 {
+		return glasswaveStorefront{}, fmt.Errorf("storefront response too large")
+	}
+	if resp.StatusCode != http.StatusOK {
+		return glasswaveStorefront{}, &glasswaveAppleStatusError{StatusCode: resp.StatusCode}
+	}
+
+	var decoded struct {
+		Data []struct {
+			ID         string `json:"id"`
+			Attributes struct {
+				Name string `json:"name"`
+			} `json:"attributes"`
+		} `json:"data"`
+	}
+	if err := json.Unmarshal(body, &decoded); err != nil || len(decoded.Data) == 0 {
+		return glasswaveStorefront{}, fmt.Errorf("invalid storefront response")
+	}
+	id := strings.ToLower(strings.TrimSpace(decoded.Data[0].ID))
+	if !isTwoLetterStorefront(id) {
+		id = strings.ToLower(strings.TrimSpace(nativeStorefront))
+	}
+	if !isTwoLetterStorefront(id) {
+		return glasswaveStorefront{}, fmt.Errorf("Apple returned an invalid storefront")
+	}
+	return glasswaveStorefront{
+		ID:   id,
+		Name: strings.TrimSpace(decoded.Data[0].Attributes.Name),
+	}, nil
+}
+
+func isTwoLetterStorefront(s string) bool {
+	if len(s) != 2 {
+		return false
+	}
+	for _, r := range s {
+		if (r < 'a' || r > 'z') && (r < 'A' || r > 'Z') {
+			return false
+		}
+	}
+	return true
+}
+
+type glasswavePlaybackCredentials struct {
+	Token      string
+	MusicToken string
+	Storefront string
+}
+
+// resolveGlasswavePlaybackCredentials fills omitted playback credentials from
+// the native account first. The caller's explicit values remain authoritative.
+// A storefront is never defaulted to "us": it is taken from a validated
+// /v1/me/storefront response when neither the request nor cached session has a
+// usable two-letter code.
+func (s *APIServer) resolveGlasswavePlaybackCredentials(ctx context.Context, token, musicToken, storefront string) (glasswavePlaybackCredentials, error) {
+	out := glasswavePlaybackCredentials{
+		Token:      strings.TrimPrefix(strings.TrimSpace(token), "Bearer "),
+		MusicToken: strings.TrimSpace(musicToken),
+		Storefront: strings.ToLower(strings.TrimSpace(storefront)),
+	}
+
+	var account drm.AccountInfo
+	if out.Token == "" || out.MusicToken == "" || !isTwoLetterStorefront(out.Storefront) {
+		account, _ = s.glasswaveNativeAccount(ctx)
+		if out.Token == "" {
+			out.Token = strings.TrimPrefix(strings.TrimSpace(account.DevToken), "Bearer ")
+		}
+		if out.MusicToken == "" {
+			out.MusicToken = strings.TrimSpace(account.MusicToken)
+		}
+		if !isTwoLetterStorefront(out.Storefront) {
+			nativeSF := strings.ToLower(strings.TrimSpace(drm.NormalizeStorefrontID(account.StorefrontID)))
+			if isTwoLetterStorefront(nativeSF) {
+				out.Storefront = nativeSF
+			}
+		}
+	}
+	if out.Token == "" {
+		var err error
+		out.Token, err = s.glasswaveDeveloperToken()
+		if err != nil {
+			return glasswavePlaybackCredentials{}, fmt.Errorf("Apple developer token unavailable")
+		}
+	}
+	if out.MusicToken == "" {
+		out.MusicToken = strings.TrimSpace(s.musicUserToken())
+	}
+	if out.Token == "" {
+		return glasswavePlaybackCredentials{}, fmt.Errorf("Apple developer token unavailable")
+	}
+	if out.MusicToken == "" {
+		return glasswavePlaybackCredentials{}, fmt.Errorf("Apple Music account is not signed in")
+	}
+	if !isTwoLetterStorefront(out.Storefront) {
+		cached := strings.ToLower(strings.TrimSpace(s.storefront()))
+		if isTwoLetterStorefront(cached) {
+			out.Storefront = cached
+		}
+	}
+	if !isTwoLetterStorefront(out.Storefront) {
+		resolved, err := s.fetchGlasswaveStorefront(ctx, out.Token, out.MusicToken, account.StorefrontID)
+		if err != nil {
+			return glasswavePlaybackCredentials{}, fmt.Errorf("Apple Music storefront validation failed")
+		}
+		out.Storefront = resolved.ID
+	}
+	return out, nil
+}
+
+func glasswaveMethodAllowed(method string) bool {
+	switch method {
+	case http.MethodGet, http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete:
+		return true
+	default:
+		return false
+	}
+}
+
+func writeGlasswaveError(w http.ResponseWriter, status int, message string) {
+	writeJSON(w, status, map[string]string{"error": message})
+}
