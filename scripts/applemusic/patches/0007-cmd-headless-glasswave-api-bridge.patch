+				t.Error("public search carried an account token")
+			}
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"topResults":{"data":[
+				{"id":"200","type":"songs","attributes":{"name":"Song Title","artistName":"Artist","albumName":"Album","durationInMillis":180000}},
+				{"id":"201","type":"songs","attributes":{"name":"Other","artistName":"Different","albumName":"Elsewhere","durationInMillis":100000}}
+			]}}`)
+		default:
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}))
+	defer publicAPI.Close()
+
+	var lyricTrack string
+	s := &APIServer{
+		glasswaveAPIBase:    publicAPI.URL,
+		glasswaveHTTPClient: glasswaveAppleHTTPClient,
+		glasswaveGetAccount: func(context.Context) (drm.AccountInfo, error) {
+			return drm.AccountInfo{DevToken: "dev-test", MusicToken: "music-test"}, nil
+		},
+		glasswaveGetLyrics: func(_ context.Context, _ string, trackID, _ string, _ string,
+			_ string, _ string, _ string) (string, error) {
+			lyricTrack = trackID
+			return "[00:01.00]Matched", nil
+		},
+	}
+	body := `{"mode":"search","title":"Song Title","artist":"Artist","album":"Album",
+		"locale":"en-US","durationMs":181000}`
+	w := lyricsRequest(s, body)
+	if w.Code != http.StatusOK || searchRequests.Load() != 1 || lyricTrack != "200" {
+		t.Fatalf("status=%d searches=%d track=%q body=%q",
+			w.Code, searchRequests.Load(), lyricTrack, w.Body.String())
+	}
