+	if err := json.Unmarshal(w.Body.Bytes(), &response); err != nil || len(response.Results) != 1 {
+		t.Fatal("search did not produce one matched lyric result")
+	}
+	if response.Results[0].Confidence < 50 || response.Results[0].Title != "Song Title" {
+		t.Fatalf("unexpected confidence or metadata: %+v", response.Results[0])
