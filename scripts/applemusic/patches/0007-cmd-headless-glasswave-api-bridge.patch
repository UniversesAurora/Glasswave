+func TestGlasswaveAppleProxyUsesNativeAuthAndReturnsStandardJSON(t *testing.T) {
+	var gotMethod, gotPath, gotBody string
+	var gotNativeAuth bool
+	var mu sync.Mutex
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		gotMethod = r.Method
+		gotPath = r.URL.RequestURI()
+		body, _ := io.ReadAll(r.Body)
+		gotBody = string(body)
+		gotNativeAuth = r.Header.Get("Authorization") == "Bearer dev-test" &&
+			r.Header.Get("Music-User-Token") == "native-music-token"
+		mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusCreated)
+		_, _ = io.WriteString(w, `{"data":[{"id":"library-item","type":"library-songs"}],"echo":["dev-test","native-music-token"]}`)
+	}))
+	defer srv.Close()
+
+	s := &APIServer{
+		glasswaveAMPBase:    srv.URL,
+		glasswaveHTTPClient: glasswaveAppleHTTPClient,
+		glasswaveGetAccount: func(context.Context) (drm.AccountInfo, error) {
+			return drm.AccountInfo{DevToken: "dev-test", MusicToken: "native-music-token"}, nil
+		},
+	}
+	payload := `{"method":"POST","path":"/v1/me/library?l=en-US","body":{"ids":["1"]}}`
+	r := httptest.NewRequest(http.MethodPost, "/api/v1/glasswave/apple", strings.NewReader(payload))
+	w := httptest.NewRecorder()
+	s.handleGlasswaveApple(w, r)
+
+	if w.Code != http.StatusCreated {
+		t.Fatalf("status = %d; body=%q", w.Code, w.Body.String())
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if gotMethod != http.MethodPost || gotPath != "/v1/me/library?l=en-US" || gotBody != `{"ids":["1"]}` {
+		t.Fatalf("upstream request = method %q path %q body %q", gotMethod, gotPath, gotBody)
+	}
+	if !gotNativeAuth {
+		t.Fatal("proxy did not use native account tokens")
+	}
+	if got := w.Body.String(); got != `{"data":[{"id":"library-item","type":"library-songs"}],"echo":["[redacted]","[redacted]"]}` {
+		t.Fatalf("upstream JSON changed: %q", got)
+	}
+	if strings.Contains(w.Body.String(), "dev-test") || strings.Contains(w.Body.String(), "native-music-token") {
+		t.Fatal("proxy response exposed credentials")
+	}
+}
