+func TestParseALACConfigs_BothSampleEntryEncodings(t *testing.T) {
+	t.Parallel()
+
+	innerPayload := make([]byte, 28)
+	binary.BigEndian.PutUint32(innerPayload[4:8], 4096)
+	innerPayload[9] = 24
+	innerPayload[13] = 2
+	binary.BigEndian.PutUint32(innerPayload[16:20], 24580)
+	binary.BigEndian.PutUint32(innerPayload[24:28], 48000)
+
+	innerBox, err := mp4.DecodeBox(0, bytes.NewReader(makeBox("alac", innerPayload)))
+	if err != nil {
+		t.Fatalf("DecodeBox inner alac: %v", err)
+	}
+
+	// Case 1: decrypted CBCS init where outer entry is *mp4.AudioSampleEntryBox("alac").
+	ase := mp4.NewAudioSampleEntryBox("alac")
+	ase.ChannelCount = 2
+	ase.SampleSize = 16
+	ase.SampleRate = 48000
+	ase.AddChild(innerBox)
+
+	init1 := mp4.NewMP4Init()
+	moov1 := mp4.NewMoovBox()
+	trak1 := mp4.CreateEmptyTrak(1, 48000, "soun", "und")
+	trak1.Mdia.Minf.Stbl.Stsd.AddChild(ase)
+	moov1.AddChild(trak1)
+	init1.AddChild(mp4.CreateFtyp())
+	init1.AddChild(moov1)
+
+	cfgs1 := ParseALACConfigs(init1)
+	want := ALACConfig{FrameLength: 4096, BitDepth: 24, NumChannels: 2}
+	if cfgs1[1] != want {
+		t.Fatalf("AudioSampleEntryBox config = %+v, want %+v", cfgs1[1], want)
+	}
+
+	// Case 2: round-trip through encode/decode so outer "alac" parses as *mp4.UnknownBox.
+	var wire bytes.Buffer
+	if err := init1.Encode(&wire); err != nil {
+		t.Fatalf("encode init: %v", err)
+	}
+	init2, _, err := ReadInitSegment(&wire)
+	if err != nil {
+		t.Fatalf("ReadInitSegment: %v", err)
+	}
+	cfgs2 := ParseALACConfigs(init2)
+	if cfgs2[1] != want {
+		t.Fatalf("UnknownBox round-trip config = %+v, want %+v", cfgs2[1], want)
+	}
+}
