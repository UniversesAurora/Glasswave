+func TestRepairALACFragment_MultiTrun(t *testing.T) {
+	t.Parallel()
+	cfg := ALACConfig{FrameLength: 4096, BitDepth: 24, NumChannels: 2}
+	wave := func(s, ch int) int64 {
+		return int64((s%64)*1000 - 30000 + ch*5000)
+	}
+
+	compPkt := make([]byte, 128)
+	writeBits(compPkt, 0, 3, 1) // compressed (bit 22 == 0)
+	badEsc := buildEscapePacket(cfg, 4096, false, wave)
+	copy(badEsc[24576:24580], []byte{0x10, 0x60, 0x00, 0x00})
+
+	frag := mp4.NewFragment()
+	moof := &mp4.MoofBox{}
+	mfhd := mp4.CreateMfhd(1)
+	moof.AddChild(mfhd)
+	traf := &mp4.TrafBox{}
+	tfhd := mp4.CreateTfhd(1)
+	traf.AddChild(tfhd)
+
+	trun1 := mp4.CreateTrun(0)
+	trun1.Flags = mp4.TrunDataOffsetPresentFlag | mp4.TrunSampleSizePresentFlag
+	trun1.Samples = []mp4.Sample{{Size: uint32(len(compPkt))}}
+	traf.AddChild(trun1)
+
+	trun2 := mp4.CreateTrun(1)
+	trun2.Flags = mp4.TrunDataOffsetPresentFlag | mp4.TrunSampleSizePresentFlag
+	trun2.Samples = []mp4.Sample{{Size: uint32(len(badEsc))}}
+	traf.AddChild(trun2)
+
+	moof.AddChild(traf)
+	frag.AddChild(moof)
+
+	mdat := &mp4.MdatBox{}
+	mdat.Data = append(append([]byte(nil), compPkt...), badEsc...)
+	frag.AddChild(mdat)
+
+	moofSize := int32(moof.Size())
+	trun1.DataOffset = moofSize + 8
+	trun2.DataOffset = moofSize + 8 + int32(len(compPkt))
+
+	repaired := RepairALACFragment(frag, map[uint32]ALACConfig{1: cfg})
+	if repaired != 1 {
+		t.Fatalf("RepairALACFragment repaired = %d, want 1", repaired)
+	}
+	// Verify compressed packet untouched and escape packet ID_END restored.
+	if !bytes.Equal(frag.Mdat.Data[:len(compPkt)], compPkt) {
+		t.Fatal("compressed packet was modified")
+	}
+	repairedPkt := frag.Mdat.Data[len(compPkt):]
+	endBit := uint64(23 + 4096*2*24)
+	if got := readBits(repairedPkt, endBit, 3); got != 0x7 {
+		t.Fatalf("repaired packet ID_END = %03b, want 111", got)
+	}
+}
