+func TestRepairALACEscapeSample_IgnoresCompressedFrames(t *testing.T) {
+	t.Parallel()
+	cfg := ALACConfig{FrameLength: 4096, BitDepth: 24, NumChannels: 2}
+	// Construct a packet of identical length (24580) with isNotCompressed = 0.
+	pkt := make([]byte, 24580)
+	writeBits(pkt, 0, 3, 1) // ID_CPE
+	// isNotCompressed (bit 22) remains 0
+	orig := append([]byte(nil), pkt...)
+
+	if RepairALACEscapeSample(pkt, cfg) {
+		t.Fatal("compressed frame was unexpectedly modified")
+	}
+	if !bytes.Equal(pkt, orig) {
+		t.Fatal("compressed frame bytes changed")
+	}
+}
