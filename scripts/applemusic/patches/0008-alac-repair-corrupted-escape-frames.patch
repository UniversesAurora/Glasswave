@@ -0,0 +1,448 @@
+package alacstream
+
+import (
+	"bytes"
+	"encoding/binary"
+	"math"
+
+	"github.com/itouakirai/mp4ff/mp4"
+)
+
+// ALACConfig holds the subset of ALACSpecificConfig needed to validate and
+// repair uncompressed ALAC escape frames.
+type ALACConfig struct {
+	FrameLength uint32
+	BitDepth    uint8
+	NumChannels uint8
+}
+
+// ParseALACConfigs extracts ALACSpecificConfig per track ID from a decrypted
+// (or unencrypted) MP4 init segment. Non-ALAC tracks are ignored.
+func ParseALACConfigs(init *mp4.InitSegment) map[uint32]ALACConfig {
+	if init == nil || init.Moov == nil {
+		return nil
+	}
+	var configs map[uint32]ALACConfig
+	for _, trak := range init.Moov.Traks {
+		if trak.Tkhd == nil || trak.Mdia == nil || trak.Mdia.Minf == nil ||
+			trak.Mdia.Minf.Stbl == nil || trak.Mdia.Minf.Stbl.Stsd == nil {
+			continue
+		}
+		for _, child := range trak.Mdia.Minf.Stbl.Stsd.Children {
+			if child.Type() != "alac" {
+				continue
+			}
+			cfg, ok := extractALACConfigFromSampleEntry(child)
+			if !ok {
+				continue
+			}
+			if configs == nil {
+				configs = make(map[uint32]ALACConfig, 1)
+			}
+			configs[trak.Tkhd.TrackID] = cfg
+			break
+		}
+	}
+	return configs
+}
+
+func extractALACConfigFromSampleEntry(entry mp4.Box) (ALACConfig, bool) {
+	// Decrypted CBCS init segments keep the outer entry as *mp4.AudioSampleEntryBox
+	// (originally "enca", renamed to "alac" by mp4.DecryptInit) with an inner
+	// "alac" fullbox child carrying the 24-byte ALACSpecificConfig.
+	if ase, ok := entry.(*mp4.AudioSampleEntryBox); ok {
+		for _, c := range ase.Children {
+			if c.Type() != "alac" {
+				continue
+			}
+			if cfg, ok := parseInnerALACBox(c); ok {
+				return cfg, true
+			}
+		}
+	}
+
+	// Unencrypted ALAC init segments parse the outer "alac" AudioSampleEntry as
+	// *mp4.UnknownBox (28-byte AudioSampleEntry header + child boxes).
+	var buf bytes.Buffer
+	if err := entry.Encode(&buf); err != nil {
+		return ALACConfig{}, false
+	}
+	raw := buf.Bytes()
+	// 8-byte box header + 28-byte AudioSampleEntry fixed header = 36 bytes.
+	const subBoxStart = 8 + 28
+	if len(raw) < subBoxStart+8 {
+		return ALACConfig{}, false
+	}
+	for pos := subBoxStart; pos+8 <= len(raw); {
+		boxSize := int(binary.BigEndian.Uint32(raw[pos : pos+4]))
+		if boxSize < 8 || pos+boxSize > len(raw) {
+			break
+		}
+		if string(raw[pos+4:pos+8]) == "alac" {
+			return parseALACSpecificConfig(raw[pos+8 : pos+boxSize])
+		}
+		pos += boxSize
+	}
+	return ALACConfig{}, false
+}
+
+func parseInnerALACBox(box mp4.Box) (ALACConfig, bool) {
+	var buf bytes.Buffer
+	if err := box.Encode(&buf); err != nil {
+		return ALACConfig{}, false
+	}
+	raw := buf.Bytes()
+	if len(raw) < 8 {
+		return ALACConfig{}, false
+	}
+	return parseALACSpecificConfig(raw[8:])
+}
+
+// parseALACSpecificConfig parses the payload of the inner "alac" fullbox:
+// 4-byte version/flags followed by the 24-byte ALACSpecificConfig.
+func parseALACSpecificConfig(payload []byte) (ALACConfig, bool) {
+	if len(payload) < 28 {
+		return ALACConfig{}, false
+	}
+	cfg := ALACConfig{
+		FrameLength: binary.BigEndian.Uint32(payload[4:8]),
+		BitDepth:    payload[9],
+		NumChannels: payload[13],
+	}
+	if cfg.FrameLength == 0 || cfg.FrameLength > 16384 {
+		return ALACConfig{}, false
+	}
+	switch cfg.BitDepth {
+	case 16, 20, 24, 32:
+	default:
+		return ALACConfig{}, false
+	}
+	if cfg.NumChannels != 1 && cfg.NumChannels != 2 {
+		return ALACConfig{}, false
+	}
+	return cfg, true
+}
+
+// RepairALACFragment inspects decrypted ALAC samples in frag and repairs
+// uncompressed ALAC escape frames whose trailing bytes were overwritten
+// upstream (missing ID_END tag and corrupted final sample). Valid compressed
+// and valid uncompressed frames are left untouched. Returns the number of
+// repaired samples.
+func RepairALACFragment(frag *mp4.Fragment, configs map[uint32]ALACConfig) int {
+	if frag == nil || frag.Moof == nil || frag.Mdat == nil || len(configs) == 0 {
+		return 0
+	}
+
+	moofToMdat := int64(0)
+	seenMoof := false
+	for _, c := range frag.Children {
+		if c == frag.Moof {
+			seenMoof = true
+			moofToMdat += int64(c.Size())
+			continue
+		}
+		if !seenMoof {
+			continue
+		}
+		if c == frag.Mdat {
+			break
+		}
+		moofToMdat += int64(c.Size())
+	}
+	if !seenMoof {
+		moofToMdat = int64(frag.Moof.Size())
+	}
+
+	mdatData := frag.Mdat.Data
+	mdatHdrSize := int64(frag.Mdat.Size()) - int64(len(mdatData))
+	if mdatHdrSize < 8 {
+		mdatHdrSize = 8
+	}
+
+	repaired := 0
+	for _, traf := range frag.Moof.Trafs {
+		if traf.Tfhd == nil {
+			continue
+		}
+		cfg, ok := configs[traf.Tfhd.TrackID]
+		if !ok && len(configs) == 1 && len(frag.Moof.Trafs) == 1 {
+			for _, only := range configs {
+				cfg = only
+				ok = true
+			}
+		}
+		if !ok {
+			continue
+		}
+
+		var defaultSampleSize int64
+		if traf.Tfhd.HasDefaultSampleSize() {
+			defaultSampleSize = int64(traf.Tfhd.DefaultSampleSize)
+		}
+
+		var curOff int64
+		for _, trun := range traf.Truns {
+			if trun.HasDataOffset() {
+				off := int64(trun.DataOffset) - moofToMdat - mdatHdrSize
+				if off < 0 || off > int64(len(mdatData)) {
+					break
+				}
+				curOff = off
+			}
+			for _, s := range trun.Samples {
+				sz := int64(s.Size)
+				if !trun.HasSampleSize() {
+					sz = defaultSampleSize
+				}
+				if sz <= 0 || curOff+sz > int64(len(mdatData)) {
+					break
+				}
+				if RepairALACEscapeSample(mdatData[curOff:curOff+sz], cfg) {
+					repaired++
+				}
+				curOff += sz
+			}
+		}
+	}
+	return repaired
+}
+
+// RepairALACEscapeSample repairs a single decrypted ALAC packet in place if and
+// only if it is a single-element uncompressed escape frame (isNotCompressed=1)
+// with a corrupted/missing ID_END (0b111) terminator.
+//
+// Background: some Apple Music ALAC tracks re-encoded upstream suffer from a
+// server-side buffer sizing defect on uncompressed escape frames (allocating
+// raw PCM bytes instead of raw PCM + 4 bytes), overwriting bytes starting at
+// rawPCMBytes with heap metadata. That overwrites the trailing 1-2 samples and
+// wipes out the 3-bit ID_END terminator, causing strict ALAC decoders (FFmpeg,
+// foobar2000) to fail with "invalid element channel count".
+//
+// Repair strategy:
+//  1. Never touch bytes before rawPCMBytes — all intact audio bits (including
+//     any intact leading MSBs of the boundary sample) are preserved bit-for-bit.
+//  2. Conceal only the overwritten sample(s) using a 4-tap regularized
+//     Levinson-Durbin AR predictor on the preceding 64 intact samples of the
+//     same channel, clamped to the exact signed interval matching any intact
+//     leading MSBs.
+//  3. Restore the 3-bit ID_END (0b111) marker and zero-fill trailing pad bits.
+func RepairALACEscapeSample(pkt []byte, cfg ALACConfig) bool {
+	if len(pkt) < 4 || cfg.FrameLength == 0 {
+		return false
+	}
+	var expectedTag uint64
+	switch cfg.NumChannels {
+	case 1:
+		expectedTag = 0 // ID_SCE
+	case 2:
+		expectedTag = 1 // ID_CPE
+	default:
+		return false
+	}
+
+	// Fast reject: byte 0..2 carries tag(3) + inst(4) + unused(12) + hasSize(1) + extraBits(2) + isNotCompressed(1).
+	if readBits(pkt, 0, 3) != expectedTag {
+		return false
+	}
+	if readBits(pkt, 3, 4) != 0 || readBits(pkt, 7, 12) != 0 {
+		return false
+	}
+	hasSize := readBits(pkt, 19, 1)
+	if readBits(pkt, 20, 2) != 0 { // extraBits must be 0 in uncompressed ALAC
+		return false
+	}
+	if readBits(pkt, 22, 1) != 1 { // compressed frame — never touch
+		return false
+	}
+
+	var headerBits, numSamples uint64
+	if hasSize == 0 {
+		headerBits = 23
+		numSamples = uint64(cfg.FrameLength)
+	} else {
+		if len(pkt) < 8 {
+			return false
+		}
+		headerBits = 55
+		numSamples = readBits(pkt, 23, 32)
+		if numSamples == 0 || numSamples > uint64(cfg.FrameLength) {
+			return false
+		}
+	}
+
+	bitDepth := uint64(cfg.BitDepth)
+	channels := uint64(cfg.NumChannels)
+	pcmBits := numSamples * channels * bitDepth
+	endBit := headerBits + pcmBits
+	expectedBytes := (endBit + 3 + 7) / 8
+	if uint64(len(pkt)) != expectedBytes {
+		return false
+	}
+
+	// If ID_END is already intact (0b111), the escape frame is valid — never touch it.
+	if readBits(pkt, endBit, 3) == 0x7 {
+		return false
+	}
+
+	// Bytes at and after rawPCMBytes (= pcmBits / 8) were overwritten upstream.
+	corruptStartBit := (pcmBits / 8) * 8
+	strideBits := channels * bitDepth
+	minVal := -(int64(1) << (cfg.BitDepth - 1))
+	maxVal := (int64(1) << (cfg.BitDepth - 1)) - 1
+
+	const historyCap = 64
+	var histBuf [historyCap]int64
+
+	for ch := uint64(0); ch < channels; ch++ {
+		chOffset := ch * bitDepth
+		// Find the first sample index whose bits cross into [corruptStartBit, endBit).
+		firstCorrupt := numSamples
+		for s := numSamples; s > 0; s-- {
+			sampleEnd := headerBits + (s-1)*strideBits + chOffset + bitDepth
+			if sampleEnd <= corruptStartBit {
+				break
+			}
+			firstCorrupt = s - 1
+		}
+		for s := firstCorrupt; s < numSamples; s++ {
+			histStart := uint64(0)
+			if s > historyCap {
+				histStart = s - historyCap
+			}
+			histLen := int(s - histStart)
+			for i := 0; i < histLen; i++ {
+				bp := headerBits + (histStart+uint64(i))*strideBits + chOffset
+				histBuf[i] = signExtend(readBits(pkt, bp, bitDepth), cfg.BitDepth)
+			}
+
+			pred := predictNextSample(histBuf[:histLen])
+			lo, hi := minVal, maxVal
+
+			sampleStart := headerBits + s*strideBits + chOffset
+			if sampleStart < corruptStartBit {
+				intactBits := corruptStartBit - sampleStart
+				remBits := bitDepth - intactBits
+				prefix := readBits(pkt, sampleStart, intactBits)
+				uLo := prefix << remBits
+				uHi := uLo | ((uint64(1) << remBits) - 1)
+				lo = signExtend(uLo, cfg.BitDepth)
+				hi = signExtend(uHi, cfg.BitDepth)
+			}
+			if pred < lo {
+				pred = lo
+			} else if pred > hi {
+				pred = hi
+			}
+
+			mask := (uint64(1) << bitDepth) - 1
+			writeBits(pkt, sampleStart, bitDepth, uint64(pred)&mask)
+		}
+	}
+
+	// Restore ID_END (0b111) and zero-fill trailing alignment bits.
+	writeBits(pkt, endBit, 3, 0x7)
+	totalBits := uint64(len(pkt)) * 8
+	if padBits := totalBits - (endBit + 3); padBits > 0 {
+		writeBits(pkt, endBit+3, padBits, 0)
+	}
+	return true
+}
+
+// predictNextSample predicts the next PCM sample from preceding samples using
+// a mean-centered 4-tap regularized Levinson-Durbin AR predictor, falling back
+// to sample-hold when history is short or near-constant.
+func predictNextSample(hist []int64) int64 {
+	n := len(hist)
+	if n == 0 {
+		return 0
+	}
+	if n < 8 {
+		return hist[n-1]
+	}
+
+	var mean float64
+	for _, v := range hist {
+		mean += float64(v)
+	}
+	mean /= float64(n)
+
+	const order = 4
+	var r [order + 1]float64
+	for lag := 0; lag <= order; lag++ {
+		var sum float64
+		for i := lag; i < n; i++ {
+			sum += (float64(hist[i]) - mean) * (float64(hist[i-lag]) - mean)
+		}
+		r[lag] = sum
+	}
+	if r[0] <= 1e-9 {
+		return hist[n-1]
+	}
+	r[0] *= 1.0001 // slight ridge regularization for numerical stability
+
+	var a, aNext [order + 1]float64
+	e := r[0]
+	for k := 1; k <= order; k++ {
+		acc := r[k]
+		for j := 1; j < k; j++ {
+			acc -= a[j] * r[k-j]
+		}
+		kappa := acc / e
+		if math.Abs(kappa) >= 0.999 || math.IsNaN(kappa) || math.IsInf(kappa, 0) {
+			break
+		}
+		aNext[k] = kappa
+		for j := 1; j < k; j++ {
+			aNext[j] = a[j] - kappa*a[k-j]
+		}
+		for j := 1; j <= k; j++ {
+			a[j] = aNext[j]
+		}
+		e *= 1.0 - kappa*kappa
+		if e <= 1e-9 {
+			break
+		}
+	}
+
+	pred := mean
+	for j := 1; j <= order; j++ {
+		pred += a[j] * (float64(hist[n-j]) - mean)
+	}
+	if math.IsNaN(pred) || math.IsInf(pred, 0) {
+		return hist[n-1]
+	}
+	return int64(math.Round(pred))
+}
+
+func readBits(buf []byte, bitPos, n uint64) uint64 {
+	var val uint64
+	for i := uint64(0); i < n; i++ {
+		bp := bitPos + i
+		bit := (buf[bp>>3] >> (7 - (bp & 7))) & 1
+		val = (val << 1) | uint64(bit)
+	}
+	return val
+}
+
+func writeBits(buf []byte, bitPos, n uint64, val uint64) {
+	for i := uint64(0); i < n; i++ {
+		bp := bitPos + i
+		shift := n - 1 - i
+		mask := byte(1 << (7 - (bp & 7)))
+		if (val>>shift)&1 != 0 {
+			buf[bp>>3] |= mask
+		} else {
+			buf[bp>>3] &^= mask
+		}
+	}
+}
+
+func signExtend(u uint64, bits uint8) int64 {
+	mask := (uint64(1) << bits) - 1
+	u &= mask
+	sign := uint64(1) << (bits - 1)
+	if u&sign != 0 {
+		return int64(u) - int64(uint64(1)<<bits)
+	}
+	return int64(u)
+}
