+func TestRepairALACEscapeSample_PartialHasSizeFrame(t *testing.T) {
+	t.Parallel()
+	cfg := ALACConfig{FrameLength: 4096, BitDepth: 24, NumChannels: 1}
+	wave := func(s, _ int) int64 {
+		return int64(math.Round(500_000 * math.Sin(2*math.Pi*float64(s)/64.0)))
+	}
+	orig := buildEscapePacket(cfg, 128, true, wave)
+	corrupt := append([]byte(nil), orig...)
+	// Overwrite bytes starting at rawPCMBytes (= 128*3 = 384).
+	for i := 384; i < len(corrupt); i++ {
+		corrupt[i] = 0
+	}
+
+	if !RepairALACEscapeSample(corrupt, cfg) {
+		t.Fatal("corrupted hasSize escape frame was not repaired")
+	}
+	if !bytes.Equal(corrupt[:384], orig[:384]) {
+		t.Fatal("intact prefix bytes before rawPCMBytes were modified")
+	}
+	endBit := uint64(55 + 128*24)
+	if got := readBits(corrupt, endBit, 3); got != 0x7 {
+		t.Fatalf("ID_END = %03b, want 111", got)
+	}
+}
