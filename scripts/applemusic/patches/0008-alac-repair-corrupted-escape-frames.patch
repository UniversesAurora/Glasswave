@@ -0,0 +1,299 @@
+package alacstream
+
+import (
+	"bytes"
+	"encoding/binary"
+	"math"
+	"testing"
+
+	"github.com/itouakirai/mp4ff/mp4"
+)
+
+func buildEscapePacket(cfg ALACConfig, numSamples int, hasSize bool, sampleFn func(s, ch int) int64) []byte {
+	var headerBits uint64 = 23
+	if hasSize {
+		headerBits = 55
+	}
+	bitDepth := uint64(cfg.BitDepth)
+	channels := uint64(cfg.NumChannels)
+	endBit := headerBits + uint64(numSamples)*channels*bitDepth
+	pkt := make([]byte, (endBit+3+7)/8)
+
+	var tag uint64
+	if cfg.NumChannels == 2 {
+		tag = 1
+	}
+	writeBits(pkt, 0, 3, tag)
+	if hasSize {
+		writeBits(pkt, 19, 1, 1)
+	}
+	writeBits(pkt, 22, 1, 1) // isNotCompressed = 1
+	if hasSize {
+		writeBits(pkt, 23, 32, uint64(numSamples))
+	}
+
+	mask := (uint64(1) << bitDepth) - 1
+	stride := channels * bitDepth
+	for s := 0; s < numSamples; s++ {
+		for ch := 0; ch < int(cfg.NumChannels); ch++ {
+			bp := headerBits + uint64(s)*stride + uint64(ch)*bitDepth
+			writeBits(pkt, bp, bitDepth, uint64(sampleFn(s, ch))&mask)
+		}
+	}
+	writeBits(pkt, endBit, 3, 0x7) // valid ID_END
+	return pkt
+}
+
+func readSample(pkt []byte, cfg ALACConfig, hasSize bool, s, ch int) int64 {
+	var headerBits uint64 = 23
+	if hasSize {
+		headerBits = 55
+	}
+	bitDepth := uint64(cfg.BitDepth)
+	stride := uint64(cfg.NumChannels) * bitDepth
+	bp := headerBits + uint64(s)*stride + uint64(ch)*bitDepth
+	return signExtend(readBits(pkt, bp, bitDepth), cfg.BitDepth)
+}
+
+func TestRepairALACEscapeSample_24BitStereo(t *testing.T) {
+	t.Parallel()
+	cfg := ALACConfig{FrameLength: 4096, BitDepth: 24, NumChannels: 2}
+	wave := func(s, ch int) int64 {
+		// Smooth low-frequency sine wave; right channel stays negative near sample 4095.
+		phase := 2 * math.Pi * float64(s) / 97.0
+		if ch == 0 {
+			return int64(math.Round(1_200_000 * math.Sin(phase)))
+		}
+		return int64(math.Round(-1_500_000 + 400_000*math.Cos(phase)))
+	}
+
+	orig := buildEscapePacket(cfg, 4096, false, wave)
+	if len(orig) != 24580 {
+		t.Fatalf("escape packet len = %d, want 24580", len(orig))
+	}
+
+	// Valid escape frame must not be modified.
+	validCopy := append([]byte(nil), orig...)
+	if RepairALACEscapeSample(validCopy, cfg) {
+		t.Fatal("valid escape frame was unexpectedly reported as repaired")
+	}
+	if !bytes.Equal(validCopy, orig) {
+		t.Fatal("valid escape frame was modified")
+	}
+
+	// Simulate Apple server glibc heap chunk overwrite at bytes 24576..24579.
+	corrupt := append([]byte(nil), orig...)
+	copy(corrupt[24576:24580], []byte{0x10, 0x60, 0x00, 0x00})
+
+	if !RepairALACEscapeSample(corrupt, cfg) {
+		t.Fatal("corrupted 24-bit stereo escape frame was not repaired")
+	}
+
+	// Bytes 0..24575 (including sample[4095].L and the sign bit of sample[4095].R) must be bit-identical.
+	if !bytes.Equal(corrupt[:24576], orig[:24576]) {
+		t.Fatal("intact prefix bytes 0..24575 were modified")
+	}
+
+	// ID_END (0b111) and trailing zero padding must be restored.
+	endBit := uint64(23 + 4096*2*24)
+	if got := readBits(corrupt, endBit, 3); got != 0x7 {
+		t.Fatalf("ID_END = %03b, want 111", got)
+	}
+	if corrupt[24579]&0x3f != 0 {
+		t.Fatalf("trailing pad bits = %06b, want 0", corrupt[24579]&0x3f)
+	}
+
+	// Concealed final R sample must closely track the true waveform (no click).
+	wantR := wave(4095, 1)
+	gotR := readSample(corrupt, cfg, false, 4095, 1)
+	if diff := math.Abs(float64(gotR - wantR)); diff > 25_000 {
+		t.Fatalf("concealed sample[4095].R = %d, want ~%d (diff %.0f)", gotR, wantR, diff)
+	}
+}
+
+func TestRepairALACEscapeSample_16BitStereoPreservesIntactMSBs(t *testing.T) {
+	t.Parallel()
+	cfg := ALACConfig{FrameLength: 4096, BitDepth: 16, NumChannels: 2}
+	wave := func(s, ch int) int64 {
+		phase := 2 * math.Pi * float64(s) / 73.0
+		if ch == 0 {
+			return int64(math.Round(12_000 * math.Sin(phase)))
+		}
+		return int64(math.Round(-9_000 * math.Cos(phase)))
+	}
+
+	orig := buildEscapePacket(cfg, 4096, false, wave)
+	if len(orig) != 16388 {
+		t.Fatalf("16-bit escape packet len = %d, want 16388", len(orig))
+	}
+
+	corrupt := append([]byte(nil), orig...)
+	copy(corrupt[16384:16388], []byte{0x10, 0x40, 0x00, 0x00})
+
+	if !RepairALACEscapeSample(corrupt, cfg) {
+		t.Fatal("corrupted 16-bit stereo escape frame was not repaired")
+	}
+	if !bytes.Equal(corrupt[:16384], orig[:16384]) {
+		t.Fatal("intact prefix bytes 0..16383 were modified (top 9 bits of sample[4095].L must be preserved)")
+	}
+	endBit := uint64(23 + 4096*2*16)
+	if got := readBits(corrupt, endBit, 3); got != 0x7 {
+		t.Fatalf("ID_END = %03b, want 111", got)
+	}
+	// Because the top 9 bits of sample[4095].L are intact, its error is bounded by < 128.
+	if diff := math.Abs(float64(readSample(corrupt, cfg, false, 4095, 0) - wave(4095, 0))); diff >= 128 {
+		t.Fatalf("sample[4095].L diff = %.0f, must be < 128", diff)
+	}
+	if diff := math.Abs(float64(readSample(corrupt, cfg, false, 4095, 1) - wave(4095, 1))); diff > 250 {
+		t.Fatalf("sample[4095].R diff = %.0f, too large", diff)
+	}
+}
