diff --git a/engine/core/vlc/player.go b/engine/core/vlc/player.go
index d647300..5437c60 100644
--- a/engine/core/vlc/player.go
+++ b/engine/core/vlc/player.go
@@ -1,3 +1,5 @@
+//go:build !glasswave
+
 // Package vlc wraps libvlc to play a single HTTP audio stream.
 // It is used for lossless/ALAC tracks that the browser's MSE cannot handle.
 package vlc
diff --git a/engine/core/vlc/player_nocgo.go b/engine/core/vlc/player_nocgo.go
index 391e1bd..a077ad1 100644
--- a/engine/core/vlc/player_nocgo.go
+++ b/engine/core/vlc/player_nocgo.go
@@ -1,4 +1,4 @@
-//go:build !cgo
+//go:build glasswave || !cgo
 
 package vlc
 
@@ -7,10 +7,10 @@ import (
 	"io"
 )
 
-// Without cgo there is no libvlc, so lossless (ALAC) playback is unavailable. The engine already treats a
-// failed New as "no player" (APIServer.vlcPlayer stays nil), so AAC and music videos, which play in the
-// browser, are unaffected. This file replaces player.go and callbacks.go only when cgo is off; the API
-// below must match theirs.
+// Without cgo there is no libvlc. Glasswave builds deliberately select this
+// stub even when cgo is enabled because the C++ client owns decoding; only the
+// encoded ALAC bitstream crosses the API boundary. The API below must match
+// player.go and callbacks.go.
 var ErrUnavailable = errors.New("vlc: built without cgo, lossless playback is unavailable")
 
 // Source mirrors the interface in callbacks.go, which the engine's handlers implement.
