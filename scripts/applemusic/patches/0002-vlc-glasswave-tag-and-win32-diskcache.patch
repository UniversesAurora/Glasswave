From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Glasswave <glasswave@local>
Date: Mon, 23 Nov 2026 12:55:21 +0800
Subject: [PATCH 2/8] vlc, diskcache: select nocgo VLC stub under glasswave tag
 and fix Windows close test

Exclude libvlc CGo bindings when building with -tags glasswave (Glasswave decodes inside foobar2000), and accept ERROR_INVALID_HANDLE on Windows in diskcache streaming close tests.

diff --git a/engine/core/diskcache/streaming_close_test.go b/engine/core/diskcache/streaming_close_test.go
index 9f1a38a..7c458c8 100644
--- a/engine/core/diskcache/streaming_close_test.go
+++ b/engine/core/diskcache/streaming_close_test.go
@@ -6,7 +6,9 @@ import (
 	"io"
 	"os"
 	"path/filepath"
+	"runtime"
 	"sync"
+	"syscall"
 	"testing"
 )
 
@@ -40,7 +42,8 @@ func checkCloseReferences(t *testing.T, sw *StreamingPutWriter, want int32) {
 	}
 	_, err := sw.file.Stat()
 	if want == 0 {
-		if !errors.Is(err, os.ErrClosed) {
+		closedOnWindows := runtime.GOOS == "windows" && errors.Is(err, syscall.Errno(6))
+		if !errors.Is(err, os.ErrClosed) && !closedOnWindows {
 			t.Errorf("last reference did not close descriptor: %v", err)
 		}
 	} else if err != nil {
