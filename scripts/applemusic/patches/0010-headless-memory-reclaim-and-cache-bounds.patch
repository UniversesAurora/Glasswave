+const lazySweepInterval = 5 * time.Minute
+
+func (m *Manager) maybeLazySweep(now time.Time) {
+	if m.reapEnabled {
+		return
+	}
+	nowNs := now.UnixNano()
+	last := m.lastLazySweep.Load()
+	if last != 0 && nowNs-last < int64(lazySweepInterval) {
+		return
+	}
+	if !m.lastLazySweep.CompareAndSwap(last, nowNs) {
+		return
+	}
+	m.sweepExpired(now)
+}
+
 func (m *Manager) store(assetKey string, sess *Session, pctx *playContext) {
+	m.maybeLazySweep(time.Now())
 	m.mu.Lock()
 	if m.sessions == nil {
 		m.sessions = make(map[string]*Session)
