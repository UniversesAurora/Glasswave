+func TestWithoutReaper_LazySweepRemovesExpiredOnOpen(t *testing.T) {
+	m := NewWithProviderWithoutReaper(&stubProvider{})
+	defer m.Close()
+
+	stale, err := m.Open(context.Background(), OpenRequest{AssetID: "stale"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.mu.Lock()
+	m.contexts[stale.ID].expiry = time.Now().Add(-time.Second)
+	m.mu.Unlock()
+	// Allow the lazy sweep interval to elapse immediately in the test.
+	m.lastLazySweep.Store(time.Now().Add(-lazySweepInterval - time.Second).UnixNano())
+
+	if _, err := m.Open(context.Background(), OpenRequest{AssetID: "fresh"}); err != nil {
+		t.Fatal(err)
+	}
+
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	if _, still := m.sessions[stale.ID]; still {
+		t.Fatal("expired session was not lazily swept on subsequent Open")
+	}
+	if len(m.sessions) != 1 {
+		t.Fatalf("sessions count = %d, want 1", len(m.sessions))
+	}
+}
