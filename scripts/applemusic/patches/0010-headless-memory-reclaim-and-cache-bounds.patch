+type blockingStreamSource struct {
+	started   chan struct{}
+	cancelled chan struct{}
+}
+
+func (b *blockingStreamSource) Stream(ctx context.Context, w io.Writer) error {
+	close(b.started)
+	_, _ = w.Write([]byte("chunk"))
+	<-ctx.Done()
+	close(b.cancelled)
+	return ctx.Err()
+}
+
+type blockingTestProvider struct {
+	src *blockingStreamSource
+}
+
+func (p blockingTestProvider) Open(context.Context, media.OpenRequest) (*media.Session, error) {
+	return &media.Session{
+		Kind:     "song",
+		Metadata: media.Metadata{DurationMs: 180000},
+		Tracks: []media.Track{{
+			Kind:  pipeline.KindAudio,
+			Codec: pipeline.CodecALAC,
+			Open: func(context.Context) (*pipeline.Stream, error) {
+				return &pipeline.Stream{
+					Kind:   pipeline.KindAudio,
+					Codec:  pipeline.CodecALAC,
+					Source: p.src,
+				}, nil
+			},
+		}},
+	}, nil
+}
+
+func TestGlasswaveHeadlessCancelsCacheDownloadOnSessionDeleteAndReclaimsMemory(t *testing.T) {
+	src := &blockingStreamSource{
+		started:   make(chan struct{}),
+		cancelled: make(chan struct{}),
+	}
+	pm := playback.NewWithProviderWithoutReaper(blockingTestProvider{src: src})
+	defer pm.Close()
+
+	dc, err := diskcache.New(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	reclaimed := make(chan struct{}, 2)
+	s := &APIServer{
+		headless:    true,
+		pm:          pm,
+		diskCache:   dc,
+		alac:        newALACGate(),
+		events:      newEventBus(newEpochManager()),
+		shutdownCtx: context.Background(),
+		reclaimMemoryFn: func() {
+			reclaimed <- struct{}{}
+		},
+	}
+	s.installReleaseHook()
+
+	sess, err := pm.Open(context.Background(), playback.OpenRequest{AssetID: "999", Lossless: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	spw, err := dc.BeginStreamingPut(sess.AssetID, "alac")
+	if err != nil || spw == nil {
+		t.Fatalf("BeginStreamingPut failed: spw=%v err=%v", spw, err)
+	}
+	s.startCacheDownload(sess.ID, spw)
+
+	select {
+	case <-src.started:
+	case <-time.After(2 * time.Second):
+		t.Fatal("startCacheDownload did not begin streaming")
+	}
+
+	// Reclaim must be suppressed while a stream is active.
+	s.reclaimIdleMemory()
+	select {
+	case <-reclaimed:
+		t.Fatal("reclaimIdleMemory ran while a stream was still active")
+	case <-time.After(50 * time.Millisecond):
+	}
+
+	req := httptest.NewRequest(http.MethodDelete, "/api/v1/playback/"+sess.ID, nil)
+	req.SetPathValue("id", sess.ID)
+	w := httptest.NewRecorder()
+	s.handleDeletePlayback(w, req)
+	if w.Code != http.StatusNoContent {
+		t.Fatalf("DELETE status = %d, want 204", w.Code)
+	}
+
+	select {
+	case <-src.cancelled:
+	case <-time.After(2 * time.Second):
+		t.Fatal("DELETE /api/v1/playback/{id} did not cancel headless background cache download")
+	}
+
+	select {
+	case <-reclaimed:
+	case <-time.After(2 * time.Second):
+		t.Fatal("headless memory reclaim did not trigger after stream ended")
+	}
+
+	// Second immediate reclaim must be suppressed by the cooldown.
+	s.reclaimIdleMemory()
+	select {
+	case <-reclaimed:
+		t.Fatal("reclaimIdleMemory ignored cooldown")
+	case <-time.After(50 * time.Millisecond):
+	}
+}
+
+func TestGlasswaveHeadlessDiskCacheBoundsConfigured(t *testing.T) {
+	if headlessDiskCacheLimitMB <= 0 || headlessDiskCacheTTLDays <= 0 {
+		t.Fatalf("headless disk cache bounds must be positive: limitMB=%d ttlDays=%d",
+			headlessDiskCacheLimitMB, headlessDiskCacheTTLDays)
+	}
+}
