 					t := time.NewTicker(time.Hour)
 					defer t.Stop()
@@ -1273,12 +1290,101 @@ func pickedExportRoots() []string {
 	return out
 }
 
+const (
+	headlessDiskCacheLimitMB      = 256
+	headlessDiskCacheTTLDays      = 1
+	headlessMemoryReclaimCooldown = 15 * time.Second
+)
+
+type cacheDownloadHandle struct {
+	gen    uint64
+	cancel context.CancelFunc
+}
+
+func (s *APIServer) registerCacheDownload(id string, cancel context.CancelFunc) uint64 {
+	if !s.headless {
+		return 0
+	}
+	s.cacheDownloadMu.Lock()
+	if s.cacheDownloads == nil {
+		s.cacheDownloads = make(map[string]cacheDownloadHandle)
+	}
+	prev, hadPrev := s.cacheDownloads[id]
+	s.cacheDownloadGen++
+	gen := s.cacheDownloadGen
+	s.cacheDownloads[id] = cacheDownloadHandle{gen: gen, cancel: cancel}
+	s.cacheDownloadMu.Unlock()
+	if hadPrev && prev.cancel != nil {
+		prev.cancel()
+	}
+	return gen
+}
+
+func (s *APIServer) unregisterCacheDownload(id string, gen uint64) {
+	if !s.headless || gen == 0 {
+		return
+	}
+	s.cacheDownloadMu.Lock()
+	if cur, ok := s.cacheDownloads[id]; ok && cur.gen == gen {
+		delete(s.cacheDownloads, id)
+	}
+	s.cacheDownloadMu.Unlock()
+}
+
+func (s *APIServer) cancelCacheDownload(id string) {
+	if !s.headless {
+		return
+	}
+	s.cacheDownloadMu.Lock()
+	cur, ok := s.cacheDownloads[id]
+	if ok {
+		delete(s.cacheDownloads, id)
+	}
+	s.cacheDownloadMu.Unlock()
+	if ok && cur.cancel != nil {
+		cur.cancel()
+	}
+}
+
+// reclaimIdleMemory returns freed Go heap pages to the OS after playback work
+// settles in headless mode (where the periodic 2-minute FreeOSMemory ticker is
+// disabled to keep idle startup and idle runtime timer-free).
+func (s *APIServer) reclaimIdleMemory() {
+	if !s.headless {
+		return
+	}
+	if s.pm != nil && s.pm.ActiveStreams() > 0 {
+		return
+	}
+	now := time.Now().UnixNano()
+	last := s.lastMemoryReclaimNs.Load()
+	if last != 0 && now-last < int64(headlessMemoryReclaimCooldown) {
+		return
+	}
+	if !s.memoryReclaiming.CompareAndSwap(false, true) {
+		return
+	}
+	if !s.lastMemoryReclaimNs.CompareAndSwap(last, now) {
+		s.memoryReclaiming.Store(false)
+		return
+	}
+	fn := s.reclaimMemoryFn
+	if fn == nil {
+		fn = debug.FreeOSMemory
+	}
+	go func() {
+		defer s.memoryReclaiming.Store(false)
+		fn()
+	}()
+}
+
 // installReleaseHook frees a session's server-side resources however the session ends.
 // DELETE /playback/{id} does this itself; a session that simply expires, or whose client
 // vanished, would otherwise leave its producers running and its cache file pinned.
 func (s *APIServer) installReleaseHook() {
 	s.pm.SetReleaseHook(func(id string) {
 		s.stopVsegSession(id)
+		s.cancelCacheDownload(id)
 	})
 }
 
