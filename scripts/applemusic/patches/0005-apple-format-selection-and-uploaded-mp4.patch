+	var extended bytes.Buffer
+	extended.Write(input[:mdat.offset])
+	var header [16]byte
+	binary.BigEndian.PutUint32(header[:], 1)
+	copy(header[4:], "mdat")
+	binary.BigEndian.PutUint64(header[8:], uint64(mdat.size+8))
