+func TestUploadedMP4ChunkOffsetPromotionAndOverflow(t *testing.T) {
+	input := uploadedLocalAAC(t, "aac-48.m4a")
+	box := uploadedTestBox(t, input, "moov")
+	moov, err := uploadedMP4DecodeMoov(input[box.offset : box.offset+box.size])
+	if err != nil {
+		t.Fatal(err)
+	}
+	stbl := moov.Trak.Mdia.Minf.Stbl
+	for i := range stbl.Stco.ChunkOffset {
+		stbl.Stco.ChunkOffset[i] = math.MaxUint32 - 1
+	}
+	encoded, err := relocateUploadedMoov(moov, math.MaxUint32-10, math.MaxUint32+100)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if stbl.Stco != nil || stbl.Co64 == nil {
+		t.Fatal("Offset overflow did not promote to co64")
+	}
+	for _, v := range stbl.Co64.ChunkOffset {
+		if v != math.MaxUint32-1+uint64(len(encoded)) {
+			t.Fatal("Promotion did not recompute final index delta")
+		}
+	}
+	for i := range stbl.Co64.ChunkOffset {
+		stbl.Co64.ChunkOffset[i] = math.MaxUint64 - 1
+	}
+	if _, err := relocateUploadedMoov(moov, math.MaxUint64-10, math.MaxUint64); err == nil {
+		t.Fatal("64-bit arithmetic overflow accepted")
+	}
