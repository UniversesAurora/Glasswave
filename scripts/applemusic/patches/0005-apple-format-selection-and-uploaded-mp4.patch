@@ -0,0 +1,260 @@
+package apple
+
+// This opt-in test exposes the actual normalizer, never an Apple/account API.
+// The native probe can consume its output while the original mdat's last byte
+// remains held upstream. It is skipped by every ordinary test invocation.
+import (
+	"context"
+	"crypto/rand"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/itouakirai/mp4ff/mp4"
+)
+
+func TestUploadedMP4NativeFixture(t *testing.T) {
+	statePath := os.Getenv("GLASSWAVE_UPLOAD_MP4_FIXTURE_STATE")
+	if statePath == "" {
+		t.Skip("The native fixture is explicitly opt-in")
+	}
+	fixtureName := strings.TrimSpace(os.Getenv("GLASSWAVE_UPLOAD_MP4_FIXTURE_FILE"))
+	if fixtureName == "" {
+		fixtureName = "aac-48.m4a"
+	}
+	if fixtureName != filepath.Base(fixtureName) {
+		t.Fatal("Native fixture must be a filename under the repository .local/tests directory")
+	}
+	input := uploadedLocalAAC(t, fixtureName)
+	mdat := uploadedTestBox(t, input, "mdat")
+	gateAt := mdat.offset + mdat.header + (mdat.size-mdat.header)/2
+	if gateAt <= mdat.offset+uploadedMP4HeadLimit || gateAt >= mdat.offset+mdat.size {
+		t.Fatal("Native fixture cannot select a safe mid-mdat gate")
+	}
+	heldRemainingBytes := int64(len(input)) - gateAt
+	f := &uploadedMP4Fixture{data: input, gateAt: gateAt, release: make(chan struct{}), cancelled: make(chan struct{}, 1)}
+	upstream := httptest.NewServer(http.HandlerFunc(f.handler))
+	defer upstream.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Minute)
+	defer cancel()
+	p, err := planUploadedMP4(ctx, upstream.Client(), upstream.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !p.rewritten || p.sequentialIndex {
+		t.Fatal("Native fixture did not use progressive tail-index normalization")
+	}
+	_, fixtureDurationMs, err := audioInfoFromMoov(p.moov)
+	if err != nil || fixtureDurationMs <= 0 {
+		t.Fatal("Native fixture could not determine its media duration")
+	}
+	token := rand.Text()
+	var release, stop sync.Once
+	done := make(chan struct{})
+	var mu sync.Mutex
+	requests, completed, failures := 0, 0, 0
+	released := false
+	var releaseUnixMs int64
+	openGate := func() {
+		release.Do(func() {
+			mu.Lock()
+			released = true
+			releaseUnixMs = time.Now().UnixMilli()
+			mu.Unlock()
+			close(f.release)
+		})
+	}
+	defer openGate()
+	mux := http.NewServeMux()
+	mux.HandleFunc("/stream", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet || r.Header.Get("Range") != "" {
+			w.WriteHeader(416)
+			return
+		}
+		mu.Lock()
+		requests++
+		mu.Unlock()
+		w.Header().Set("Content-Type", "audio/mp4")
+		w.Header().Set("Accept-Ranges", "none")
+		w.Header().Set("Content-Length", strconv.FormatInt(p.outputLength, 10))
+		if err := p.Stream(r.Context(), w); err != nil {
+			mu.Lock()
+			failures++
+			mu.Unlock()
+			return
+		}
+		mu.Lock()
+		completed++
+		mu.Unlock()
+	})
+	mux.HandleFunc("/release", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			w.WriteHeader(405)
+			return
+		}
+		openGate()
+		w.WriteHeader(204)
+	})
+	mux.HandleFunc("/state", func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		defer mu.Unlock()
+		f.mu.Lock()
+		served := f.served
+		gateReachedUnixMs := f.gateReachedUnixMs
+		lastByteWrittenUnixMs := f.lastByteWrittenUnixMs
+		f.mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]any{"requests": requests, "completed": completed, "failures": failures, "released": released, "releaseUnixMs": releaseUnixMs, "gateReachedUnixMs": gateReachedUnixMs, "lastByteWrittenUnixMs": lastByteWrittenUnixMs, "ready": true, "upstreamBytesServed": served, "originalBytes": len(input), "originalMdatBytes": mdat.size - mdat.header, "gateAt": gateAt, "heldRemainingBytes": heldRemainingBytes})
+	})
+	mux.HandleFunc("/stop", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			w.WriteHeader(405)
+			return
+		}
+		openGate()
+		stop.Do(func() { close(done) })
+		w.WriteHeader(204)
+	})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-Glasswave-Fixture") != token {
+			w.WriteHeader(403)
+			return
+		}
+		mux.ServeHTTP(w, r)
+	}))
+	defer func() { openGate(); cancel(); server.Close() }()
+	state := map[string]any{
+		"schema": 1, "ready": true, "readyUnixMs": time.Now().UnixMilli(),
+		"url": server.URL, "token": token, "codec": "aac", "sampleRate": 48000,
+		"channels": 2, "durationMs": fixtureDurationMs, "sourceVersion": p.sourceVersion(),
+		"outputBytes": p.outputLength, "originalBytes": len(input),
+		"originalMdatBytes": mdat.size - mdat.header, "gateAt": gateAt,
+		"heldRemainingBytes": heldRemainingBytes, "releaseUnixMs": int64(0),
+		"gateReachedUnixMs": int64(0), "lastByteWrittenUnixMs": int64(0),
+	}
+	data, err := json.Marshal(state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(statePath, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(statePath)
+	select {
+	case <-done:
+	case <-ctx.Done():
+		t.Fatal("Native fixture lifetime expired")
+	}
+}
