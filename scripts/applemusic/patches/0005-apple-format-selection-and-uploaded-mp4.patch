+func TestExtractALACQuality_HiRes(t *testing.T) {
+	t.Parallel()
+	// An explicitly numeric trait is evidence and is normalised to Hz.
+	sr, bd := extractALACQuality([]string{"lossless-audio-192-24"})
+	if sr != 192000 || bd != 24 {
+		t.Errorf("got %d/%d want 192000/24", sr, bd)
+	}
+}
+
+func TestExtractALACQuality_DoesNotGuess(t *testing.T) {
+	t.Parallel()
+	// Generic Apple traits say only that lossless exists. Without a numeric
+	// quality in the trait or HLS group, both fields must stay unknown.
+	sr, bd := extractALACQuality([]string{"lossless", "atmos"})
+	if sr != 0 || bd != 0 {
+		t.Errorf("got %d/%d want 0/0 for generic traits", sr, bd)
+	}
+	sr, bd = extractALACQuality([]string{"hi-res-lossless", "lossless-96000"})
+	if sr != 0 || bd != 0 {
+		t.Errorf("got %d/%d want 0/0 for partial traits", sr, bd)
+	}
+	sr, bd = extractALACQuality([]string{"lossless-24000-16", "lossless-192000-32"})
+	if sr != 0 || bd != 0 {
+		t.Errorf("got %d/%d want 0/0 for unsupported qualities", sr, bd)
+	}
+	sr, bd = extractALACQuality([]string{"release-192-24"})
+	if sr != 0 || bd != 0 {
+		t.Errorf("got %d/%d want 0/0 for unrelated numeric metadata", sr, bd)
+	}
+}
