+func TestUploadedMP4IndexDepthAndBoxCountAreBounded(t *testing.T) {
+	wrap := func(typ string, body []byte) []byte {
+		data := make([]byte, 8+len(body))
+		binary.BigEndian.PutUint32(data, uint32(len(data)))
+		copy(data[4:], typ)
+		copy(data[8:], body)
+		return data
+	}
+	deep := wrap("free", nil)
+	for i := 0; i < 26; i++ {
+		deep = wrap("moov", deep)
+	}
+	if err := validateUploadedMP4Index(deep); err == nil {
+		t.Fatal("Unbounded recursive metadata was accepted")
+	}
+	wide := wrap("moov", bytes.Repeat(wrap("free", nil), 4097))
+	if err := validateUploadedMP4Index(wide); err == nil {
+		t.Fatal("Unbounded metadata box count was accepted")
+	}
