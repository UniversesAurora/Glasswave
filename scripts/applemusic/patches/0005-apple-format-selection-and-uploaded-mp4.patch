+func TestSelectSongFormat_PreferAtmosFallsBackOnlyWhenAbsent(t *testing.T) {
+	t.Parallel()
+	masterWithALAC := &hls.Master{Variants: []hls.Variant{
+		{URL: "aac", Bandwidth: 256_000, Codecs: "mp4a.40.2"},
+		{URL: "alac", Bandwidth: 4_600_000, Codecs: "alac", AudioSampleRate: 192000, AudioBitDepth: 24},
+	}}
+	got, err := selectSongFormat(media.OpenRequest{PreferAtmos: true, Lossless: true, HiRes: true},
+		map[string]bool{"atmos": true, "lossless": true}, masterWithALAC, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Codec != pipeline.CodecALAC || got.PlaylistURL != "alac" {
+		t.Fatalf("selected codec=%s url=%q, want highest ALAC", got.Codec, got.PlaylistURL)
+	}
+
+	masterWithEC3 := &hls.Master{Variants: []hls.Variant{
+		{URL: "not-allowed-without-trait", Bandwidth: 768_000, Codecs: "ec-3"},
+		{URL: "alac", Bandwidth: 4_600_000, Codecs: "alac", AudioSampleRate: 192000, AudioBitDepth: 24},
+	}}
+	got, err = selectSongFormat(media.OpenRequest{PreferAtmos: true, Lossless: true, HiRes: true},
+		map[string]bool{"lossless": true}, masterWithEC3, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Codec != pipeline.CodecALAC {
+		t.Fatalf("preferAtmos without an Atmos trait selected %s, want ALAC", got.Codec)
+	}
+
+	got, err = selectSongFormat(media.OpenRequest{PreferAtmos: true}, nil, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Codec != pipeline.CodecAAC || got.FallbackToAAC {
+		t.Fatalf("absent Atmos with no lossless request = %s fallback=%v, want AAC", got.Codec, got.FallbackToAAC)
+	}
