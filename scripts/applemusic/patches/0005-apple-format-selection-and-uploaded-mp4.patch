+			box := uploadedTestBox(t, data, "moov")
+			if size == math.MaxUint64 {
+				binary.BigEndian.PutUint32(data[box.offset:], 1)
+				binary.BigEndian.PutUint64(data[box.offset+8:], size)
+			} else {
+				binary.BigEndian.PutUint32(data[box.offset:], uint32(size))
+			}
