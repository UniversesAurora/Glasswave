+func (p *appleMusicProvider) loadSongMaster(
+	ctx context.Context,
+	req media.OpenRequest,
+	traits map[string]bool,
+	url string,
+) (*hls.Master, error) {
+	needsMaster := req.Atmos || req.Lossless || (req.PreferAtmos && traits["atmos"])
+	if !needsMaster || url == "" {
+		return nil, nil
+	}
+	openMaster := p.openMaster
+	if openMaster == nil {
+		openMaster = hls.OpenMaster
+	}
+	master, err := openMaster(ctx, url)
+	if err != nil {
+		return nil, fmt.Errorf("open audio master playlist: %w", err)
+	}
+	return master, nil
+}
