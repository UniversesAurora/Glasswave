+// TestNormalizeUploadedMP4AACFixture prepares a deterministic container-only
+// long fixture for the opt-in native runner. It rewrites timing metadata while
+// leaving the compressed mdat payload untouched.
+func TestNormalizeUploadedMP4AACFixture(t *testing.T) {
+	inputPath := strings.TrimSpace(os.Getenv("GLASSWAVE_UPLOAD_MP4_NORMALIZE_INPUT"))
+	outputPath := strings.TrimSpace(os.Getenv("GLASSWAVE_UPLOAD_MP4_NORMALIZE_OUTPUT"))
+	if inputPath == "" && outputPath == "" {
+		t.Skip("The AAC fixture normalizer is explicitly opt-in")
+	}
+	if inputPath == "" || outputPath == "" {
+		t.Fatal("Both AAC fixture normalization paths are required")
+	}
+	if err := normalizeUploadedMP4AACFixture(inputPath, outputPath); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func normalizeUploadedMP4AACFixture(inputPath, outputPath string) error {
+	const aacSamplesPerPacket = uint64(1024)
+
+	file, err := mp4.ReadMP4File(inputPath)
+	if err != nil {
+		return err
+	}
+	if file.Moov == nil || file.Moov.Mvhd == nil || len(file.Moov.Traks) != 1 {
+		return fmt.Errorf("AAC fixture must contain one movie track")
+	}
+	trak := file.Moov.Traks[0]
+	if trak.Mdia == nil || trak.Mdia.Hdlr == nil || trak.Mdia.Hdlr.HandlerType != "soun" ||
+		trak.Mdia.Mdhd == nil || trak.Mdia.Minf == nil || trak.Mdia.Minf.Stbl == nil ||
+		trak.Mdia.Minf.Stbl.Stts == nil {
+		return fmt.Errorf("AAC fixture track is incomplete")
+	}
+
+	stts := trak.Mdia.Minf.Stbl.Stts
+	var samples uint64
+	for index, count := range stts.SampleCount {
+		samples += uint64(count)
+		stts.SampleTimeDelta[index] = uint32(aacSamplesPerPacket)
+	}
+	if samples == 0 {
+		return fmt.Errorf("AAC fixture has no samples")
+	}
+	mediaDuration := samples * aacSamplesPerPacket
+	presentationDuration := mediaDuration
+	if trak.Edts != nil {
+		entries := 0
+		for _, box := range trak.Edts.Elst {
+			for index := range box.Entries {
+				entry := &box.Entries[index]
+				if entry.MediaTime > 0 {
+					skipped := uint64(entry.MediaTime)
+					if skipped > mediaDuration {
+						return fmt.Errorf("AAC fixture edit list exceeds media duration")
+					}
+					presentationDuration = mediaDuration - skipped
+				}
+				entry.SegmentDuration = rescaleDuration(
+					presentationDuration, trak.Mdia.Mdhd.Timescale, file.Moov.Mvhd.Timescale)
+				entries++
+			}
+		}
+		if entries != 1 {
+			return fmt.Errorf("AAC fixture must have one edit-list entry, found %d", entries)
+		}
+	}
+
+	trak.Mdia.Mdhd.Duration = mediaDuration
+	trak.Tkhd.Duration = rescaleDuration(
+		presentationDuration, trak.Mdia.Mdhd.Timescale, file.Moov.Mvhd.Timescale)
+	file.Moov.Mvhd.Duration = rescaleDuration(
+		presentationDuration, trak.Mdia.Mdhd.Timescale, file.Moov.Mvhd.Timescale)
+	if err := mp4.WriteToFile(file, outputPath); err != nil {
+		return err
+	}
+
+	normalized, err := mp4.ReadMP4File(outputPath)
+	if err != nil {
+		return err
+	}
+	if normalized.Moov == nil || normalized.Moov.Mvhd == nil || len(normalized.Moov.Traks) != 1 {
+		return fmt.Errorf("normalized AAC fixture lost its movie track")
+	}
+	normalizedTrack := normalized.Moov.Traks[0]
+	if normalized.Moov.Mvhd.Duration != trak.Tkhd.Duration ||
+		normalizedTrack.Tkhd.Duration != trak.Tkhd.Duration ||
+		normalizedTrack.Mdia.Mdhd.Duration != mediaDuration {
+		return fmt.Errorf("normalized AAC fixture has inconsistent duration metadata")
+	}
+	if normalizedTrack.Edts == nil || len(normalizedTrack.Edts.Elst) != 1 ||
+		len(normalizedTrack.Edts.Elst[0].Entries) != 1 ||
+		normalizedTrack.Edts.Elst[0].Entries[0].SegmentDuration != trak.Tkhd.Duration {
+		return fmt.Errorf("normalized AAC fixture has an inconsistent edit list")
+	}
+	return nil
+}
+
+func rescaleDuration(value uint64, from, to uint32) uint64 {
+	if from == 0 || to == 0 {
+		return 0
+	}
+	return value * uint64(to) / uint64(from)
+}
