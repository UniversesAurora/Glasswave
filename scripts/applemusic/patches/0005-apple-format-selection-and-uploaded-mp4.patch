+func mp3Fixture(durationMs, bitRate, sampleRate int) []byte {
+	body := make([]byte, 10+durationMs*bitRate/8000)
+	copy(body, []byte("ID3\x04\x00\x00\x00\x00\x00\x00"))
+	bitrateIndex := byte(9) // MPEG-1 Layer III, 128 kbps
+	if bitRate == 192_000 {
+		bitrateIndex = 11
+	} else if bitRate == 320_000 {
+		bitrateIndex = 14
+	}
+	rateIndex := byte(0)
+	if sampleRate == 48000 {
+		rateIndex = 1
+	}
+	body[10] = 0xff
+	body[11] = 0xfb
+	body[12] = bitrateIndex << 4
+	body[13] = rateIndex << 2
+	return body
+}
+
+func mp3InfoFixture(infoFrames int) []byte {
+	const (
+		firstFrameSize = 192
+		audioFrameSize = 384
+		infoOffset     = 36
+	)
+	body := make([]byte, 10+firstFrameSize+infoFrames*audioFrameSize)
+	copy(body, []byte("ID3\x04\x00\x00\x00\x00\x00\x00"))
+
+	// The first MP3 frame is a 64 kbps Info frame; the following 128 kbps
+	// frames are the actual audio. This mirrors files emitted by ffmpeg.
+	copy(body[10:14], []byte{0xff, 0xfb, 0x54, 0x00})
+	copy(body[10+infoOffset:10+infoOffset+4], []byte("Info"))
+	binary.BigEndian.PutUint32(body[10+infoOffset+4:10+infoOffset+8], 1)
+	binary.BigEndian.PutUint32(body[10+infoOffset+8:10+infoOffset+12], uint32(infoFrames))
+	for i := range infoFrames {
+		offset := 10 + firstFrameSize + i*audioFrameSize
+		copy(body[offset:offset+4], []byte{0xff, 0xfb, 0x94, 0x64})
+	}
+	return body
+}
