+func TestUploadedAudioStreamRejectsKnownLengthMismatch(t *testing.T) {
+	body := []byte("short")
+	client := &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		return testHTTPResponse(req, http.StatusOK, body, "audio/mpeg"), nil
+	})}
+	source := &uploadedAudioSource{
+		client: client,
+		url:    uploadedTestAssetURL,
+		length: int64(len(body) + 1),
+	}
+	var out bytes.Buffer
+	err := source.Stream(context.Background(), &out)
+	if err == nil || !strings.Contains(err.Error(), "probed length") {
+		t.Fatalf("error = %v, want a probed-length mismatch", err)
+	}
+	if out.Len() != 0 {
+		t.Fatalf("wrote %d bytes before rejecting the mismatched response", out.Len())
+	}
+}
