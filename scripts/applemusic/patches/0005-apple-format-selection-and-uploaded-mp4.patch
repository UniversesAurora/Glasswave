+func TestSelectSongFormat_PrefersBestKnownALAC(t *testing.T) {
+	t.Parallel()
+	master := &hls.Master{Variants: []hls.Variant{
+		{URL: "unknown", Bandwidth: 9_000_000, Codecs: "alac"},
+		{URL: "44", Bandwidth: 900_000, Codecs: "alac", AudioSampleRate: 44100, AudioBitDepth: 16},
+		{URL: "192", Bandwidth: 4_600_000, Codecs: "alac", AudioSampleRate: 192000, AudioBitDepth: 24},
+		{URL: "aac", Bandwidth: 256_000, Codecs: "mp4a.40.2"},
+	}}
+	got, err := selectSongFormat(media.OpenRequest{Lossless: true, HiRes: true}, nil, master, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Codec != pipeline.CodecALAC || got.PlaylistURL != "192" {
+		t.Fatalf("selected codec=%s url=%q, want best ALAC at 192", got.Codec, got.PlaylistURL)
+	}
+	if got.SampleRate != 192000 || got.BitDepth != 24 {
+		t.Fatalf("quality = %d/%d, want 192000/24", got.SampleRate, got.BitDepth)
+	}
+}
