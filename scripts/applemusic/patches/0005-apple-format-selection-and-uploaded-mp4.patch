+func makeM4A(t *testing.T, entryType string, sampleRate, bitDepth, durationMs int) []byte {
+	t.Helper()
+	init := mp4.NewMP4Init()
+	init.AddChild(mp4.CreateFtyp())
+	moov := mp4.NewMoovBox()
+	init.AddChild(moov)
+	mvhd := mp4.CreateMvhd()
+	mvhd.Timescale = 1000
+	mvhd.Duration = uint64(durationMs)
+	moov.AddChild(mvhd)
+	trak := mp4.CreateEmptyTrak(1, uint32(sampleRate), "audio", "eng")
+	trak.Mdia.Mdhd.Duration = uint64(durationMs) * uint64(sampleRate) / 1000
+	stsd := trak.Mdia.Minf.Stbl.Stsd
+	if entryType == "mp4a" {
+		stsd.AddChild(mp4.CreateAudioSampleEntryBox("mp4a", 2, 16, uint16(sampleRate), nil))
+	} else {
+		payload := make([]byte, 28)
+		binary.BigEndian.PutUint16(payload[6:8], 1)
+		binary.BigEndian.PutUint16(payload[16:18], 2)
+		binary.BigEndian.PutUint16(payload[18:20], uint16(bitDepth))
+		binary.BigEndian.PutUint32(payload[24:28], uint32(sampleRate)<<16)
+		config := make([]byte, 36)
+		binary.BigEndian.PutUint32(config[0:4], 36)
+		copy(config[4:8], "alac")
+		binary.BigEndian.PutUint32(config[8:12], 4096)
+		config[13] = byte(bitDepth)
+		config[17] = 2
+		binary.BigEndian.PutUint32(config[28:32], uint32(sampleRate))
+		stsd.AddChild(mp4.CreateUnknownBox("alac", uint64(8+len(payload)+len(config)),
+			append(payload, config...)))
+	}
+	moov.AddChild(trak)
+	var out bytes.Buffer
+	if err := init.Encode(&out); err != nil {
+		t.Fatal(err)
+	}
+	out.Write(make([]byte, 32))
+	return out.Bytes()
+}
