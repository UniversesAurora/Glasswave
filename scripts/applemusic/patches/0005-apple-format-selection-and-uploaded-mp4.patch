+	stbl := moov.Trak.Mdia.Minf.Stbl
+	old := stbl.Stco
+	large := &mp4.Co64Box{Version: old.Version, Flags: old.Flags}
+	for _, v := range old.ChunkOffset {
+		large.ChunkOffset = append(large.ChunkOffset, uint64(v)+8)
+	}
+	for i, child := range stbl.Children {
+		if child == old {
