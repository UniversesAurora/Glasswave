+func (p *appleMusicProvider) openUploadedSong(ctx context.Context, req media.OpenRequest) (*media.Session, error) {
+	if !strings.HasPrefix(req.AssetID, "i.") {
+		return nil, fmt.Errorf("uploaded library fallback requires an i.* library id")
+	}
+	token, mut, err := p.resolveUploadedCredentials(ctx, req)
+	if err != nil {
+		return nil, err
+	}
+	adapter := p.uploaded
+	if adapter == nil {
+		adapter = newUploadedAudioAdapter()
+	}
+
+	asset, err := adapter.fetchUploadedAsset(ctx, req.AssetID, token, mut)
+	if err != nil {
+		return nil, fmt.Errorf("uploaded library lookup: %w", err)
+	}
+	info, err := adapter.probeUploadedAudio(ctx, &asset)
+	if err != nil {
+		return nil, fmt.Errorf("uploaded library source: %w", err)
+	}
+	if info.DurationMs <= 0 {
+		return nil, fmt.Errorf("uploaded library source has no positive duration")
+	}
+
+	return &media.Session{
+		Kind: "song",
+		Metadata: media.Metadata{
+			Title:      strings.TrimSpace(asset.metadata.ItemName),
+			ArtistName: strings.TrimSpace(asset.metadata.ArtistName),
+			AlbumName:  firstNonempty(asset.metadata.AlbumName, asset.metadata.PlaylistName),
+			DurationMs: info.DurationMs,
+		},
+		Tracks: []media.Track{{
+			Kind:          pipeline.KindAudio,
+			Codec:         info.Codec,
+			SampleRate:    info.SampleRate,
+			BitDepth:      info.BitDepth,
+			BitRate:       info.BitRate,
+			ChannelCount:  info.ChannelCount,
+			CodecMIMEType: info.MIMEType,
+			Container:     info.Container,
+			Extension:     info.Extension,
+			SourceVersion: uploadedAudioSourceVersion(info),
+			Open: func(ctx context.Context) (*pipeline.Stream, error) {
+				return &pipeline.Stream{
+					Source: &uploadedAudioSource{
+						client:  adapter.streamClient,
+						url:     asset.url,
+						length:  asset.length,
+						mp4Plan: info.mp4Plan,
+					},
+					Kind:       pipeline.KindAudio,
+					Codec:      info.Codec,
+					DurationMs: info.DurationMs,
+				}, nil
+			},
+		}},
+	}, nil
+}
+
+func (p *appleMusicProvider) resolveUploadedCredentials(ctx context.Context, req media.OpenRequest) (token, mut string, err error) {
+	token = strings.TrimPrefix(strings.TrimSpace(req.Token), "Bearer ")
+	mut = strings.TrimSpace(req.MUT)
+	if (token == "" || mut == "") && p.acct != nil {
+		devToken, musicToken, accountErr := p.acct.GetMusicToken(ctx)
+		if token == "" {
+			token = strings.TrimPrefix(strings.TrimSpace(devToken), "Bearer ")
+		}
+		if mut == "" {
+			mut = strings.TrimSpace(musicToken)
+		}
+		if token == "" && mut == "" && accountErr != nil {
+			err = accountErr
+		}
+	}
+	if token == "" {
+		token, err = ampapi.GetToken()
+		if err != nil {
+			return "", "", fmt.Errorf("Apple developer token unavailable: %w", err)
+		}
+	}
+	if mut == "" {
+		if err != nil {
+			return "", "", fmt.Errorf("Apple Music account is not signed in: %w", err)
+		}
+		return "", "", fmt.Errorf("Apple Music account is not signed in")
+	}
+	return token, mut, nil
+}
+
+type resolvedUploadedAsset struct {
+	url      string
+	length   int64
+	metadata uploadedWebPlaybackMetadata
+}
+
+func (a *uploadedAudioAdapter) fetchUploadedAsset(
+	ctx context.Context,
+	libraryID, token, mut string,
+) (resolvedUploadedAsset, error) {
+	body, err := json.Marshal(map[string]any{
+		"universalLibraryId": libraryID,
+		"isLibrary":          true,
+	})
+	if err != nil {
+		return resolvedUploadedAsset{}, err
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, uploadedWebPlaybackURL, bytes.NewReader(body))
+	if err != nil {
+		return resolvedUploadedAsset{}, err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("x-apple-music-user-token", mut)
+	req.Header.Set("Origin", "https://music.apple.com")
+	req.Header.Set("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36")
+
+	resp, err := a.apiClient.Do(req)
+	if err != nil {
+		return resolvedUploadedAsset{}, fmt.Errorf("webPlayback request failed: %w", sanitizedTransportError(err))
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return resolvedUploadedAsset{}, fmt.Errorf("webPlayback HTTP %d", resp.StatusCode)
+	}
+	raw, err := readBounded(resp.Body, uploadedJSONLimit)
+	if err != nil {
+		return resolvedUploadedAsset{}, err
+	}
+	var payload uploadedWebPlaybackResponse
+	if err := json.Unmarshal(raw, &payload); err != nil {
+		return resolvedUploadedAsset{}, fmt.Errorf("parse webPlayback response: %w", err)
+	}
+	if payload.FailureType != "" || payload.FailureMessage != "" {
+		return resolvedUploadedAsset{}, fmt.Errorf("webPlayback refused the library item")
+	}
+	if len(payload.SongList) != 1 {
+		return resolvedUploadedAsset{}, fmt.Errorf("webPlayback returned %d songs, want 1", len(payload.SongList))
+	}
+	song := payload.SongList[0]
+	if !isNegativeOne(song.SongID) {
+		return resolvedUploadedAsset{}, fmt.Errorf("library item resolved to catalog playback; use its catalog id")
+	}
+	if song.NeedsPlaybackReporting {
+		return resolvedUploadedAsset{}, fmt.Errorf("library item unexpectedly requires playback reporting")
+	}
+	if len(song.Assets) != 1 {
+		return resolvedUploadedAsset{}, fmt.Errorf("library item has %d assets, want exactly one original asset", len(song.Assets))
+	}
+	asset := song.Assets[0]
+	if strings.TrimSpace(asset.Flavor) != "" {
+		return resolvedUploadedAsset{}, fmt.Errorf("library item exposed a DRM flavor instead of an original upload")
+	}
+	if err := validateUploadedAssetURL(asset.URL); err != nil {
+		return resolvedUploadedAsset{}, err
+	}
+	if asset.Metadata.Duration <= 0 {
+		return resolvedUploadedAsset{}, fmt.Errorf("library asset metadata has no positive duration")
+	}
+	return resolvedUploadedAsset{
+		url:      asset.URL,
+		metadata: asset.Metadata,
+	}, nil
+}
+
+func isNegativeOne(v any) bool {
+	switch value := v.(type) {
+	case float64:
+		return value == -1
+	case json.Number:
+		return value.String() == "-1"
+	case string:
+		return strings.TrimSpace(value) == "-1"
+	case int:
+		return value == -1
+	case int64:
+		return value == -1
+	default:
+		return false
+	}
+}
+
+func validateUploadedAssetURL(raw string) error {
+	u, err := url.Parse(strings.TrimSpace(raw))
+	if err != nil || u.Scheme != "https" || u.Host == "" || u.User != nil ||
+		u.Opaque != "" || u.Fragment != "" {
+		return fmt.Errorf("library asset URL is invalid")
+	}
+	host := strings.ToLower(strings.TrimSuffix(u.Hostname(), "."))
+	if !strings.HasSuffix(host, ".blobstore.apple.com") {
+		return fmt.Errorf("library asset host is not an Apple blobstore")
+	}
+	return nil
+}
+
+func readBounded(r io.Reader, limit int64) ([]byte, error) {
+	body, err := io.ReadAll(io.LimitReader(r, limit+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(body)) > limit {
+		return nil, fmt.Errorf("response body exceeded %d bytes", limit)
+	}
+	return body, nil
+}
+
+type uploadedRangeResponse struct {
+	body  []byte
+	total int64
+}
+
+func (a *uploadedAudioAdapter) fetchUploadedRange(
+	ctx context.Context,
+	rawURL string,
+	start, end int64,
+) (uploadedRangeResponse, error) {
+	if start < 0 || end < start {
+		return uploadedRangeResponse{}, fmt.Errorf("invalid byte range")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, rawURL, nil)
+	if err != nil {
+		return uploadedRangeResponse{}, err
+	}
+	req.Header.Set("Range", fmt.Sprintf("bytes=%d-%d", start, end))
+	resp, err := a.apiClient.Do(req)
+	if err != nil {
+		return uploadedRangeResponse{}, fmt.Errorf("library asset probe failed: %w", sanitizedTransportError(err))
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusPartialContent && resp.StatusCode != http.StatusOK {
+		return uploadedRangeResponse{}, fmt.Errorf("library asset probe HTTP %d", resp.StatusCode)
+	}
+	body, err := readBounded(resp.Body, end-start+1)
+	if err != nil {
+		return uploadedRangeResponse{}, err
+	}
+	total, err := contentRangeTotal(resp.Header.Get("Content-Range"), resp.StatusCode, start, int64(len(body)))
+	if err != nil {
+		if resp.StatusCode == http.StatusPartialContent {
+			return uploadedRangeResponse{}, err
+		}
+		if resp.ContentLength >= 0 {
+			total = resp.ContentLength
+		}
+	}
+	return uploadedRangeResponse{
+		body:  body,
+		total: total,
+	}, nil
+}
+
+func contentRangeTotal(value string, status int, start, got int64) (int64, error) {
+	if status == http.StatusOK {
+		return 0, nil
+	}
+	if !strings.HasPrefix(value, "bytes ") {
+		return 0, fmt.Errorf("library asset response has no Content-Range total")
+	}
+	rangePart, totalPart, ok := strings.Cut(strings.TrimPrefix(value, "bytes "), "/")
+	if !ok || totalPart == "*" {
+		return 0, fmt.Errorf("library asset response has unknown Content-Range total")
+	}
+	fromPart, toPart, ok := strings.Cut(rangePart, "-")
+	if !ok {
+		return 0, fmt.Errorf("library asset response has invalid Content-Range")
+	}
+	from, err1 := strconv.ParseInt(fromPart, 10, 64)
+	to, err2 := strconv.ParseInt(toPart, 10, 64)
+	total, err3 := strconv.ParseInt(totalPart, 10, 64)
+	if err1 != nil || err2 != nil || err3 != nil || from != start || to-from+1 != got ||
+		total <= 0 || total > uploadedAssetSizeLimit {
+		return 0, fmt.Errorf("library asset response has invalid Content-Range")
+	}
+	return total, nil
+}
+
+func (a *uploadedAudioAdapter) probeUploadedAudio(
+	ctx context.Context,
+	asset *resolvedUploadedAsset,
+) (uploadedAudioInfo, error) {
+	ext := strings.TrimPrefix(strings.ToLower(strings.TrimSpace(asset.metadata.FileExtension)), ".")
+	if ext == "m4a" || ext == "mp4" {
+		plan, err := planUploadedMP4Clients(ctx, a.apiClient, a.streamClient, asset.url)
+		if err != nil {
+			return uploadedAudioInfo{}, err
+		}
+		info, duration, err := audioInfoFromMoov(plan.moov)
+		if err != nil {
+			return uploadedAudioInfo{}, err
+		}
+		if duration > 0 && int64(absInt(duration-int(asset.metadata.Duration))) > uploadedDurationSlackMs {
+			return uploadedAudioInfo{}, fmt.Errorf("MP4 duration disagrees with asset metadata")
+		}
+		if info.DurationMs <= 0 {
+			info.DurationMs = duration
+		}
+		if info.DurationMs <= 0 {
+			info.DurationMs = int(asset.metadata.Duration)
+		}
+		if info.DurationMs <= 0 {
+			return uploadedAudioInfo{}, fmt.Errorf("no positive duration")
+		}
+		if err := validateUploadedQuality(asset.metadata, info); err != nil {
+			return uploadedAudioInfo{}, err
+		}
+		info.Container, info.Extension = "mp4", "m4a"
+		info.BitRate = normalizeMetadataBitRate(asset.metadata.BitRate)
+		info.mp4Plan = plan
+		asset.length = plan.remote.total
+		return info, nil
+	}
+	head, err := a.fetchUploadedRange(ctx, asset.url, 0, uploadedProbeLimit-1)
+	if err != nil {
+		return uploadedAudioInfo{}, err
+	}
+	asset.length = head.total
+	info, err := detectUploadedAudio(ctx, a, asset.url, head, asset.metadata)
+	if err != nil {
+		return uploadedAudioInfo{}, err
+	}
+	if info.DurationMs <= 0 {
+		info.DurationMs = int(asset.metadata.Duration)
+	}
+	if info.DurationMs <= 0 {
+		return uploadedAudioInfo{}, fmt.Errorf("no positive duration")
+	}
+	if err := validateUploadedQuality(asset.metadata, info); err != nil {
+		return uploadedAudioInfo{}, err
+	}
+	return info, nil
+}
+
+func detectUploadedAudio(
+	ctx context.Context,
+	adapter *uploadedAudioAdapter,
+	rawURL string,
+	head uploadedRangeResponse,
+	meta uploadedWebPlaybackMetadata,
+) (uploadedAudioInfo, error) {
+	if len(head.body) == 0 {
+		return uploadedAudioInfo{}, fmt.Errorf("library asset is empty")
+	}
+	if info, ok, err := detectMP3(ctx, adapter, rawURL, head, meta); ok || err != nil {
+		return info, err
+	}
+	if info, ok, err := detectMP4(ctx, adapter, rawURL, head, meta); ok || err != nil {
+		return info, err
+	}
+	return uploadedAudioInfo{}, fmt.Errorf("library asset container is not supported")
+}
+
+func detectMP3(
+	ctx context.Context,
+	adapter *uploadedAudioAdapter,
+	rawURL string,
+	head uploadedRangeResponse,
+	meta uploadedWebPlaybackMetadata,
+) (uploadedAudioInfo, bool, error) {
+	data := head.body
+	if !bytes.HasPrefix(data, []byte("ID3")) {
+		if _, ok := parseMP3Frame(data); !ok {
+			return uploadedAudioInfo{}, false, nil
+		}
+	}
+	audioOffset, hasID3, err := id3AudioOffset(data)
+	if err != nil {
+		return uploadedAudioInfo{}, true, err
+	}
+	frameData := data
+	if hasID3 && int(audioOffset) >= len(data) {
+		more, err := adapter.fetchUploadedRange(ctx, rawURL, audioOffset, audioOffset+(63<<10))
+		if err != nil {
+			return uploadedAudioInfo{}, true, err
+		}
+		frameData = more.body
+	} else if hasID3 {
+		frameData = data[audioOffset:]
+	}
+	frame, ok := parseMP3Frame(frameData)
+	if !ok {
+		return uploadedAudioInfo{}, true, fmt.Errorf("MP3 asset has no valid audio frame after its ID3 tag")
+	}
+	infoDurationMs, hasInfoDuration := mp3InfoFrameDuration(frameData, frame)
+	audioFrame := frame
+	if hasInfoDuration {
+		audioFrame, ok = nextMP3AudioFrame(frameData, frame)
+		if !ok {
+			return uploadedAudioInfo{}, true, fmt.Errorf("MP3 Info frame has no following audio frame")
+		}
+	}
+	ext := strings.ToLower(strings.TrimSpace(meta.FileExtension))
+	if ext != "" && ext != "mp3" {
+		return uploadedAudioInfo{}, true, fmt.Errorf("asset extension %q disagrees with MP3 headers", ext)
+	}
+	if meta.BitRate > 0 && !hasInfoDuration {
+		expected := normalizeMetadataBitRate(meta.BitRate)
+		if expected != frame.bitRate {
+			return uploadedAudioInfo{}, true, fmt.Errorf(
+				"asset metadata bitrate %d disagrees with MP3 frame (%d)", expected, frame.bitRate)
+		}
+	}
+	if head.total > 0 && audioFrame.bitRate > 0 {
+		audioBytes := head.total - audioOffset
+		if audioBytes > 0 {
+			declaredMs := int(meta.Duration)
+			if hasInfoDuration {
+				declaredMs = infoDurationMs
+			}
+			estimatedMs := int(audioBytes * 8 * 1000 / int64(audioFrame.bitRate))
+			tolerance := max(10_000, declaredMs/5)
+			if absInt(estimatedMs-declaredMs) > tolerance {
+				return uploadedAudioInfo{}, true, fmt.Errorf(
+					"MP3 byte length implies %dms but the stream declares %dms", estimatedMs, declaredMs)
+			}
+		}
+	}
+	return uploadedAudioInfo{
+		Codec:        pipeline.CodecMP3,
+		Container:    "mp3",
+		Extension:    "mp3",
+		MIMEType:     "audio/mpeg",
+		SampleRate:   audioFrame.sampleRate,
+		BitRate:      audioFrame.bitRate,
+		ChannelCount: audioFrame.channels,
+		DurationMs:   infoDurationMs,
+	}, true, nil
+}
+
+func detectMP4(
+	ctx context.Context,
+	adapter *uploadedAudioAdapter,
+	rawURL string,
+	head uploadedRangeResponse,
+	meta uploadedWebPlaybackMetadata,
+) (uploadedAudioInfo, bool, error) {
+	if len(head.body) < 8 || string(head.body[4:8]) != "ftyp" {
+		return uploadedAudioInfo{}, false, nil
+	}
+	plan, err := planUploadedMP4Clients(ctx, adapter.apiClient, adapter.streamClient, rawURL)
+	if err != nil {
+		return uploadedAudioInfo{}, true, err
+	}
+	info, mediaDuration, err := audioInfoFromMoov(plan.moov)
+	if err != nil {
+		return uploadedAudioInfo{}, true, err
+	}
+	if mediaDuration > 0 {
+		declared := int(meta.Duration)
+		if int64(absInt(mediaDuration-declared)) > uploadedDurationSlackMs {
+			return uploadedAudioInfo{}, true, fmt.Errorf(
+				"MP4 duration %dms disagrees with asset metadata (%dms)", mediaDuration, declared)
+		}
+	}
+	info.Container = "mp4"
+	info.Extension = "m4a"
+	info.mp4Plan = plan
+	info.BitRate = normalizeMetadataBitRate(meta.BitRate)
+	return info, true, nil
+}
+
+func audioInfoFromMoov(moov *mp4.MoovBox) (uploadedAudioInfo, int, error) {
+	var mediaDuration int
+	if moov.Mvhd != nil {
+		mediaDuration = roundMillis(moov.Mvhd.Duration, uint64(moov.Mvhd.Timescale))
+	}
+	for _, trak := range moov.Traks {
+		if trak.Mdia == nil || trak.Mdia.Hdlr == nil || trak.Mdia.Hdlr.HandlerType != "soun" ||
+			trak.Mdia.Minf == nil || trak.Mdia.Minf.Stbl == nil || trak.Mdia.Minf.Stbl.Stsd == nil {
+			continue
+		}
+		if trak.Mdia.Mdhd != nil {
+			mediaDuration = roundMillis(trak.Mdia.Mdhd.Duration, uint64(trak.Mdia.Mdhd.Timescale))
+		}
+		for _, sampleEntry := range trak.Mdia.Minf.Stbl.Stsd.Children {
+			switch sampleEntry.Type() {
+			case "mp4a":
+				entry, ok := sampleEntry.(*mp4.AudioSampleEntryBox)
+				if !ok {
+					return uploadedAudioInfo{}, 0, fmt.Errorf("MP4 mp4a sample entry is malformed")
+				}
+				return uploadedAudioInfo{
+					Codec:        pipeline.CodecAAC,
+					MIMEType:     "audio/mp4",
+					SampleRate:   int(entry.SampleRate),
+					ChannelCount: int(entry.ChannelCount),
+				}, mediaDuration, nil
+			case "alac":
+				entry, ok := sampleEntry.(*mp4.UnknownBox)
+				if !ok {
+					return uploadedAudioInfo{}, 0, fmt.Errorf("MP4 alac sample entry is malformed")
+				}
+				info, err := parseALACSampleEntry(entry.Payload())
+				return info, mediaDuration, err
+			case "enca":
+				return uploadedAudioInfo{}, 0, fmt.Errorf("uploaded MP4 unexpectedly contains encrypted audio")
+			}
+		}
+	}
+	return uploadedAudioInfo{}, 0, fmt.Errorf("MP4 source has no supported audio sample entry")
+}
+
+func parseALACSampleEntry(payload []byte) (uploadedAudioInfo, error) {
+	// The UnknownBox payload starts after the sample-entry box header. The
+	// 28-byte ISO audio sample entry precedes the nested ALAC configuration.
+	if len(payload) < 28+12+24 {
+		return uploadedAudioInfo{}, fmt.Errorf("ALAC sample entry is truncated")
+	}
+	channelCount := int(readUint16(payload[16:18]))
+	entryRate := int(readUint32(payload[24:28]) >> 16)
+	cookieSize := int(readUint32(payload[28:32]))
+	if cookieSize < 8 || cookieSize > len(payload)-28 || string(payload[32:36]) != "alac" {
+		return uploadedAudioInfo{}, fmt.Errorf("ALAC sample entry has no ALAC configuration")
+	}
+	config := payload[36 : 28+cookieSize]
+	if len(config) < 24 {
+		return uploadedAudioInfo{}, fmt.Errorf("ALAC configuration is truncated")
+	}
+	bitDepth := int(config[5])
+	cookieChannels := int(config[9])
+	cookieRate := int(readUint32(config[20:24]))
+	if channelCount > 0 && cookieChannels > 0 && channelCount != cookieChannels {
+		return uploadedAudioInfo{}, fmt.Errorf("ALAC channel count disagrees between sample entry and configuration")
+	}
+	// The ISO audio sample-entry field stores the integer sample rate in 16
+	// bits, so hi-res ALAC rates cannot be represented there. The ALAC magic
+	// cookie is authoritative whenever the rate exceeds uint16.
+	if cookieRate > 0 && cookieRate <= 0xffff && entryRate > 0 && entryRate != cookieRate {
+		return uploadedAudioInfo{}, fmt.Errorf("ALAC sample rate disagrees between sample entry and configuration")
+	}
+	if bitDepth != 16 && bitDepth != 20 && bitDepth != 24 && bitDepth != 32 {
+		return uploadedAudioInfo{}, fmt.Errorf("ALAC configuration has unsupported bit depth %d", bitDepth)
+	}
+	return uploadedAudioInfo{
+		Codec:        pipeline.CodecALAC,
+		MIMEType:     `audio/mp4; codecs="alac"`,
+		SampleRate:   cookieRate,
+		BitDepth:     bitDepth,
+		ChannelCount: cookieChannels,
+	}, nil
+}
+
+func id3AudioOffset(data []byte) (int64, bool, error) {
+	if len(data) < 10 || !bytes.HasPrefix(data, []byte("ID3")) {
+		return 0, false, nil
+	}
+	if data[3] < 2 || data[3] > 4 || data[4] == 0xff {
+		return 0, true, fmt.Errorf("MP3 asset has unsupported ID3 version")
+	}
+	size := int64(data[6]&0x7f)<<21 | int64(data[7]&0x7f)<<14 |
+		int64(data[8]&0x7f)<<7 | int64(data[9]&0x7f)
+	offset := int64(10) + size
+	if data[5]&0x10 != 0 {
+		offset += 10
+	}
+	if offset < 10 || offset > uploadedAssetSizeLimit {
+		return 0, true, fmt.Errorf("MP3 asset has invalid ID3 size")
+	}
+	return offset, true, nil
+}
+
+type mp3FrameInfo struct {
+	sampleRate      int
+	bitRate         int
+	channels        int
+	version         int
+	frameSize       int
+	samplesPerFrame int
+}
+
+func parseMP3Frame(data []byte) (mp3FrameInfo, bool) {
+	const (
+		mpeg1  = 3
+		mpeg2  = 2
+		mpeg25 = 0
+	)
+	bitrates := map[int][15]int{
+		mpeg1:  {0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320},
+		mpeg2:  {0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160},
+		mpeg25: {0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160},
+	}
+	rates := map[int][3]int{
+		mpeg1:  {44100, 48000, 32000},
+		mpeg2:  {22050, 24000, 16000},
+		mpeg25: {11025, 12000, 8000},
+	}
+	for i := 0; i+4 <= len(data); i++ {
+		h := uint32(data[i])<<24 | uint32(data[i+1])<<16 | uint32(data[i+2])<<8 | uint32(data[i+3])
+		if h&0xffe00000 != 0xffe00000 {
+			continue
+		}
+		version := int((h >> 19) & 3)
+		layer := int((h >> 17) & 3)
+		bitrateIndex := int((h >> 12) & 0xf)
+		rateIndex := int((h >> 10) & 3)
+		if version == 1 || layer != 1 || bitrateIndex == 0 || bitrateIndex == 15 || rateIndex == 3 {
+			continue
+		}
+		bitRate := bitrates[version][bitrateIndex] * 1000
+		sampleRate := rates[version][rateIndex]
+		channels := 2
+		if ((h >> 6) & 3) == 3 {
+			channels = 1
+		}
+		padding := int((h >> 9) & 1)
+		frameSize := 72*bitRate/sampleRate + padding
+		samplesPerFrame := 576
+		if version == mpeg1 {
+			frameSize = 144*bitRate/sampleRate + padding
+			samplesPerFrame = 1152
+		}
+		return mp3FrameInfo{
+			sampleRate:      sampleRate,
+			bitRate:         bitRate,
+			channels:        channels,
+			version:         version,
+			frameSize:       frameSize,
+			samplesPerFrame: samplesPerFrame,
+		}, true
+	}
+	return mp3FrameInfo{}, false
+}
+
+func mp3InfoFrameDuration(data []byte, frame mp3FrameInfo) (int, bool) {
+	if frame.frameSize <= 4 || frame.frameSize > len(data) || frame.sampleRate <= 0 ||
+		frame.samplesPerFrame <= 0 {
+		return 0, false
+	}
+	sideInfoBytes := 17
+	if frame.version == 3 {
+		sideInfoBytes = 32
+	}
+	if frame.channels == 1 {
+		if frame.version == 3 {
+			sideInfoBytes = 17
+		} else {
+			sideInfoBytes = 9
+		}
+	}
+	firstFrame := data[:frame.frameSize]
+	for _, offset := range []int{4 + sideInfoBytes, 6 + sideInfoBytes} {
+		if offset+12 > len(firstFrame) {
+			continue
+		}
+		tag := string(firstFrame[offset : offset+4])
+		if tag != "Xing" && tag != "Info" {
+			continue
+		}
+		flags := readUint32(firstFrame[offset+4 : offset+8])
+		if flags&1 == 0 {
+			return 0, false
+		}
+		frames := uint64(readUint32(firstFrame[offset+8 : offset+12]))
+		if frames == 0 {
+			return 0, false
+		}
+		durationMs := int(math.Round(
+			float64(frames) * float64(frame.samplesPerFrame) * 1000 / float64(frame.sampleRate)))
+		return durationMs, durationMs > 0
+	}
+	return 0, false
+}
+
+func nextMP3AudioFrame(data []byte, control mp3FrameInfo) (mp3FrameInfo, bool) {
+	if control.frameSize <= 0 || control.frameSize >= len(data) {
+		return mp3FrameInfo{}, false
+	}
+	frame, ok := parseMP3Frame(data[control.frameSize:])
+	if !ok || frame.sampleRate != control.sampleRate {
+		return mp3FrameInfo{}, false
+	}
+	return frame, true
+}
+
+func validateUploadedQuality(meta uploadedWebPlaybackMetadata, info uploadedAudioInfo) error {
+	ext := strings.ToLower(strings.TrimSpace(meta.FileExtension))
+	switch info.Codec {
+	case pipeline.CodecMP3:
+		if ext != "" && ext != "mp3" {
+			return fmt.Errorf("asset extension %q disagrees with MP3 headers", ext)
+		}
+	case pipeline.CodecAAC, pipeline.CodecALAC:
+		if ext != "" && ext != "m4a" && ext != "mp4" && ext != "aac" && ext != "alac" {
+			return fmt.Errorf("asset extension %q disagrees with MP4 headers", ext)
+		}
+	default:
+		return fmt.Errorf("uploaded codec %q is unsupported", info.Codec)
+	}
+	if meta.SampleRate > 0 && info.SampleRate > 0 && meta.SampleRate != info.SampleRate {
+		return fmt.Errorf("asset metadata sample rate %d disagrees with headers (%d)", meta.SampleRate, info.SampleRate)
+	}
+	if meta.BitDepth > 0 && info.BitDepth > 0 && meta.BitDepth != info.BitDepth {
+		return fmt.Errorf("asset metadata bit depth %d disagrees with headers (%d)", meta.BitDepth, info.BitDepth)
+	}
+	return nil
+}
+
+func normalizeMetadataBitRate(value int) int {
+	if value > 0 && value < 10_000 {
+		return value * 1000
+	}
+	return value
+}
+
+type uploadedAudioSource struct {
+	client  *http.Client
+	url     string
+	length  int64
+	mp4Plan *uploadedMP4Plan
+}
+
+func uploadedAudioSourceVersion(info uploadedAudioInfo) string {
+	if info.mp4Plan != nil {
+		return info.mp4Plan.sourceVersion()
+	}
+	return ""
+}
+
+func (s *uploadedAudioSource) Stream(ctx context.Context, w io.Writer) error {
+	if s.mp4Plan != nil {
+		plan := *s.mp4Plan
+		plan.remote.client = s.client
+		return plan.Stream(ctx, w)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, s.url, nil)
+	if err != nil {
+		return err
+	}
+	resp, err := s.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("uploaded audio request failed: %w", sanitizedTransportError(err))
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("uploaded audio HTTP %d", resp.StatusCode)
+	}
+	length := s.length
+	if resp.ContentLength >= 0 {
+		if length > 0 && resp.ContentLength != length {
+			return fmt.Errorf(
+				"uploaded audio length %d disagrees with probed length %d",
+				resp.ContentLength, length)
+		}
+		length = resp.ContentLength
+	}
+	if length > uploadedAssetSizeLimit {
+		return fmt.Errorf("uploaded audio exceeds the %d byte limit", uploadedAssetSizeLimit)
+	}
+	if hw, ok := w.(pipeline.HeaderWriter); ok {
+		if contentType := strings.TrimSpace(resp.Header.Get("Content-Type")); contentType != "" {
+			hw.SetHeader("Content-Type", contentType)
+		}
+		if length >= 0 {
+			hw.SetHeader("Content-Length", strconv.FormatInt(length, 10))
+		}
+	}
+	reader := io.Reader(resp.Body)
+	if length < 0 {
+		reader = &maxBytesReader{r: resp.Body, remaining: uploadedAssetSizeLimit + 1}
+	}
+	n, err := io.CopyBuffer(w, reader, make([]byte, 64<<10))
+	if err != nil {
+		return fmt.Errorf("uploaded audio stream: %w", err)
+	}
+	if n > uploadedAssetSizeLimit {
+		return fmt.Errorf("uploaded audio exceeds the %d byte limit", uploadedAssetSizeLimit)
+	}
+	if length >= 0 && n != length {
+		return fmt.Errorf("uploaded audio ended after %d of %d bytes", n, length)
+	}
+	return nil
+}
+
+type maxBytesReader struct {
+	r         io.Reader
+	remaining int64
+}
+
+func (r *maxBytesReader) Read(p []byte) (int, error) {
+	if r.remaining <= 0 {
+		return 0, errors.New("uploaded audio exceeds byte limit")
+	}
+	if int64(len(p)) > r.remaining {
+		p = p[:r.remaining]
+	}
+	n, err := r.r.Read(p)
+	r.remaining -= int64(n)
+	return n, err
+}
+
+func roundMillis(mediaTime, timescale uint64) int {
+	if timescale == 0 {
+		return 0
+	}
+	return int(math.Round(float64(mediaTime) * 1000 / float64(timescale)))
+}
+
+func readUint16(b []byte) uint16 {
+	return uint16(b[0])<<8 | uint16(b[1])
+}
+
+func readUint32(b []byte) uint32 {
+	return uint32(b[0])<<24 | uint32(b[1])<<16 | uint32(b[2])<<8 | uint32(b[3])
+}
+
+func absInt(v int) int {
+	if v < 0 {
+		return -v
+	}
+	return v
+}
+
+func firstNonempty(values ...string) string {
+	for _, value := range values {
+		if value = strings.TrimSpace(value); value != "" {
+			return value
+		}
+	}
+	return ""
+}
+
+func sanitizedTransportError(err error) error {
+	var urlErr *url.Error
+	if errors.As(err, &urlErr) && urlErr.Err != nil {
+		return urlErr.Err
+	}
+	return err
+}
