+
+func (f *uploadedHTTPFixture) RoundTrip(r *http.Request) (*http.Response, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	switch r.URL.Host {
+	case "play.music.apple.com":
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			return nil, err
+		}
+		f.playbackRequest = append([]byte(nil), body...)
+		f.playbackHeaders = r.Header.Clone()
+		status := f.playbackStatus
+		if status == 0 {
+			status = http.StatusOK
+		}
+		return testHTTPResponse(r, status, f.playbackBody, "application/json"), nil
+	case "store-001.blobstore.apple.com":
+		f.assetRequests++
+		f.assetHeaders = append(f.assetHeaders, r.Header.Clone())
+		if f.assetErr != nil {
+			return nil, f.assetErr
+		}
+		status := f.assetStatus
+		if status == 0 {
+			status = http.StatusOK
+		}
+		if status != http.StatusOK {
+			return testHTTPResponse(r, status, nil, ""), nil
+		}
+		body := f.assetBody
+		start, end, hasRange := parseTestRange(r.Header.Get("Range"), int64(len(body)))
+		if hasRange {
+			body = body[start : end+1]
+			status = http.StatusPartialContent
+		}
+		resp := testHTTPResponse(r, status, body, f.assetType)
+		if hasRange {
+			resp.Header.Set("Content-Range", fmt.Sprintf("bytes %d-%d/%d", start, end, f.assetRequestsLength()))
+		}
+		return resp, nil
+	default:
+		return nil, fmt.Errorf("unexpected mocked host")
+	}
+}
+
+func (f *uploadedHTTPFixture) assetRequestsLength() int {
+	return len(f.assetBody)
+}
+
+func testHTTPResponse(req *http.Request, status int, body []byte, contentType string) *http.Response {
+	resp := &http.Response{
+		StatusCode:    status,
+		Status:        http.StatusText(status),
+		Header:        make(http.Header),
+		Body:          io.NopCloser(bytes.NewReader(body)),
+		ContentLength: int64(len(body)),
+		Request:       req,
+	}
+	if contentType != "" {
+		resp.Header.Set("Content-Type", contentType)
+	}
+	return resp
+}
+
+func parseTestRange(value string, total int64) (int64, int64, bool) {
+	if !strings.HasPrefix(value, "bytes=") {
+		return 0, 0, false
+	}
+	left, right, ok := strings.Cut(strings.TrimPrefix(value, "bytes="), "-")
+	if !ok {
+		return 0, 0, false
+	}
+	start, err1 := strconv.ParseInt(left, 10, 64)
+	end, err2 := strconv.ParseInt(right, 10, 64)
+	if err1 != nil || err2 != nil || start < 0 || end < start || start >= total {
+		return 0, 0, false
+	}
+	if end >= total {
+		end = total - 1
+	}
+	return start, end, true
+}
