+func extractALACQuality(traits []string) (sampleRate, bitDepth int) {
+	for _, t := range traits {
+		lower := strings.ToLower(t)
+		if !strings.Contains(lower, "lossless") && !strings.Contains(lower, "alac") {
+			continue
+		}
+		parts := strings.FieldsFunc(t, func(r rune) bool { return r == '-' || r == '_' })
+		for i := 0; i+1 < len(parts); i++ {
+			rate, rateErr := strconv.Atoi(parts[i])
+			depth, depthErr := strconv.Atoi(parts[i+1])
+			if rateErr != nil || depthErr != nil {
+				continue
+			}
+			if rate == 44 || rate == 48 || rate == 88 || rate == 96 || rate == 176 || rate == 192 {
+				rate *= 1000
+			}
+			switch rate {
+			case 44100, 48000, 88200, 96000, 176400, 192000:
+			default:
+				continue
+			}
+			if depth != 16 && depth != 24 {
+				continue
+			}
+			return rate, depth
+		}
+	}
+	return 0, 0
+}
+
+type songFormat struct {
+	Codec         pipeline.Codec
+	PlaylistURL   string
+	SampleRate    int
+	BitDepth      int
+	FallbackToAAC bool
+}
+
+// selectSongFormat chooses from evidence present in the catalog response and
+// the successfully parsed HLS master. A nil master means the catalog supplied
+// no enhanced HLS URL. In that one content-level case a requested lossless
+// format may explicitly fall back to AAC; callers must not pass nil after an
+// HLS fetch error.
+func selectSongFormat(req media.OpenRequest, traits map[string]bool, master *hls.Master, audioTraits []string) (songFormat, error) {
+	if req.Atmos {
+		if !traits["atmos"] {
+			return songFormat{}, fmt.Errorf("atmos requested, but the catalog says the track has no Atmos format")
+		}
+		if master == nil {
+			return songFormat{}, fmt.Errorf("atmos requested, but the catalog supplied no enhanced HLS URL")
+		}
+		v, ok := master.SelectVariantByCodec("ec-3")
+		if !ok {
+			return songFormat{}, fmt.Errorf("atmos requested, but the HLS master has no ec-3 variant")
+		}
+		return songFormat{
+			Codec:       pipeline.CodecAtmos,
+			PlaylistURL: v.URL,
+			SampleRate:  v.AudioSampleRate,
+			BitDepth:    v.AudioBitDepth,
+		}, nil
+	}
+
+	if req.PreferAtmos && traits["atmos"] && master != nil {
+		if v, ok := master.SelectVariantByCodec("ec-3"); ok {
+			return songFormat{
+				Codec:       pipeline.CodecAtmos,
+				PlaylistURL: v.URL,
+				SampleRate:  v.AudioSampleRate,
+				BitDepth:    v.AudioBitDepth,
+			}, nil
+		}
+		if master.HasCodec("ec-3") {
+			return songFormat{}, fmt.Errorf("atmos preferred, but every EC-3 variant is unsupported")
+		}
+	}
+
+	if req.Lossless && master != nil {
+		v, ok := master.SelectVariantByCodec("alac")
+		if !req.HiRes {
+			// Apple Music's "Lossless" tier: the best ALAC up to 48 kHz. A master with
+			// only hi-res (or unlabelled) ALAC variants keeps the best one it has.
+			if capped, okCapped := master.SelectVariantByCodecUpTo("alac", 48000); okCapped {
+				v, ok = capped, true
+			}
+		}
+		if ok {
+			sr, bd := v.AudioSampleRate, v.AudioBitDepth
+			if sr == 0 && bd == 0 {
+				sr, bd = extractALACQuality(audioTraits)
+			}
+			return songFormat{
+				Codec:       pipeline.CodecALAC,
+				PlaylistURL: v.URL,
+				SampleRate:  sr,
+				BitDepth:    bd,
+			}, nil
+		}
+		if master.HasCodec("alac") {
+			return songFormat{}, fmt.Errorf("lossless requested, but every ALAC variant is outside the supported 24-bit/192kHz ceiling")
+		}
+	}
+	if req.Lossless && master == nil && (traits["lossless"] || traits["hi-res-lossless"]) {
+		return songFormat{}, fmt.Errorf("lossless requested and advertised, but the catalog supplied no enhanced HLS URL")
+	}
+
+	return songFormat{Codec: pipeline.CodecAAC, FallbackToAAC: req.Lossless}, nil
+}
+
 func fmtArtwork(template string, size int) string {
 	s := strconv.Itoa(size)
 	return strings.ReplaceAll(strings.ReplaceAll(template, "{w}", s), "{h}", s)
