+type mp4RoundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f mp4RoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestUploadedMP4NonRangeScanUsesStreamingClient(t *testing.T) {
+	f := &uploadedMP4Fixture{data: uploadedLocalAAC(t, "aac-48.m4a"), ignoreRange: true}
+	server := httptest.NewServer(http.HandlerFunc(f.handler))
+	defer server.Close()
+	transport := server.Client().Transport
+	metadataRequests, fullRequests := 0, 0
+	metadata := &http.Client{Transport: mp4RoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		metadataRequests++
+		if r.Header.Get("Range") == "" {
+			t.Error("Full scan used metadata timeout")
+		}
+		return transport.RoundTrip(r)
+	})}
+	stream := &http.Client{Transport: mp4RoundTripFunc(func(r *http.Request) (*http.Response, error) { fullRequests++; return transport.RoundTrip(r) })}
+	p, err := planUploadedMP4Clients(context.Background(), metadata, stream, server.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !p.sequentialIndex || metadataRequests != 1 || fullRequests != 1 {
+		t.Fatal("Non-range discovery did not switch to bounded-memory streaming")
+	}
+}
