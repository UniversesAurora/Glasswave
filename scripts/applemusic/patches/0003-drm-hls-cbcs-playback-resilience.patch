+	}
+	preferSession, err := m.Open(context.Background(), prefer)
+	if err != nil {
+		t.Fatalf("Open preferAtmos: %v", err)
+	}
+	if regularSession.ID == preferSession.ID {
+		t.Fatal("a non-Atmos preference session must not be reused for preferAtmos")
+	}
+	if p.calls != 2 {
+		t.Fatalf("provider calls = %d, want 2", p.calls)
+	}
