+func (b *adamplayBackend) waitForAccountContext(ctx context.Context) error {
+	waitCtx, cancel := context.WithTimeout(ctx, accountContextInitTimeout)
+	defer cancel()
+
+	b.mu.Lock()
+	running := b.running
+	ready := b.hybrisReady
+	initDone := b.hybrisInitDone
+	b.mu.Unlock()
+	if !running {
+		return errBackendStopped
+	}
+	if ready {
+		return nil
+	}
+	if initDone == nil {
+		return errAccountContextUnavailable
+	}
+
+	select {
+	case <-initDone:
+	case <-waitCtx.Done():
+		return fmt.Errorf("%w: %v", errAccountContextUnavailable, waitCtx.Err())
+	}
+
+	b.mu.Lock()
+	running = b.running
+	ready = b.hybrisReady
+	b.mu.Unlock()
+	if !running {
+		return errBackendStopped
+	}
+	if !ready {
+		return errAccountContextUnavailable
+	}
+	return nil
+}
