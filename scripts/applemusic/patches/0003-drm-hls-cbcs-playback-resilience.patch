+func TestWaitForAccountContextWaitsForSessionReuseInit(t *testing.T) {
+	done := make(chan struct{})
+	b := &adamplayBackend{running: true, hybrisInitDone: done}
+	go func() {
+		time.Sleep(20 * time.Millisecond)
+		b.mu.Lock()
+		b.hybrisReady = true
+		b.mu.Unlock()
+		close(done)
+	}()
+
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := b.waitForAccountContext(ctx); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestWaitForAccountContextFailsClosedAfterInitFailure(t *testing.T) {
+	done := make(chan struct{})
+	close(done)
+	b := &adamplayBackend{running: true, hybrisInitDone: done}
+
+	if err := b.waitForAccountContext(context.Background()); !errors.Is(err, errAccountContextUnavailable) {
+		t.Fatalf("want account context unavailable, got %v", err)
+	}
+}
