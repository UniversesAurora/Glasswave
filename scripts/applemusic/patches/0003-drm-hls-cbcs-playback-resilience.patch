+// audioGroupByURI maps each variant URI in a master playlist to its AUDIO
+// group identifier. The m3u8 library does not expose that attribute.
+func audioGroupByURI(master string) map[string]string {
+	out := map[string]string{}
+	pending := ""
+	for _, raw := range strings.Split(master, "\n") {
+		line := strings.TrimSpace(raw)
+		switch {
+		case strings.HasPrefix(line, "#EXT-X-STREAM-INF:"):
+			pending = ""
+			if m := audioGroupRe.FindStringSubmatch(line); m != nil {
+				pending = m[1]
+			}
+		case line == "" || strings.HasPrefix(line, "#"):
+		default:
+			if pending != "" {
+				out[line] = pending
+			}
+			pending = ""
+		}
+	}
+	return out
+}
+
+// audioGroupQuality decodes the quality suffix Apple uses in AUDIO group IDs.
+// Values outside the supported ALAC ceiling (24-bit/192 kHz) and unrecognised
+// sample rates are left unknown instead of being rounded or guessed.
+func audioGroupQuality(group string) (sampleRate, bitDepth int, unsupported bool) {
+	m := audioQualityRe.FindStringSubmatch(strings.ToLower(group))
+	if len(m) != 3 {
+		return 0, 0, false
+	}
+	var rate, depth int
+	if n, err := fmt.Sscanf(m[1], "%d", &rate); n != 1 || err != nil {
+		return 0, 0, true
+	}
+	if n, err := fmt.Sscanf(m[2], "%d", &depth); n != 1 || err != nil {
+		return 0, 0, true
+	}
+	switch rate {
+	case 44, 48, 88, 96, 176, 192:
+		rate *= 1000
+	}
+	switch rate {
+	case 44100, 48000, 88200, 96000, 176400, 192000:
+	default:
+		return 0, 0, true
+	}
+	if depth != 16 && depth != 24 {
+		return 0, 0, true
+	}
+	return rate, depth, false
+}
