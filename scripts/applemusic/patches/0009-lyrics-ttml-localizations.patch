+func TestSyllableReplacementZhHansReplacesMainWithSpans(t *testing.T) {
+	ttml := `<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:lang="zh-Hant" itunes:timing="Word">
+<head><metadata><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
+<translations>
+  <translation type="replacement" xml:lang="zh-Hans">
+    <text for="L1"><span begin="44.61" end="45.07">竹</span><span begin="45.07" end="45.90">林的灯</span><span begin="45.90" end="46.35">火</span> <span begin="46.35" end="46.73">岛</span><span begin="46.73" end="47.53">国的沙</span><span begin="47.53" end="47.95">漠</span></text>
+  </translation>
+</translations>
+</iTunesMetadata></metadata></head>
+<body><div>
+  <p begin="44.61" end="47.95" itunes:key="L1"><span begin="44.61" end="45.07">竹</span><span begin="45.07" end="45.90">林的燈</span><span begin="45.90" end="46.35">火</span> <span begin="46.35" end="46.73">島</span><span begin="46.73" end="47.53">國的沙</span><span begin="47.53" end="47.95">漠</span></p>
+</div></body></tt>`
+
+	got, err := TtmlToLrcWithLocale(ttml, "zh-Hans-CN")
+	if err != nil {
+		t.Fatalf("TtmlToLrcWithLocale error: %v", err)
+	}
+	want := "[00:44.61]<00:44.61>竹<00:45.07>林的灯<00:45.90>火 <00:46.35>岛<00:46.73>国的沙<00:47.53>漠<00:47.95>"
+	if got != want {
+		t.Fatalf("got:\n%s\nwant:\n%s", got, want)
+	}
+
+	// Non-matching locale (ja-JP) must NOT apply zh-Hans replacement.
+	gotJa, err := TtmlToLrcWithLocale(ttml, "ja-JP")
+	if err != nil {
+		t.Fatalf("TtmlToLrcWithLocale(ja-JP) error: %v", err)
+	}
+	if !strings.Contains(gotJa, "林的燈") || strings.Contains(gotJa, "[gw:tr]") {
+		t.Fatalf("ja-JP unexpectedly applied zh-Hans replacement or blank subtitle: %q", gotJa)
+	}
+}
+
+func TestSyllablePreservesOriginalTranslationAndPronunciation(t *testing.T) {
+	ttml := `<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:lang="ja" itunes:timing="Word">
+<head><metadata><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
+<translations>
+  <translation type="subtitle" xml:lang="en-US">
+    <text for="L1">This is a test</text>
+  </translation>
+  <translation type="subtitle" xml:lang="zh-Hans-CN">
+    <text for="L1"><span begin="10.00" end="11.80">这是一个测试</span></text>
+  </translation>
+</translations>
+<transliterations>
+  <transliteration xml:lang="ja-Latn">
+    <text for="L1"><span begin="10.02" end="10.50">Ko</span><span begin="10.50" end="10.80">re</span> <span begin="10.80" end="11.00">wa</span> <span begin="11.20" end="11.80">tesuto</span></text>
+  </transliteration>
+</transliterations>
+</iTunesMetadata></metadata></head>
+<body><div>
+  <p begin="10.00" end="11.80" itunes:key="L1"><span begin="10.00" end="10.50">これ</span><span begin="10.50" end="10.80">は</span> <span begin="11.20" end="11.80">テスト</span></p>
+</div></body></tt>`
+
+	got, err := TtmlToLrcWithLocale(ttml, "zh-Hans-CN")
+	if err != nil {
+		t.Fatalf("TtmlToLrcWithLocale error: %v", err)
+	}
+	wantLines := []string{
+		"[00:10.00]<00:10.00>これ<00:10.50>は <00:11.20>テスト<00:11.80>",
+		"[00:10.00][gw:tr]这是一个测试",
+		"[00:10.00][gw:ro]<00:10.02>Ko<00:10.50>re <00:10.80>wa <00:11.20>tesuto<00:11.80>",
+	}
+	want := strings.Join(wantLines, "\n")
+	if got != want {
+		t.Fatalf("got:\n%s\nwant:\n%s", got, want)
+	}
+}
