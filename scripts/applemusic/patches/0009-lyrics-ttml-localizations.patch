+func normalizeLocaleParts(tag string) (lang, script, region string) {
+	tag = strings.ToLower(strings.TrimSpace(strings.ReplaceAll(tag, "_", "-")))
+	if tag == "" {
+		return "", "", ""
+	}
+	parts := strings.Split(tag, "-")
+	lang = parts[0]
+	for _, p := range parts[1:] {
+		if len(p) == 4 && script == "" {
+			script = p
+		} else if (len(p) == 2 || len(p) == 3) && region == "" {
+			region = p
+		}
+	}
+	if lang == "zh" && script == "" {
+		switch region {
+		case "cn", "sg":
+			script = "hans"
+		case "tw", "hk", "mo":
+			script = "hant"
+		}
+	}
+	return lang, script, region
+}
+
+func matchLocaleScore(candidate, wanted string) int {
+	cLang, cScript, cRegion := normalizeLocaleParts(candidate)
+	if wanted == "" {
+		return 1
+	}
+	wLang, wScript, wRegion := normalizeLocaleParts(wanted)
+	if cLang == "" || wLang == "" || cLang != wLang {
+		return 0
+	}
+	if cScript != "" && wScript != "" && cScript != wScript {
+		return 0
+	}
+	if cScript == wScript && cRegion == wRegion && cRegion != "" {
+		return 4
+	}
+	if cScript == wScript && cScript != "" {
+		return 3
+	}
+	return 2
+}
