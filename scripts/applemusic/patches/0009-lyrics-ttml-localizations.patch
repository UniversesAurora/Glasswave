+// buildSyllableSpans builds an enhanced-LRC line from timed <span> children of el.
+// If lineStamp is non-empty, it is used as the leading [mm:ss.cs] line timestamp so sidecar
+// tracks align identically with the main line even when individual span starts differ slightly.
+func buildSyllableSpans(el *etree.Element, lineStamp, roleTag string) (line string, firstStamp string, ok bool, err error) {
+	if el == nil {
+		return "", "", false, nil
+	}
+	var parts []string
+	var count int
+	var endTime string
+	for _, child := range el.Child {
+		if cd, isChar := child.(*etree.CharData); isChar {
+			if count > 0 && strings.ContainsAny(cd.Data, " \t\r\n") && len(parts) > 0 && parts[len(parts)-1] != " " {
+				parts = append(parts, " ")
+			}
+			continue
+		}
+		span, isElem := child.(*etree.Element)
+		if !isElem || isAuxiliaryRole(span) || span.SelectAttr("begin") == nil {
+			continue
+		}
+		beginVal := span.SelectAttrValue("begin", "")
+		endVal := span.SelectAttrValue("end", "")
+		if count == 0 {
+			firstStamp, err = parseSyllableTime(beginVal, -1)
+			if err != nil {
+				return "", "", false, err
+			}
+		}
+		wordBegin, err := parseSyllableTime(beginVal, 2)
+		if err != nil {
+			return "", "", false, err
+		}
+		if endVal != "" {
+			endTime, err = parseSyllableTime(endVal, 1)
+			if err != nil {
+				return "", "", false, err
+			}
+		}
+		var text string
+		if a := span.SelectAttr("text"); a != nil {
+			text = a.Value
+		} else {
+			text = extractPlainText(span)
+		}
+		parts = append(parts, wordBegin+text)
+		count++
+	}
+	if count == 0 {
+		return "", "", false, nil
+	}
+	for len(parts) > 0 && parts[len(parts)-1] == " " {
+		parts = parts[:len(parts)-1]
+	}
+	stamp := lineStamp
+	if stamp == "" {
+		stamp = firstStamp
+	}
+	return stamp + roleTag + strings.Join(parts, "") + endTime, stamp, true, nil
+}
+
+func formatTranslitLine(translitEl *etree.Element, key, lineStamp string) string {
+	if translitEl == nil || key == "" {
+		return ""
+	}
+	node := textFor(translitEl, ".//", key)
+	if node == nil {
+		return ""
+	}
+	if line, _, ok, err := buildSyllableSpans(node, lineStamp, "[gw:ro]"); err == nil && ok {
+		return line
+	}
+	if plain := strings.TrimSpace(extractPlainText(node)); plain != "" {
+		return lineStamp + "[gw:ro]" + plain
+	}
+	return ""
 }
 
