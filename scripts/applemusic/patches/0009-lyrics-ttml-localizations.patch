+func TestLineTimedReplacementTranslationAndPronunciation(t *testing.T) {
+	ttml := `<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:lang="ja" itunes:timing="Line">
+<head><metadata><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
+<translations>
+  <translation type="subtitle" xml:lang="zh-Hans-CN">
+    <text for="L1">你好世界</text>
+  </translation>
+</translations>
+<transliterations>
+  <transliteration xml:lang="ja-Latn">
+    <text for="L1">Konnichiwa sekai</text>
+  </transliteration>
+</transliterations>
+</iTunesMetadata></metadata></head>
+<body><div>
+  <p begin="5.00" end="8.00" itunes:key="L1">こんにちは世界</p>
+</div></body></tt>`
+
+	got, err := TtmlToLrcWithLocale(ttml, "zh-Hans-CN")
+	if err != nil {
+		t.Fatalf("TtmlToLrcWithLocale error: %v", err)
+	}
+	want := strings.Join([]string{
+		"[00:05.00]こんにちは世界",
+		"[00:05.00][gw:tr]你好世界",
+		"[00:05.00][gw:ro]Konnichiwa sekai",
+	}, "\n")
+	if got != want {
+		t.Fatalf("got:\n%s\nwant:\n%s", got, want)
+	}
+}
