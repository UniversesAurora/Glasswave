+func TestLocaleMatchingRespectsChineseScripts(t *testing.T) {
+	if matchLocaleScore("zh-Hans", "zh-Hans-CN") <= 0 {
+		t.Fatal("zh-Hans should match zh-Hans-CN")
+	}
+	if matchLocaleScore("zh-Hant", "zh-Hans-CN") != 0 {
+		t.Fatal("zh-Hant must not match zh-Hans-CN")
+	}
+	if matchLocaleScore("zh-TW", "zh-CN") != 0 {
+		t.Fatal("zh-TW must not match zh-CN")
+	}
+	if matchLocaleScore("ja", "ja-JP") <= 0 {
+		t.Fatal("ja should match ja-JP")
+	}
+}
