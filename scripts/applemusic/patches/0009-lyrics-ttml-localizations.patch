+func selectTranslation(itunesMeta *etree.Element, wantedLocale, wantType string) *etree.Element {
+	if itunesMeta == nil {
+		return nil
+	}
+	trs := itunesMeta.FindElement("translations")
+	if trs == nil {
+		return nil
+	}
+	var candidates []*etree.Element
+	for _, tr := range trs.FindElements("translation") {
+		trType := strings.TrimSpace(tr.SelectAttrValue("type", ""))
+		if wantType == "replacement" {
+			if !strings.EqualFold(trType, "replacement") {
+				continue
+			}
+		} else {
+			if trType != "" && !strings.EqualFold(trType, "subtitle") {
+				continue
+			}
+		}
+		candidates = append(candidates, tr)
+	}
+	if len(candidates) == 0 {
+		return nil
+	}
+	var best *etree.Element
+	bestScore := 0
+	for _, tr := range candidates {
+		lang := tr.SelectAttrValue("xml:lang", "")
+		if lang == "" {
+			lang = tr.SelectAttrValue("lang", "")
+		}
+		score := matchLocaleScore(lang, wantedLocale)
+		if score > bestScore {
+			bestScore = score
+			best = tr
+		}
+	}
+	if best != nil {
+		return best
+	}
+	if wantType != "replacement" && len(candidates) == 1 {
+		return candidates[0]
+	}
+	return nil
+}
