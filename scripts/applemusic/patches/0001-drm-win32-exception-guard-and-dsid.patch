diff --git a/drm/stubs/drm_guard.cpp b/drm/stubs/drm_guard.cpp
new file mode 100644
index 0000000..1ff2077
--- /dev/null
+++ b/drm/stubs/drm_guard.cpp
@@ -0,0 +1,84 @@
+/*
+ * drm_guard.cpp — guest-side C++ exception barrier for Android ELF libraries
+ * loaded through libhybris on Windows.
+ *
+ * Apple's Android FairPlay libraries (libandroidappmusic.so, etc.) throw C++
+ * exceptions such as SVError using Bionic libc++_shared.so's DWARF unwinder.
+ * A Windows PE host frame has no ELF .eh_frame entry in the guest linker, so
+ * any exception reaching the host frame terminates the process via abort().
+ *
+ * Compiling this tiny trampoline as an x86_64 Linux ELF shared library linked
+ * against libc++_shared.so keeps the try/catch frame inside the guest linker's
+ * dl_iterate_phdr list, so DWARF unwinding runs guest destructors cleanly,
+ * captures e.what(), and returns a non-zero error code to the host caller.
+ */
+#include "drm_guard.h"
+
+namespace std {
+class exception {
+  public:
+    virtual ~exception() noexcept;
+    virtual const char *what() const noexcept;
+};
+} // namespace std
+
+static void copy_err(char *buf, unsigned long long cap, const char *msg) noexcept
+{
+    if (!buf || cap == 0) return;
+    if (!msg) msg = "unknown C++ exception";
+    unsigned long long i = 0;
+    while (i + 1 < cap && msg[i] != '\0') {
+        buf[i] = msg[i];
+        ++i;
+    }
+    buf[i] = '\0';
+}
+
+extern "C" int drm_guard_invoke(drm_guard_call_t *call)
+{
+    if (!call || !call->fn) {
+        if (call) copy_err(call->err_buf, call->err_cap, "null guard target");
+        return -3;
+    }
+    if (call->err_buf && call->err_cap > 0) call->err_buf[0] = '\0';
+    call->ret = nullptr;
+
+    try {
+        switch (call->argc) {
+        case 0:
+            call->ret = reinterpret_cast<void *(*)()>(call->fn)();
+            return 0;
+        case 1:
+            call->ret = reinterpret_cast<void *(*)(void *)>(call->fn)(call->args[0]);
+            return 0;
+        case 2:
+            call->ret = reinterpret_cast<void *(*)(void *, void *)>(call->fn)(
+                call->args[0], call->args[1]);
+            return 0;
+        case 3:
+            call->ret = reinterpret_cast<void *(*)(void *, void *, void *)>(call->fn)(
+                call->args[0], call->args[1], call->args[2]);
+            return 0;
+        case 4:
+            call->ret = reinterpret_cast<void *(*)(void *, void *, void *, void *)>(call->fn)(
+                call->args[0], call->args[1], call->args[2], call->args[3]);
+            return 0;
+        case 10:
+            call->ret = reinterpret_cast<void *(*)(
+                void *, void *, void *, void *, void *,
+                void *, void *, void *, void *, void *)>(call->fn)(
+                call->args[0], call->args[1], call->args[2], call->args[3], call->args[4],
+                call->args[5], call->args[6], call->args[7], call->args[8], call->args[9]);
+            return 0;
+        default:
+            copy_err(call->err_buf, call->err_cap, "unsupported arg count");
+            return -3;
+        }
+    } catch (const std::exception &e) {
+        copy_err(call->err_buf, call->err_cap, e.what());
+        return -1;
+    } catch (...) {
+        copy_err(call->err_buf, call->err_cap, "unknown C++ exception");
+        return -2;
+    }
+}
diff --git a/drm/stubs/drm_guard.h b/drm/stubs/drm_guard.h
new file mode 100644
index 0000000..b626efd
--- /dev/null
+++ b/drm/stubs/drm_guard.h
@@ -0,0 +1,21 @@
+/*
+ * drm_guard.h — ABI shared between the Windows host wrapper (PE64) and the
+ * guest ELF exception barrier (libdrm_guard.so, x86_64-linux-gnu).
+ *
+ * Uses only fixed-size / ABI-identical types so LP64 guest and LLP64 host
+ * agree on every field offset.
+ */
+#ifndef DRM_GUARD_H
+#define DRM_GUARD_H
+
+typedef struct drm_guard_call {
+    void *fn;
+    void *args[10];
+    void *ret;
+    char *err_buf;
+    unsigned long long err_cap;
+    int argc;
+    int reserved;
+} drm_guard_call_t;
+
+#endif /* DRM_GUARD_H */
