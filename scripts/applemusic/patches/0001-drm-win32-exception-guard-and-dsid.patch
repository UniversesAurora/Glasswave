From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Glasswave <glasswave@local>
Date: Mon, 23 Nov 2026 14:32:28 +0800
Subject: [PATCH 1/8] drm: add Windows ELF C++ exception guard and export
 account DSID

Load libdrm_guard.so on Windows so guest Android DWARF C++ exceptions are caught inside an ELF frame instead of unwinding across host PE stacks, and include the active account DSID in drm_get_account().

diff --git a/drm/drm_hybris.c b/drm/drm_hybris.c
index 4e308cf..a0121b4 100644
--- a/drm/drm_hybris.c
+++ b/drm/drm_hybris.c
@@ -23,6 +23,9 @@
 #endif
 
 extern void hybris_bind_lib_handles(void *ssc, void *apm, void *core);
+#ifdef _WIN32
+extern void hybris_bind_guard_invoke(void *invoke_fn);
+#endif
 
 /* Windows loads these libraries RTLD_GLOBAL so the later symbol lookups through the
  * wrapper see them; the Linux flags are unchanged. */
@@ -671,6 +674,23 @@ int hybris_backend_init(
      * forwarding layer must not open the same guest libraries a second time. */
     hybris_bind_lib_handles(g_hybris.ssc_handle, g_hybris.appmusic_handle,
                             g_hybris.corefp_handle);
+
+    /* Load the guest-side C++ exception barrier so Android DWARF exceptions
+     * (such as SVError from getPersistentKey) are caught inside an ELF frame
+     * rather than terminating engine.exe when unwinding hits the host PE stack. */
+    void *guard_handle = g_hybris.android_dlopen("libdrm_guard.so", RTLD_NOW);
+    void *guard_invoke = guard_handle
+                             ? g_hybris.android_dlsym(guard_handle, "drm_guard_invoke")
+                             : NULL;
+    fprintf(stderr, "[drm] libdrm_guard.so handle=%p invoke=%p\n",
+            guard_handle, guard_invoke);
+    fflush(stderr);
+    if (guard_invoke) {
+        hybris_bind_guard_invoke(guard_invoke);
+    } else {
+        fprintf(stderr, "[hybris] libdrm_guard.so unavailable; guest C++ exceptions will not be caught\n");
+        fflush(stderr);
+    }
 #endif
 
 #ifndef _WIN32
