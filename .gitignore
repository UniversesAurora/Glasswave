# Build output (the SDK projects write to $(SolutionDir)$(Platform))
/build/
/out/
/x64/
/Win32/
/Debug/
/Release/
*.obj
*.pch
*.ipch
*.ilk
*.pdb
*.idb
*.iobj
*.ipdb
*.tlog
*.lastbuildstate
*.log
*.aps

# Visual Studio user state
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb

# Fetched upstream code is excluded; source-only Glasswave adapters are listed explicitly.
/third_party/*
!/third_party/README.md
!/third_party/deps.lock.json

# Glasswave's source-only Cavern adapter; fetched upstream code and build products stay local.
!/third_party/glasswave-cavern/
/third_party/glasswave-cavern/*
!/third_party/glasswave-cavern/*.cs
!/third_party/glasswave-cavern/*.csproj
!/third_party/glasswave-cavern/*.json
!/third_party/glasswave-cavern/NOTICE.md
!/third_party/glasswave-cavern/test/
/third_party/glasswave-cavern/test/*
!/third_party/glasswave-cavern/test/*.cs
!/third_party/glasswave-cavern/test/*.csproj

# Local dev instance, download cache, screenshots, copyrighted reference images
/.local/

# Packaged release archives and owner's local production data (cache, downloads)
/dist/
/userdata/

# Personal Claude Code settings
.claude/settings.local.json
